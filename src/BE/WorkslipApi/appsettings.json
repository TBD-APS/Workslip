{
  "AllowedHosts": "*",
  "DocumentFileStorage": {
    "StorageAccountName": "localdevstore",
    "ContainerName": "report-attachments",
    "LocalRootPath": "UploadedFiles"
  },
  "ConnectionStrings": {
    "JobDB": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Workslip.Api"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
