{
  "AllowedHosts": "*",
  "AzureAppConfiguration": {
    "Endpoint": ""
  },
  "Azure": {
    "ManagedIdentityClientId": ""
  },
  "DocumentFileStorage": {
    "StorageAccountName": "localdevstore",
    "ContainerName": "report-attachments",
    "LocalRootPath": "UploadedFiles"
  },
  "ConnectionStrings": {
    "JobDB": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Workslip.Api"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "JobTaxonomy": {
    "WorkKinds": [
      {
        "Id": "nyInstallation",
        "Label": "Ny installation",
        "RequiresCustomWorkKind": false,
        "IsActive": true,
        "SortOrder": 10
      },
      {
        "Id": "aendring",
        "Label": "Ændring af installation",
        "RequiresCustomWorkKind": false,
        "IsActive": true,
        "SortOrder": 20
      },
      {
        "Id": "reparation",
        "Label": "Reparationsarbejde",
        "RequiresCustomWorkKind": false,
        "IsActive": true,
        "SortOrder": 30
      },
      {
        "Id": "serviceAndet",
        "Label": "Andet",
        "RequiresCustomWorkKind": true,
        "IsActive": true,
        "SortOrder": 40
      }
    ],
    "ClosureFlags": [
      {
        "Id": "ikkeFaerdig",
        "Label": "Ikke færdig",
        "IsExclusive": true,
        "IsActive": true,
        "SortOrder": 10
      },
      {
        "Id": "faerdig",
        "Label": "Færdig",
        "IsExclusive": false,
        "IsActive": true,
        "SortOrder": 20
      },
      {
        "Id": "driftVedligehold",
        "Label": "Drift og vedligehold",
        "IsExclusive": false,
        "IsActive": true,
        "SortOrder": 30
      },
      {
        "Id": "klarTilFaktura",
        "Label": "Klar til faktura",
        "IsExclusive": false,
        "IsActive": true,
        "SortOrder": 40
      }
    ]
  }
}
