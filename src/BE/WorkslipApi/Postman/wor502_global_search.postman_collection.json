{
  "info": {
    "name": "WOR-502 Global Search Regression",
    "description": "Focused Postman coverage for global search backend contracts: jobs, customers/address, docs and auth boundaries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://127.0.0.1:5262"},
    {"key":"adminToken","value":""},
    {"key":"userToken","value":""},
    {"key":"customerId","value":""},
    {"key":"documentId","value":""}
  ],
  "item": [
    {
      "name": "Jobs search rejects anonymous",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/jobs?search=WOR502&limit=5&offset=0","host":["{{baseUrl}}"]}},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('anonymous jobs search is rejected', () => pm.expect(pm.response.code).to.eql(401));"]}}]
    },
    {
      "name": "Customer search rejects anonymous",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/customers/search?query=Searchvej&limit=5","host":["{{baseUrl}}"]}},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('anonymous customer search is rejected', () => pm.expect(pm.response.code).to.eql(401));"]}}]
    },
    {
      "name": "Docs search rejects anonymous",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/docs?search=WOR502&limit=5&offset=0","host":["{{baseUrl}}"]}},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('anonymous docs search is rejected', () => pm.expect(pm.response.code).to.eql(401));"]}}]
    },
    {
      "name": "Create customer address fixture",
      "request": {
        "method":"POST",
        "header":[
          {"key":"Authorization","value":"Bearer {{adminToken}}","type":"text"},
          {"key":"Content-Type","value":"application/json","type":"text"},
          {"key":"Idempotency-Key","value":"wor502-{{$guid}}","type":"text"}
        ],
        "body":{"mode":"raw","raw":"{\"name\":\"WOR502 Search Kunde\",\"customerNumber\":\"WOR502-502\",\"address\":\"WOR502 Searchvej 502\",\"zipCode\":\"8000\",\"city\":\"Aarhus C\",\"country\":\"Danmark\",\"email\":\"wor502-search@example.test\",\"contactPerson\":\"Search Test\",\"phone\":\"12345678\"}","options":{"raw":{"language":"json"}}},
        "url":{"raw":"{{baseUrl}}/api/customers","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('customer fixture created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
        "const body = pm.response.json();",
        "pm.expect(body.id, 'customer id').to.be.a('string').and.not.empty;",
        "pm.collectionVariables.set('customerId', body.id);"
      ]}}]
    },
    {
      "name": "Customer search finds address",
      "request": {
        "method":"GET",
        "header":[{"key":"Authorization","value":"Bearer {{userToken}}","type":"text"}],
        "url":{"raw":"{{baseUrl}}/api/customers/search?query=Searchvej&limit=5","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('customer address search succeeds', () => pm.expect(pm.response.code).to.eql(200));",
        "const rows = pm.response.json();",
        "pm.expect(rows).to.be.an('array');",
        "pm.expect(rows.some(x => String(x.id) === pm.collectionVariables.get('customerId')), 'created customer returned by address search').to.eql(true);",
        "pm.expect(rows.some(x => String(x.address || '').includes('WOR502 Searchvej 502')), 'address is present in search result').to.eql(true);"
      ]}}]
    },
    {
      "name": "Jobs global search contract",
      "request": {
        "method":"GET",
        "header":[{"key":"Authorization","value":"Bearer {{userToken}}","type":"text"}],
        "url":{"raw":"{{baseUrl}}/api/jobs?search=WOR502&limit=5&offset=0","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('jobs search succeeds', () => pm.expect(pm.response.code).to.eql(200));",
        "const body = pm.response.json();",
        "pm.expect(body).to.be.an('object');",
        "pm.expect(body.items).to.be.an('array');",
        "pm.expect(body).to.have.property('totalCount');"
      ]}}]
    },
    {
      "name": "Create docs search fixture",
      "request": {
        "method":"POST",
        "header":[
          {"key":"Authorization","value":"Bearer {{adminToken}}","type":"text"},
          {"key":"Content-Type","value":"application/json","type":"text"},
          {"key":"Idempotency-Key","value":"wor502-{{$guid}}","type":"text"}
        ],
        "body":{"mode":"raw","raw":"{\"title\":\"WOR502 KLS Søgedokument\",\"content\":\"Unikt globalt søgeord WOR502DOCNEEDLE og dokumentation for kvalitetssikring.\",\"tags\":[\"WOR502\",\"search-regression\"]}","options":{"raw":{"language":"json"}}},
        "url":{"raw":"{{baseUrl}}/api/docs","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('document fixture created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
        "const body = pm.response.json();",
        "pm.expect(body.id, 'document id').to.be.a('string').and.not.empty;",
        "pm.collectionVariables.set('documentId', body.id);"
      ]}}]
    },
    {
      "name": "Docs search finds title",
      "request": {
        "method":"GET",
        "header":[{"key":"Authorization","value":"Bearer {{adminToken}}","type":"text"}],
        "url":{"raw":"{{baseUrl}}/api/docs?search=Søgedokument&limit=5&offset=0","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('docs title search succeeds', () => pm.expect(pm.response.code).to.eql(200));",
        "const body = pm.response.json();",
        "pm.expect(body.items).to.be.an('array');",
        "pm.expect(body.items.some(x => String(x.id) === pm.collectionVariables.get('documentId')), 'created doc returned by title search').to.eql(true);"
      ]}}]
    },
    {
      "name": "Docs search finds content",
      "request": {
        "method":"GET",
        "header":[{"key":"Authorization","value":"Bearer {{adminToken}}","type":"text"}],
        "url":{"raw":"{{baseUrl}}/api/docs?search=WOR502DOCNEEDLE&limit=5&offset=0","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('docs content search succeeds', () => pm.expect(pm.response.code).to.eql(200));",
        "const body = pm.response.json();",
        "pm.expect(body.items).to.be.an('array');",
        "pm.expect(body.items.some(x => String(x.id) === pm.collectionVariables.get('documentId')), 'created doc returned by content search').to.eql(true);"
      ]}}]
    },
    {
      "name": "Docs search finds tag",
      "request": {
        "method":"GET",
        "header":[{"key":"Authorization","value":"Bearer {{adminToken}}","type":"text"}],
        "url":{"raw":"{{baseUrl}}/api/docs?search=search-regression&limit=5&offset=0","host":["{{baseUrl}}"]}
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('docs tag search succeeds', () => pm.expect(pm.response.code).to.eql(200));",
        "const body = pm.response.json();",
        "pm.expect(body.items).to.be.an('array');",
        "pm.expect(body.items.some(x => String(x.id) === pm.collectionVariables.get('documentId')), 'created doc returned by tag search').to.eql(true);"
      ]}}]
    }
  ]
}
