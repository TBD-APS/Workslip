eeded\"\n        ]\n      },\n      \"type\": \"ApiConnection\",\n      \"inputs\": {\n        \"host\": {\n          \"connection\": {\n            \"name\": \"@parameters('$connections')['formrecognizer']['connectionId']\"\n          }\n        },\n        \"method\": \"post\",\n        \"body\": \"@body('Get_blob_content_(V2)')\",\n        \"path\": \"/connectorinternaldocumentintelligence/documentModels/@{encodeURIComponent('sexymodel')}:analyze\",\n        \"queries\": {\n          \"api-version\": \"2024-11-30\"\n        }\n      }\n    },\n    \"Agent\": {\n      \"runAfter\": {\n        \"Compose\": [\n          \"Succeeded\"\n        ]\n      },\n      \"limit\": {\n        \"count\": 100\n      },\n      \"tools\": {},\n      \"type\": \"Agent\",\n      \"inputs\": {\n        \"parameters\": {\n          \"messages\": [\n            {\n              \"role\": \"system\",\n              \"content\": \"Du er en ekspert i at analysere kontekst ud fra en rapport. Så der hvor der er stavefejl, dem retter du. \\n\\n@{outputs('Compose')}\\n\"\n            }\n          ],\n          \"agentModelType\": \"AzureOpenAI\",\n          \"agentModelSettings\": {\n            \"agentHistoryReductionSettings\": {\n              \"agentHistoryReductionType\": \"maximumTokenCountReduction\",\n              \"maximumTokenCount\": 128000\n            }\n          }\n        }\n      }\n    },\n    \"Compose\": {\n      \"runAfter\": {\n        \"Analyze_Document_for_Prebuilt_or_Custom_models_(v4.x_API)\": [\n          \"Succeeded\"\n        ]\n      },\n      \"type\": \"Compose\",\n      \"inputs\": \"@body('Analyze_Document_for_Prebuilt_or_Custom_models_(v4.x_API)')?['analyzeResult']?['pages']\"\n    }\n  },\n  \"outputs\": {},\n  \"parameters\": {\n    \"$connections\": {\n      \"type\": \"Object\",\n      \"defaultValue\": {}\n    }\n  }\n}\n",
