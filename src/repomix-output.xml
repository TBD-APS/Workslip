              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const internalFields = ['createdAt', 'updatedAt', 'submittedAt', 'deletionScheduledAt'];",
                  "pm.test('job summary view model hides internal timestamps', function () { internalFields.forEach(field => pm.expect(json).to.not.have.property(field)); });",
                  "pm.test('job view model marks active report', function () { pm.expect(json.softDeleted).to.eql(false); });",
                  "pm.collectionVariables.set('jobId', json.id);",
                  "pm.test('customer email echoed', function () { pm.expect(json.customer.email).to.eql(pm.variables.get('customerEmail')); });",
                  "pm.test('installation types include selected categories and control points', function () {",
                  "  pm.expect(json.work.installationTypes.length).to.be.above(0);",
                  "  json.work.installationTypes.forEach(it => {",
                  "    pm.expect(it.categories).to.be.an('array').that.is.not.empty;",
                  "    it.categories.forEach(cat => {",
                  "      pm.expect(cat.id).to.be.a('string').and.not.empty;",
                  "      pm.expect(cat.name).to.be.a('string').and.not.empty;",
                  "      pm.expect(cat.controlPoints).to.be.an('array').that.is.not.empty;",
                  "      cat.controlPoints.forEach(cp => {",
