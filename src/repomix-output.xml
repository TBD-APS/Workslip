        users.AddRange(auditorUser);

        var statuses = new[] { JobStatus.Draft, JobStatus.InReview, JobStatus.Approved, JobStatus.Rejected };

        var jobs = new Faker<JobReportRow>()
            .CustomInstantiator(f =>
            {
