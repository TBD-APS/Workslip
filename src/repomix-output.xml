                  "pm.test('installation types include selected categories and control points', function () {",
                  "  pm.expect(json.work.installationTypes.length).to.be.above(0);",
                  "  json.work.installationTypes.forEach(it => {",
                  "    pm.expect(it.categories).to.be.an('array').that.is.not.empty;",
