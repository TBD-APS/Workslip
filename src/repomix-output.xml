                  "pm.variables.set('vandCategoryId', '00000000-0000-0000-0000-000000000000');",
                  "pm.variables.set('vandControlPointId', '00000000-0000-0000-0000-000000000000');",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/reference-data',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + pm.variables.get('authToken') }",
                  "}, function (err, res) {",
                  "  if (err || res.code !== 200) {",
                  "    console.log('Could not fetch reference data for job installation IDs. Error: ' + (err || res.code));",
                  "    return;",
                  "  }",
                  "  try {",
                  "    var json = res.json().installationTypes;",
                  "    var vand = json.find(function(d) { return d.name.toLowerCase() === 'vandinstallation'; });",
                  "    if (vand && vand.categories.length > 0) {",
                  "      pm.variables.set('vandInstallationId', vand.id);",
                  "      pm.variables.set('vandCategoryId', vand.categories[0].id);",
                  "      if (vand.categories[0].controlPoints.length > 0)",
                  "        pm.variables.set('vandControlPointId', vand.categories[0].controlPoints[0].id);",
