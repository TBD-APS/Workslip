            .RuleFor(x => x.OrganizationId, _ => organization.Id)
            .RuleFor(x => x.DisplayName, _ => "Auditor Jakobsen")
            .RuleFor(x => x.Email, _ => "auditor@17v3ygzs.mailosaur.net")
            .RuleFor(x => x.Phone, _ => "10000003")
            .RuleFor(x => x.Role, _ => Roles.Auditor)
