            },
            "description": "Runtime health endpoint."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });",
                  "pm.test('public health cache header', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('public'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "/api/organizations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/organizations/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organizations"
              ]
            },
            "description": "Creates organization and initial admin user. Saves organizationId + userId on 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{organizationName}}\",\n  \"cvr\": \"{{organizationCvr}}\",\n  \"adminDisplayName\": \"{{adminDisplayName}}\",\n  \"adminEmail\": \"{{testEmail}}\",\n  \"adminPhone\": \"{{adminPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('organization view model hides internal timestamps', function () { ['createdAt', 'updatedAt'].forEach(field => { pm.expect(json.organization).to.not.have.property(field); pm.expect(json.user).to.not.have.property(field); }); });",
                  "pm.collectionVariables.set('organizationId', json.organization.id);",
                  "pm.collectionVariables.set('actorId', json.user.id);",
                  "pm.collectionVariables.set('creatorUserId', json.user.id);",
                  "pm.collectionVariables.set('userId', json.user.id);",
                  "pm.test('organization id captured', function () { pm.expect(json.organization.id).to.be.a('string').and.not.empty; });",
                  "pm.test('creator user id captured', function () { pm.expect(json.user.id).to.be.a('string').and.not.empty; });",
                  "pm.test('mutation response is not stored', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/organizations invalid validation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/organizations/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organizations",
                ""
              ]
            },
            "description": "Covers FluentValidation edge cases for required organization fields, CVR length/digits, and admin email format.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"cvr\": \"12A\",\n  \"adminDisplayName\": \"\",\n  \"adminEmail\": \"not-an-email\",\n  \"adminPhone\": \"123456789012345678901\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 validation problem', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "const errors = json.errors || {};",
                  "const keys = Object.keys(errors);",
                  "pm.test('organization validation fields returned', function () { pm.expect(keys).to.include.members(['Name', 'Cvr', 'AdminDisplayName', 'AdminEmail']); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "/api/auth/send-code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
