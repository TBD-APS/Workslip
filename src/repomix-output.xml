.multi-select-option {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  color: var(--text);
  font: inherit;
  text-align: left;
