/* ------------------------------------------------------------
   My worksheets monthly overview
   ------------------------------------------------------------ */
.time-overview-page {
  max-width: 1100px;
  padding: 0 1rem;
}

/* â”€â”€ Admin Timer â€” forced white theme â”€â”€ */
.time-overview-page--admin {
  --bg: #ffffff;
  --text: #18181b;
  --text-muted: #6b7280;
  --text-dim: rgba(0, 0, 0, 0.4);
  --surface: #f8f9fa;
  --surface-raised: #f1f3f5;
  --surface-elevated: #e9ecef;
  --surface-input: #ffffff;
  --border: #dee2e6;
  --border-strong: #ced4da;
  --primary: #2c54ac;
  --primary-rgb: 44, 84, 172;
  --focus-ring: rgba(44, 84, 172, 0.3);
  background: var(--bg);
  color: var(--text);
}

.time-overview-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.time-month-controls {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
}

.time-month-switcher {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.35rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text);
  text-transform: capitalize;
  white-space: nowrap;
}

.time-month-switcher span {
  min-width: 9rem;
  text-align: center;
  font-size: var(--fs-body);
}

.time-month-button {
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-pill);
}

.time-today-button {
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  color: var(--text-muted);
  font: inherit;
  font-size: var(--fs-xs);
  cursor: pointer;
}

.time-today-button:not(:disabled) {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.time-today-button:disabled {
  opacity: 0.45;
  cursor: default;
}

.time-summary-grid {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.35rem;
  width: 100%;
}

.time-summary-card {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.22rem 0.55rem;
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  border: 1px solid var(--border);
}

.time-summary-card > div {
  display: inline-flex;
  align-items: center;
  gap: 0.28rem;
}

.time-summary-card span {
  display: inline-flex;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-summary-card strong {
  display: inline-flex;
  color: var(--text);
  font-size: var(--fs-xs);
  font-weight: 400;
}

.time-summary-icon {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: 1.1rem;
  height: 1.1rem;
  border-radius: var(--radius-pill);
  color: var(--text-muted) !important;
  background: transparent;
}

.time-overview-page .empty-state {
  padding: 1rem 1rem;
}

.time-week-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.time-week-card {
  padding: 1rem;
  border-radius: var(--radius-lg);
  background: var(--surface);
  border: 1px solid var(--border);
}

.time-week-card.is-current {
  border-color: var(--primary);
  background: var(--surface);
  box-shadow: 0 0 0 2px rgba(var(--primary-rgb, 44, 84, 172), 0.1);
}

.current-week-badge {
  display: inline-block;
  margin-left: 0.5rem;
  padding: 0.1rem 0.45rem;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 600;
  line-height: 1.3;
  vertical-align: middle;
}

.time-week-card:not(.is-expanded) .time-week-header {
  margin-bottom: 0;
}

.time-week-skeleton {
  min-height: 220px;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 25%, rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.time-week-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.85rem;
}

.time-week-header h3 {
  margin: 0;
  color: var(--text);
  font-size: var(--fs-body);
}

.time-week-totals {
  display: inline-flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-week-totals span {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.55rem;
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text-muted);
}

.time-week-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.6rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  color: var(--text);
  font: inherit;
  font-size: var(--fs-xs);
  cursor: pointer;
}

.time-week-toggle svg {
  transition: transform 0.16s ease;
}

.time-week-card.is-expanded .time-week-toggle svg {
  transform: rotate(180deg);
}

.time-day-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.5rem;
}

.time-day-cell {
  min-height: 132px;
  padding: 0.65rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.time-day-cell.muted {
  opacity: 0.42;
}

.time-day-cell.has-entries {
  background: var(--surface);
  border-color: var(--surface-selected-strong);
}

.time-day-cell--empty {
  opacity: 0.5;
}

.time-day-cell--empty .time-day-head p {
  display: none;
}

.time-day-cell--weekend {
  background: var(--surface-raised);
  border-color: var(--surface-elevated);
}

.time-day-cell--weekend.muted {
  background: var(--surface);
  border-color: var(--border);
}

.time-day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.55rem;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-day-head strong {
  color: var(--text);
  font-size: var(--fs-xs);
  white-space: nowrap;
}

.time-entry-list {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.time-entry-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 0.25rem;
  padding: 0.55rem;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: rgba(0,0,0,0.28);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.time-entry-card:hover,
.time-entry-card:focus-visible {
  border-color: var(--surface-elevated);
  background: var(--surface-elevated);
  outline: none;
}

.time-entry-top,
.time-entry-meta,
.time-entry-address,
.time-entry-outlay,
.time-entry-user {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.time-entry-user {
  font-size: 0.75rem;
  color: var(--text-muted);
  padding: 0.1rem 0.3rem;
  margin-bottom: 0.2rem;
}

.time-entry-top {
  justify-content: space-between;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-entry-meta {
  justify-content: flex-end;
  gap: 0.35rem;
  white-space: nowrap;
}

.time-entry-card strong {
  color: var(--text);
  font-size: var(--fs-sm);
  font-weight: 400;
  line-height: 1.25;
}

.time-entry-address {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  line-height: 1.25;
}

.time-entry-outlay {
  padding: 0.12rem 0.4rem;
  border-radius: var(--radius-pill);
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

@media (max-width: 900px) {
  .time-day-grid {
    grid-template-columns: 1fr;
  }

  .time-day-cell {
    min-height: auto;
  }
}

@media (max-width: 640px) {
  .time-overview-header {
    flex-direction: column;
  }

  .time-month-controls,
