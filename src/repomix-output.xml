      | { data: UserListViewModel | UserViewModel[] }
      | undefined,
  );
  const users = Array.isArray(data) ? data : data?.users ?? [];
  return users.map((user) => ({
    id: user.id,
    displayName: user.displayName,
    email: user.email,
  }));
