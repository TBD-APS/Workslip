                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('organization view model hides internal timestamps', function () { ['createdAt', 'updatedAt'].forEach(field => { pm.expect(json.organization).to.not.have.property(field); pm.expect(json.user).to.not.have.property(field); }); });",
                  "pm.collectionVariables.set('organizationId', json.organization.id);",
                  "pm.collectionVariables.set('actorId', json.user.id);",
                  "pm.collectionVariables.set('creatorUserId', json.user.id);",
                  "pm.collectionVariables.set('userId', json.user.id);",
                  "pm.test('organization id captured', function () { pm.expect(json.organization.id).to.be.a('string').and.not.empty; });",
                  "pm.test('creator user id captured', function () { pm.expect(json.user.id).to.be.a('string').and.not.empty; });",
                  "pm.test('mutation response is not stored', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
          ]
