          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response is an array', function () {",
                  "  pm.expect(json).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reference Data",
      "item": [
        {
          "name": "/api/reference-data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reference-data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reference-data"
              ]
            },
            "description": "Returns installation type definitions (with category/control-point hierarchy), work kinds, and closure flags. Uses private revalidation with ETag."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response has installationTypes, workKinds, closureFlags', function () {",
                  "  pm.expect(json).to.have.property('installationTypes').that.is.an('array');",
                  "  pm.expect(json).to.have.property('workKinds').that.is.an('array');",
                  "  pm.expect(json).to.have.property('closureFlags').that.is.an('array');",
                  "});",
                  "pm.test('installation types have nested categories and controlPoints', function () {",
                  "  if (json.installationTypes.length > 0) {",
                  "    pm.expect(json.installationTypes[0]).to.have.property('categories').that.is.an('array');",
                  "    if (json.installationTypes[0].categories.length > 0) {",
                  "      pm.expect(json.installationTypes[0].categories[0]).to.have.property('controlPoints').that.is.an('array');",
                  "    }",
                  "  }",
                  "});",
                  "pm.test('private revalidation cache', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('private'); });",
                  "pm.test('ETag header present', function () { pm.expect(pm.response.headers.get('ETag')).to.match(/^W\\/\"[a-f0-9]+\"$/); });",
                  "pm.collectionVariables.set('referenceDataEtag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/reference-data with If-None-Match",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{referenceDataEtag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reference-data",
