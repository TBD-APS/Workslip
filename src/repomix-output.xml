/* ------------------------------------------------------------
   Step indicators (stepper)
   ------------------------------------------------------------ */
.step-indicators {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.15rem;
  overflow-x: auto;
  padding-bottom: 0.25rem;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

.step-dot {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 46px;
  padding: 0.6rem 0.9rem;
  border-radius: var(--radius-sm);
  border: none;
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  font-size: var(--fs-sm);
  white-space: nowrap;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
}

.step-dot.active {
  color: white;
  background: var(--primary);
  border: none;
}

.step-dot.completed {
  background: var(--surface-selected-strong);
  color: var(--text);
  border: none;
}

.step-dot[aria-disabled="true"] {
  opacity: 0.5;
  cursor: not-allowed;
}


.step-label {
  font-weight: 400;
}

/* ------------------------------------------------------------
   Step navigation (prev / next buttons)
   ------------------------------------------------------------ */
.step-nav-anchor {
  position: sticky;
  /* Sit just above the fixed bottom-nav (uses --bottom-nav-height which now
     already includes env(safe-area-inset-bottom) so the buttons never end up
     underneath the nav on devices with a tall home-indicator). */
  bottom: calc(var(--bottom-nav-height) + var(--bottom-nav-extra) + 0.25rem);
  z-index: 150;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 1;
  visibility: visible;
  transition: opacity 0.18s ease, visibility 0.18s ease;
}

.step-nav-anchor.is-hidden {
  opacity: 0;
  visibility: hidden;
}

.step-nav {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: var(--surface);
  border: none;
  border-radius: var(--radius-lg);
  backdrop-filter: blur(18px);
}

.step-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.25rem;
  font: inherit;
  font-size: var(--fs-sm);
  font-weight: 400;
  border: 0;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
}

.step-nav-btn:active {
  transform: scale(0.96);
  transition: transform 0.08s ease;
}

.step-nav-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: var(--surface-raised);
  color: var(--text-muted);
  box-shadow: none;
}

@media (hover: hover) {
.step-nav-btn:disabled:hover {
  background: var(--surface-raised);
  transform: none;
}
}

.step-nav-btn-back {
  color: var(--text);
  background: var(--surface-raised);
}

.step-nav-btn-back:active {
  background: var(--surface-selected-strong);
  transform: scale(0.96);
}

@media (hover: hover) {
.step-nav-btn-back:not(:disabled):hover {
  background: var(--surface-selected-strong);
}
}

.step-nav-btn-next {
  margin-left: auto;
  color: white;
  background: var(--primary);
  border: 1px solid var(--border);
}

.step-nav-btn-next svg {
  color: white;
}

.step-nav-btn-next:active {
  background: var(--surface-selected-strong);
  border-color: var(--focus-ring);
  transform: scale(0.96);
}

.step-nav-btn-next--wide {
  flex: 1;
  justify-content: center;
  min-width: 12rem;
}

@media (hover: hover) {
.step-nav-btn-next:not(:disabled):hover {
  background: var(--surface-selected-strong);
  border-color: var(--focus-ring);
}
}

.step-nav-counter {
  font-size: var(--fs-xs);
  color: var(--text-muted);
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

.control-points-list {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.control-point-type + .control-point-type {
  margin-top: 1.25rem;
}

.control-point-type {
  background: var(--surface-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.75rem;
  transition: all 0.2s ease;
}

.control-point-type:focus-within {
  border-color: var(--focus-ring);
  background: rgba(0, 0, 0, 0.3);
}

.control-point-type.collapsed {
  padding-bottom: 0.5rem;
}

.control-point-type-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  padding: 0;
  font: inherit;
  margin-bottom: 0.75rem;
  text-align: left;
}

.control-point-type.collapsed .control-point-type-header {
  margin-bottom: 0;
}

.control-point-chevron {
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform 0.2s ease;
}

.control-point-chevron.open {
  transform: rotate(90deg);
}

.control-point-type-name {
  font-size: var(--fs-body);
  font-weight: 400;
}

.control-point-type-body {
  padding-left: 0;
}

.control-point-category-group + .control-point-category-group {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
}

.control-point-category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.25rem;
}

.control-point-category-label {
  font-size: var(--fs-xs);
  font-weight: 400;
  color: var(--text);
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.control-point-category-group.irrelevant .control-point-category-label {
  color: var(--text-disabled, rgba(255, 255, 255, 0.4));
}

.multi-select-option.control-point-irrelevant-row {
  min-height: 42px;
  padding: 0.6rem 0.8rem 0.6rem 1rem;
  margin-bottom: 0;
  color: var(--text);
}

@media (hover: hover) {
.multi-select-option.control-point-irrelevant-row:hover {
  color: var(--text);
}
}


.irrelevant-label {
  display: none;
}

.multi-select-option:disabled {
  opacity: 0.4;
  cursor: default;
}

@media (hover: hover) {
.multi-select-option:disabled:hover {
  background: var(--surface);
}
}

@media (hover: hover) {
.multi-select-option.selected:disabled:hover {
  background: var(--surface);
}
}

@media (min-width: 768px) {
  .bottom-nav {
    position: static;
    height: auto;
    padding: 0.5rem 1.5rem;
    flex-direction: row;
    justify-content: flex-start;
    gap: 0.5rem;
    border-top: none;
    border-bottom: 1px solid var(--border);
    order: 1;
  }

  .app-content {
    padding-bottom: 1.5rem;
    order: 2;
  }

  .app-header {
    order: 0;
  }

  .app-shell {
    display: flex;
    flex-direction: column;
  }

  .page-container {
    max-width: none;
  }

  .nav-item {
    flex-direction: row;
    gap: 0.5rem;
    flex: none;
    padding: 0.5rem 0.75rem;
  }

  .search-input-wrapper {
    max-width: 420px;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 0;
  }

  .pagination-info {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    min-width: 120px;
    text-align: center;
  }

  .pagination-controls .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .data-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-sm);
  }

  .data-table thead th {
    position: sticky;
    top: 0;
    background: var(--bg);
    padding: 0.75rem 1rem;
    text-align: left;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    user-select: none;
    cursor: default;
  }

  .data-table thead th.sortable.sorted {
    color: #fff;
  }

  .data-table .sort-trigger {
    cursor: pointer;
    transition: color 0.15s;
  }

  .data-table .sort-trigger:hover {
    color: var(--text);
  }

  .data-table thead th .sort-icon {
    display: inline-flex;
    margin-left: 0.3rem;
    opacity: 0.4;
    vertical-align: middle;
  }

  .data-table thead th.sortable.sorted .sort-icon {
    opacity: 1;
  }

  .data-table thead th .col-resize-handle {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 14px;
    cursor: col-resize;
    user-select: none;
    z-index: 1;
  }

  .data-table thead th .col-resize-handle::after {
    content: '';
    position: absolute;
    right: 2px;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: var(--border);
    transition: background 0.15s;
  }

  .data-table thead th:hover .col-resize-handle::after {
    background: var(--primary);
  }

  .data-table thead th .col-resize-handle:active::after,
  .data-table thead th .col-resize-handle--active::after {
    background: var(--primary);
    width: 2px;
  }

  .data-table tbody tr {
    transition: background 0.12s;
  }

  .data-table tbody tr.clickable {
    cursor: pointer;
  }

  .data-table tbody tr.clickable:hover {
    background: var(--surface);
  }

  .data-table tbody td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table .col-status {
    width: 110px;
  }

  .data-table .col-hours {
    width: 70px;
    text-align: right;
  }

  .data-table .col-users {
    width: 150px;
  }

  .data-table .col-actions {
    width: 40px;
    text-align: right;
  }

  .data-table .col-name {
    width: 22%;
  }

  .data-table .col-address {
    width: 18%;
  }

  .data-table .col-email {
    width: 20%;
  }

  .data-table .col-contact {
    width: 16%;
  }

  .data-table .col-number {
    width: 100px;
  }

  .data-table .col-installation {
    width: 140px;
  }

  .data-table .col-role {
    width: 150px;
  }

  .data-table .col-hours {
    width: 80px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .data-table .col-date {
    width: 120px;
  }

  .data-table .cell-comma-list {
    font-size: var(--fs-xs);
  }

  .data-table .cell-comma-list-item {
    display: inline;
    white-space: nowrap;
  }

  .data-table .cell-comma-list-item + .cell-comma-list-item::before {
    content: ", ";
  }

  .data-table .status-badge-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  .data-table-loading-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--text);
    z-index: 10;
    animation: dataTableLoadingBar 1.2s ease-in-out infinite;
  }

  @keyframes dataTableLoadingBar {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  .data-table .cell-number {
    font-variant-numeric: tabular-nums;
  }

  .data-table .cell-date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .data-table .row-link-icon {
    opacity: 0;
    transition: opacity 0.12s;
    color: var(--text-muted);
  }

  .data-table tbody tr:hover .row-link-icon {
    opacity: 1;
  }

  .app-content {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Report detail: header + toolbar in one row, content below */
  .report-overview-page {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    max-width: none;
  }

  .report-overview-page > .detail-header {
    flex: 1;
    min-width: 0;
  }

  .report-overview-page > .report-overview-toolbar {
    margin-left: auto;
    margin-bottom: 0;
  }

  .report-overview-page > .report-overview-grid,
  .report-overview-page > .kontrolpunkter-section,
  .report-overview-page > .detail-loading,
  .report-overview-page > .error-state {
    flex: 0 0 100%;
  }

  .report-overview-page > .report-overview-grid {
    margin-top: var(--section-gap);
  }

  .report-overview-page > .kontrolpunkter-section {
    margin-top: var(--section-gap);
  }

  /* 2-column grid for main sections */
  .report-overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem var(--section-gap);
    align-items: start;
    align-content: start;
  }

  .report-overview-grid > .detail-section,
  .report-overview-grid > .collapsible-section {
    margin-bottom: 0;
    background: none;
    border: none;
    border-radius: 0;
    padding: 0 0 var(--section-gap) 0;
    border-bottom: 1px solid var(--border);
  }

  .report-overview-grid > .report-overview-toolbar {
    margin-bottom: 0;
  }

  .report-overview-grid > .report-overview-colpair {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--section-gap);
    margin-bottom: 0;
    padding: 0 0 var(--section-gap) 0;
    border-bottom: 1px solid var(--border);
  }

  .report-overview-grid > .report-overview-colpair > .detail-section {
    margin-bottom: 0;
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    border-bottom: none;
  }

  .report-overview-grid > .detail-section:last-child,
  .report-overview-grid > .collapsible-section:last-child,
  .report-overview-grid > .report-overview-colpair:last-child {
    border-bottom: none;
  }

  /* Kontrolpunkter: full-width section below the grid */
  .report-overview-page > .kontrolpunkter-section {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    margin-top: var(--section-gap);
  }

  .report-overview-page > .kontrolpunkter-section .collapsible-section-trigger {
    cursor: pointer;
    padding: var(--card-padding);
    margin-bottom: var(--section-header-margin);
    border-radius: var(--radius-lg);
  }

  .report-overview-page > .kontrolpunkter-section .collapsible-section-content {
    display: block;
  }

  /* Collapsible sections inside grid: show toggle arrow */
  .report-overview-grid .collapsible-section-trigger {
    cursor: pointer;
    padding: var(--card-padding);
    margin-bottom: var(--section-header-margin);
    border-radius: var(--radius-lg);
  }

  .report-overview-grid .collapsible-section-content {
    display: block;
  }

  /* Section headers: consistent */
  .report-overview-grid .section-header-row,
  .report-overview-grid .attestation-compact-header {
    margin-bottom: var(--section-header-margin);
  }

  .report-overview-grid .report-overview-hero .section-header-row {
    margin-bottom: var(--section-header-margin);
  }

  /* Content spacing: consistent (flat layout, no gap) */
  .report-overview-grid .attestation-data-list,
  .report-overview-grid .report-overview-chip-list,
  .report-overview-grid .report-overview-link-list,
  .report-overview-grid .worksheet-list-section {
    margin-top: 0;
  }

  .report-overview-grid .attestation-observations-list {
    margin: 0;
    padding-top: 0;
    border-top: none;
  }

  /* Section headers: cleaner */
  .report-overview-grid .section-header-row {
    margin-bottom: 0.75rem;
  }
}

/* Validation error */
.validation-error {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  margin-bottom: 1rem;
  background: var(--status-red-bg);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: var(--radius-sm);
  color: var(--status-red-text);
  font-size: var(--fs-body);
}

/* ------------------------------------------------------------
   Worksheet list (Job step 4)
   ------------------------------------------------------------ */

/* ------------------------------------------------------------
   Unified Worksheet List Component
   ------------------------------------------------------------ */
.worksheet-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 1rem;
  margin: 0;
  list-style: none;
}

.worksheet-list-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem 0.65rem 1rem;
  border-radius: var(--radius);
  background: var(--surface);
  border: 1px solid var(--border);
  min-height: 48px;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.worksheet-list-item::before {
  content: '';
  position: absolute;
  top: 10px;
  bottom: 10px;
  left: 0;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: transparent;
}

.worksheet-list-item.is-selected::before {
  background: var(--primary);
}

.worksheet-list-item-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: row;
  align-items: baseline;
  gap: 0.5rem;
}

.worksheet-list-item-title {
  overflow: hidden;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.worksheet-list-item-subtitle {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 400;
  white-space: nowrap;
  flex-shrink: 0;
}

.worksheet-list-item-metrics {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 0.5rem;
  flex-shrink: 0;
  max-width: 100%;
}

.worksheet-list-item-badge {
  display: inline-flex;
  align-items: baseline;
  gap: 0.25rem;
  padding: 0.3rem 0.65rem;
  border-radius: var(--radius-pill);
  color: var(--text);
  font-size: var(--fs-xs);
  white-space: nowrap;
  border: 1px solid var(--border);
}

.worksheet-list-item-tag {
  padding: 0.3rem 0.6rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  font-size: var(--fs-xs);
  font-weight: 500;
  white-space: nowrap;
}

.worksheet-list-item-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.worksheet-list--detail {
  gap: 0.5rem;
}

.worksheet-list-item--detail {
  align-items: center;
  gap: 0.75rem;
  background: none;
  border: none;
  border-radius: 0;
  padding: 0.45rem 0;
  min-height: 0;
}

.worksheet-list-item--detail:not(:last-child) {
  border-bottom: 1px solid var(--border);
}

.worksheet-list-item--detail.worksheet-list-item--editing {
  border-bottom: none;
}

.worksheet-list-item--detail .worksheet-list-item-badge,
.worksheet-list-item--detail .worksheet-list-item-tag {
  border: none;
}

.worksheet-list-item-main--detail {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  overflow: hidden;
  gap: 0.12rem;
  flex: 1 1 auto;
}

@media (min-width: 768px) {
  .worksheet-list-item-main--detail {
    flex-direction: row;
    align-items: baseline;
    gap: 0.5rem;
  }
}

.worksheet-list-item-main--detail .worksheet-list-item-title {
  font-size: var(--fs-sm);
  line-height: 1.2;
}

.worksheet-list-item--detail .worksheet-list-item-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.worksheet-list-item-subtitle--detail {
  font-size: var(--fs-xs);
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 0 0 auto;
}

.worksheet-list-item-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 0.4rem;
  min-width: 0;
  margin-left: auto;
  flex: 0 0 auto;
}

.worksheet-list-item-actions--detail {
  margin-left: 0;
  flex: 0 0 auto;
}

.worksheet-list-item--editing {
  flex-wrap: wrap;
  align-items: flex-start;
}

.worksheet-list-item-edit {
  flex: 1 0 100%;
  width: 100%;
}

.worksheet-list-item--editing .worksheet-form {
  width: 100%;
  margin-top: 0.15rem;
}

.worksheet-actions-menu {
  position: fixed;
  z-index: 2500;
  display: flex;
  flex-direction: column;
  min-width: 10rem;
  padding: 0.35rem;
  background: var(--surface-actions-menu);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(16px);
}

.worksheet-actions-menu button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.55rem 0.7rem;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: var(--fs-sm);
  text-align: left;
  cursor: pointer;
}

.worksheet-actions-menu button:hover {
  background: var(--surface-raised);
}

.worksheet-actions-menu button.danger {
  color: var(--status-red-text);
}

.worksheet-actions-menu button.danger:hover {
  background: var(--status-red-bg);
}

@media (max-width: 640px) {
  .worksheet-list-item {
    gap: 0.5rem;
    padding: 0.5rem 0.65rem 0.5rem 0.85rem;
    flex-wrap: wrap;
  }

  .worksheet-list-item--detail {
    flex-wrap: nowrap;
  }

  .worksheet-list-item-main {
    gap: 0.4rem;
    width: 100%;
  }

  .worksheet-list-item-main--detail {
    gap: 0.12rem;
    width: auto;
  }

  .worksheet-list-item-metrics {
    width: 100%;
    justify-content: flex-end;
  }

  .worksheet-list-item-meta {
    width: auto;
  }

  .worksheet-list-item-badge {
    padding: 0.25rem 0.55rem;
  }

  .worksheet-list-item-edit {
    min-width: 0;
  }
}

.worksheet-form {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  padding: 0.65rem;
  background: var(--surface-overlay);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  position: relative;
}

.worksheet-form--compact {
  box-shadow: none;
}

.worksheet-form h4 {
  margin: 0 0 0.1rem 0;
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.01em;
}

.worksheet-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.4rem;
}

.worksheet-form .form-input,
.worksheet-form .multi-select-trigger {
  min-height: 38px;
}

.worksheet-form .form-label {
  font-size: var(--fs-xs);
  margin-bottom: 0.15rem;
}

.worksheet-form-grid .multi-select-field {
  min-width: 0;
}

.worksheet-form-grid-main .multi-select-chips {
  margin-top: 0.1rem;
}

.worksheet-form-grid-hours {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  margin-top: 0;
}

.worksheet-overnight-wrapper {
  align-self: end;
  min-width: 7rem;
  display: flex;
}

@media (min-width: 640px) {
  .worksheet-form-grid-main {
    grid-template-columns: 0.8fr 1.2fr;
  }
}

/* ------------------------------------------------------------
   Calendar picker
   ------------------------------------------------------------ */
.calendar-picker-field {
  position: relative;
}

.calendar-picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  cursor: pointer;
}

.calendar-picker-popover {
  position: absolute;
  z-index: 25;
  top: calc(100% + 0.4rem);
  left: 0;
  width: min(19rem, calc(100vw - 3rem));
  padding: 0.75rem;
  background: var(--surface-modal);
  border: none;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.calendar-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.65rem;
  color: var(--text);
  font-weight: 400;
  text-transform: capitalize;
}

.calendar-picker-weekdays,
.calendar-picker-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.25rem;
}

.calendar-picker-weekdays {
  margin-bottom: 0.35rem;
  color: var(--text-muted);
  font-size: var(--fs-xs);
  text-align: center;
}

.calendar-picker-day {
  min-height: 2rem;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text);
  cursor: pointer;
}

.calendar-picker-day:hover,
.calendar-picker-day.selected {
  background: var(--primary);
  color: white;
}

.worksheet-overnight-wrapper .multi-select-option {
  min-height: 38px;
  width: 100%;
  padding-top: 0.35rem;
  padding-bottom: 0.35rem;
}

.worksheet-form-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0;
  width: 100%;
}

.worksheet-form-actions .btn {
  white-space: nowrap;
  min-height: 36px;
  padding: 0.35rem 0.8rem;
  font-size: var(--fs-sm);
}

.worksheet-form-actions .btn-primary {
  flex: 2 1 0;
  min-height: 36px;
}

.worksheet-form-actions .btn-secondary {
  flex: 1 1 0;
}

.worksheet-form-actions--compact {
  gap: 0.35rem;
}

.worksheet-add-trigger {
  width: fit-content;
  min-height: 36px;
  padding: 0.4rem 0.9rem;
  font-size: var(--fs-lg);
  font-weight: 500;
}

.worksheet-add-trigger-cta {
  width: 100%;
  min-height: 46px;
  padding: 0.65rem 1rem;
  font-size: var(--fs-body);
  font-weight: 400;
  margin-top: 0.75rem;
}

/* ------------------------------------------------------------
   Attestation (Job step 5)
   ------------------------------------------------------------ */
.attestation-hero-section {
  display: flex;
  flex-direction: column;
  gap: var(--section-content-margin);
}

.attestation-status {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: var(--radius-lg);
  background: var(--status-amber-bg);
  color: var(--warning);
}

.attestation-status.submitted {
  background: var(--status-blue-bg);
  color: var(--status-blue-text);
}

.attestation-status div {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.attestation-status-title {
  color: var(--text);
  font-size: var(--fs-body);
}

.attestation-status span:not(.attestation-status-title) {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.attestation-compact-header {
  margin-bottom: var(--section-header-margin);
}

.worksheet-list-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.worksheet-list--scrollable {
  max-height: 400px;
  overflow-y: auto;
  padding-right: 0.25rem;
}

.worksheet-list--scrollable::-webkit-scrollbar {
  width: 4px;
}

.worksheet-list--scrollable::-webkit-scrollbar-track {
  background: transparent;
}

.worksheet-list--scrollable::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: var(--radius-pill);
}

.worksheet-list-totals {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 1rem 1.5rem;
  margin-top: var(--section-content-margin);
  padding-top: var(--section-content-margin);
  border-top: 1px solid var(--border);
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.worksheet-list-totals span {
  display: inline-flex;
  align-items: baseline;
  gap: 0.4rem;
  white-space: nowrap;
}

.worksheet-list-totals strong {
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
}

.attestation-data-list {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.4rem 1.25rem;
  align-items: baseline;
  margin: 0;
}

.attestation-data-pair {
  display: contents;
}

.attestation-data-pair dt {
  color: var(--text-muted);
  font-size: var(--fs-sm);
  font-weight: 400;
}

.attestation-data-pair dd {
  margin: 0;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  word-break: break-word;
}

.attestation-observations-list {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.4rem 1.25rem;
  align-items: baseline;
  margin: var(--section-content-margin) 0 0;
  padding-top: var(--section-content-margin);
  border-top: 1px solid var(--surface-elevated);
}

.attestation-observations-list .attestation-data-pair {
  display: contents;
}

.attestation-observations-list .attestation-data-pair dt {
  color: var(--text-muted);
  font-size: var(--fs-sm);
  font-weight: 400;
}

.attestation-observations-list .attestation-data-pair dd {
  margin: 0;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  white-space: pre-wrap;
  line-height: 1.5;
  word-break: break-word;
}

/* Long-form free-text fields (observationer/noter). Each note gets its own
   block with a small label above the body so paragraphs of technician notes
   don't have to share a column with one-word values like "Sag" / "Kunde".
   The new layout also leaves a divider between notes so multi-paragraph
   inputs stay scannable. */
.attestation-notes-list {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  margin: 0;
}

.attestation-note {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 0.65rem 0.85rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.attestation-note + .attestation-note {
  margin-top: 0;
}

.attestation-note-label {
  margin: 0;
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.attestation-note-value {
  margin: 0;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}



.attestation-control-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 0;
  margin: 0;
}

.attestation-control-list.compact {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  gap: 0.4rem;
}

/* Control point grid: installation types side by side */
.attestation-control-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  gap: 1.5rem;
  align-items: start;
}

.attestation-installation-block {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.attestation-installation-title {
  font-size: var(--fs-body);
  font-weight: 500;
  margin: 0;
  color: var(--text);
}

/* Categories within installation type, flowing horizontally */
.attestation-category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: start;
}

.attestation-category-block {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  min-width: 12rem;
  flex: 1;
}

.attestation-category-label {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 500;
  letter-spacing: 0.05em;
}

.attestation-category-block--muted {
  opacity: 0.55;
}

.attestation-irrelevant-section {
  margin-top: 1.5rem;
}

.attestation-irrelevant-section-title {
  font-size: var(--fs-body);
  font-weight: 500;
  margin: 0 0 0.75rem;
  color: var(--text-muted);
}

.attestation-control-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem;
  border-radius: var(--radius);
}

.attestation-control-list.compact li {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  padding: 0;
  border-radius: 0;
  color: var(--text);
}

.attestation-control-list.compact .attestation-control-point-name {
  display: inline-flex;
  align-items: baseline;
  gap: 0.3rem;
  font-size: var(--fs-sm);
  color: var(--text);
  white-space: normal;
}

.attestation-control-point-check {
  color: var(--success);
  font-size: var(--fs-xs);
}

.attestation-control-list.compact span,
.attestation-control-list.compact small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attestation-control-list.compact span {
  color: var(--text);
  font-size: var(--fs-sm);
  overflow: visible;
  white-space: normal;
  text-overflow: clip;
}

.attestation-control-list.compact small {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.attestation-status-flags {
  padding-left: 1.25rem;
  margin: 0;
}

.attestation-status-flags li {
  color: var(--text);
  font-size: var(--fs-sm);
}

.attestation-control-list div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-control-list span {
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.attestation-irrelevant-block {
  margin-top: var(--section-content-margin);
  padding-top: var(--section-content-margin);
  border-top: 1px solid var(--border);
}

.attestation-irrelevant-collapsible {
  border: none !important;
  padding: 0 !important;
  margin-top: var(--section-content-margin);
}

.attestation-irrelevant-collapsible .collapsible-section-trigger {
  padding: 0.5rem 0;
}

.attestation-irrelevant-collapsible .collapsible-section-content {
  padding: 0;
}

.attestation-irrelevant-label {
  display: block;
  margin-bottom: 0.4rem;
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 500;
  letter-spacing: 0.05em;
}

.attestation-irrelevant-block .attestation-control-list.compact {
  margin-top: 0;
}

.attestation-confirm-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-confirm-section .attestation-confirm-row {
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.attestation-validation-error {
  align-items: flex-start;
}

.attestation-validation-title {
  display: block;
  margin-bottom: 0.35rem;
}

.attestation-validation-error ul {
  padding-left: 1rem;
  margin: 0;
}

.attestation-confirm-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.9rem 1rem;
  color: var(--text);
  background: var(--surface);
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

@media (hover: hover) {
.attestation-confirm-row:hover {
  background: var(--overlay-light-0055);
  border-color: var(--border);
}
}

.attestation-confirm-row.confirmed {
  background: var(--surface);
  border-color: var(--border);
}

.attestation-confirm-row.disabled {
  cursor: default;
  opacity: 0.65;
}

@media (hover: hover) {
.attestation-confirm-row.disabled:hover {
  background: var(--surface);
  border-color: var(--surface-selected-strong);
}
}

@media (hover: hover) {
.attestation-confirm-row.confirmed.disabled:hover {
  background: var(--surface);
  border-color: var(--border);
}
}

.attestation-confirm-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-confirm-label {
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.35;
}

.attestation-confirm-description {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  line-height: 1.4;
}

.attestation-confirm-row input {
  position: relative;
  flex: 0 0 auto;
  width: 1.25rem;
  height: 1.25rem;
  margin: 0.05rem 0 0;
  appearance: none;
  -webkit-appearance: none;
  background: var(--overlay-dark-095);
  border: 1px solid var(--text-muted);
  border-radius: var(--radius-sm);
  box-shadow: inset 0 1px 0 var(--surface-selected);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.attestation-confirm-row input:checked {
  background: var(--surface-selected);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--surface-elevated);
}

.attestation-confirm-row input:checked::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 46%;
  width: 0.32rem;
  height: 0.62rem;
  border: solid var(--text);
  border-width: 0 2px 2px 0;
  transform: translate(-50%, -50%) rotate(45deg);
  transform-origin: center;
}

.attestation-confirm-row input:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

.attestation-confirm-row input:disabled {
  cursor: default;
}

.attestation-submit-row {
  display: flex;
}

.attestation-submit-button {
  width: 100%;
  min-height: 48px;
  padding: 0.75rem 1.5rem;
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: 0.01em;
  border-radius: var(--radius);
  flex: 1 1 auto;
  justify-content: center;
}

.attestation-submit-button-locked {
  background: var(--surface);
  color: var(--text-muted);
  border: 1px dashed var(--border);
  box-shadow: none;
  cursor: not-allowed;
}

@media (hover: hover) {
.attestation-submit-button-locked:hover {
  background: var(--surface);
  transform: none;
  box-shadow: none;
}
}

.attestation-submitted-badge {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.9rem 1.1rem;
  border-radius: var(--radius);
  background: var(--status-green-bg);
  border: 1px solid rgba(34, 197, 94, 0.32);
  color: var(--status-green-text);
}

.attestation-submitted-badge > div {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-submitted-badge-title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--status-green-text);
}

.attestation-submitted-badge-subtitle {
  font-size: var(--fs-xs);
  color: var(--status-green-text);
  line-height: 1.4;
}

@media (max-width: 640px) {
  .worksheet-list--scrollable {
    max-height: 320px;
  }

  .attestation-submit-button {
    width: 100%;
  }
}

/* ------------------------------------------------------------
   Submission confirmation
   ------------------------------------------------------------ */
.submission-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 5rem 1.5rem;
  text-align: center;
  min-height: 50vh;
}

.submission-overlay-spinner {
  color: var(--primary);
  animation: spin 0.8s linear infinite;
}

.submission-overlay-title {
  margin: 0;
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--text);
}

.submission-overlay-body {
  margin: 0;
  color: var(--text-muted);
  font-size: var(--fs-body);
}

@keyframes pop-in {
  0% { transform: scale(0); opacity: 0; }
  40% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes modal-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modal-scale-in {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes row-delete {
  to { opacity: 0; transform: translateX(20px); height: 0; padding: 0; margin: 0; overflow: hidden; }
}

@keyframes ring-draw {
  0% { stroke-dashoffset: 226; }
  100% { stroke-dashoffset: 0; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.submitted-confirmation {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 3rem 1.5rem;
  text-align: center;
}

.submitted-confirmation-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: white;
  margin-bottom: 0.5rem;
  animation: pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.submitted-confirmation-title {
  margin: 0;
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
}

.submitted-confirmation-body {
  margin: 0;
  max-width: 36rem;
  color: var(--text-muted);
  font-size: var(--fs-body);
  line-height: 1.5;
}

.submitted-confirmation-date {
  margin: 0;
  color: var(--text-dim);
  font-size: var(--fs-xs);
}

.submitted-confirmation-button {
  margin-top: 0.75rem;
  min-width: 12rem;
}

.job-details-header-spacer {
  height: 0;
}

.btn-icon-back {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border-radius: var(--radius-pill);
  transition: all 0.2s;
  margin-right: 0.25rem;
}

@media (hover: hover) {
.btn-icon-back:hover {
  background: var(--surface-raised);
  color: var(--text);
}
}

.section-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--text);
  margin: 1.5rem 0 0.75rem;
  letter-spacing: -0.01em;
}

.user-detail-info {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 0.6rem 0.85rem;
  background: var(--surface);
  border-radius: var(--radius);
  margin-bottom: 1.25rem;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.detail-row svg {
  flex-shrink: 0;
  color: var(--text-muted);
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 1rem;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0.65rem 0.75rem 0.65rem 2.2rem;
  color: var(--text);
  font: inherit;
  font-size: var(--fs-body);
  background: var(--surface);
  border: 1px solid var(--surface-selected-strong);
  border-radius: var(--radius-sm);
  outline: none;
  transition: border-color 0.15s;
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-input:focus {
  border-color: var(--focus-ring);
}

.search-input-icon {
  position: absolute;
  left: 0.7rem;
  color: var(--text-muted);
  pointer-events: none;
}

.search-input-clear {
  position: absolute;
  right: 0.4rem;
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: var(--radius-pill);
  transition: color 0.15s, background 0.15s;
}

@media (hover: hover) {
.search-input-clear:hover {
  color: var(--text);
  background: var(--surface-raised);
}
}

.job-sort-controls-scroll {
  position: relative;
  margin-bottom: 1rem;
}

.job-sort-controls-scroll::before,
.job-sort-controls-scroll::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2.5rem;
  z-index: 1;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.job-sort-controls-scroll::before {
  left: 0;
  background: linear-gradient(to right, var(--bg) 10%, transparent);
}

.job-sort-controls-scroll::after {
  right: 0;
  background: linear-gradient(to left, var(--bg) 10%, transparent);
}

.job-sort-controls-scroll[data-scroll-left="true"]::before,
.job-sort-controls-scroll[data-scroll-right="true"]::after {
  opacity: 1;
}

@media (min-width: 768px) {
  .job-sort-controls-scroll::before,
  .job-sort-controls-scroll::after {
    display: none;
  }
}

.job-sort-controls {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  align-items: center;
  gap: 0.5rem;
  scrollbar-width: none;
}

.job-sort-controls::-webkit-scrollbar {
  display: none;
}

.job-sort-secondary {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.sort-label {
  font-size: 0.875rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.sort-btn {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.3rem 0.75rem;
  font-size: 0.8125rem;
  color: var(--text);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}

.sort-btn:hover {
  background: var(--surface-raised);
  border-color: var(--border-strong);
  color: var(--text);
}

.sort-btn.active {
  border-color: black;
  color: var(--text);
  font-weight: 500;
}

.search-input-icon {
  position: absolute;
  left: 0.65rem;
  color: var(--text-muted);
  pointer-events: none;
}

.job-card--disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.meta-item--success {
  color: var(--status-green-text);
}

.meta-item--muted {
  color: var(--text-muted);
}


@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

@media (max-width: 640px) {
  .app-header-user {
    display: none;
  }

  .app-header-logout span {
    display: none;
  }

  .app-header-logout {
    padding: 0.5rem;
  }
}

.edit-form-bottom-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 2rem;
}

.edit-form-bottom-btn {
  flex: 1;
  gap: 0.5rem;
}

.edit-form-bottom-actions .btn-primary {
  flex: 1.5;
}

.edit-form-save-btn {
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
}

.invite-send-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  margin-top: 1rem;
}

.invite-send-btn:disabled {
  opacity: 0.35;
  background: var(--text-dim);
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
}

/* Settings / Invite UI */
.section-card {
  background: var(--surface);
