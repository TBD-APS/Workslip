/* App Shell & Forms CSS */

/* Forms */
.form-input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--surface-input);
  border: none;
  border-radius: 12px;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 1rem;
  transition: all 0.2s ease;
}

.form-input:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgba(0, 112, 243, 0.45);
}

.form-input::placeholder {
  color: var(--text-secondary);
  opacity: 0.5;
}

/* App Shell Layout (Mobile First) */
.app-shell :is(h1, h2, h3, h4, h5, h6, strong, b) {
  font-weight: 400;
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100dvh; /* use dvh for mobile browsers */
  background-color: var(--bg-color);
  overflow: hidden;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.5rem;
  background: rgba(5, 5, 5, 0.8);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--surface-border);
  z-index: 10;
  gap: 1rem;
}

.app-header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.app-header-user {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 0.65rem;
  border-radius: 999px;
  background: var(--surface-elevated);
  color: var(--text-secondary);
  font-size: 0.85rem;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-header-logout {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.85rem;
  border-radius: 999px;
  background: var(--surface-elevated);
  color: var(--text-primary);
  border: 1px solid var(--surface-border);
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.app-header-logout:hover {
  background: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.4);
  color: #ef4444;
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--surface-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
}

.app-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  padding-bottom: calc(80px + 1.5rem); /* Make room for bottom nav */
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 80px;
  background: rgba(15, 15, 15, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--surface-border);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  color: var(--text-secondary);
  font-size: 0.75rem;
  font-weight: 400;
  flex: 1;
  transition: color 0.2s;
}

.nav-item.active {
  color: var(--accent-color);
}

.nav-item-fab {
  flex: 1;
  display: flex;
  justify-content: center;
  transform: translateY(-20px);
}

.fab-button {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #2563eb;
  border: none;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.32);
  cursor: pointer;
  transition: transform 0.2s;
}

.fab-button:active {
  transform: scale(0.95);
}

/* Job List Components */
.page-container {
  max-width: 600px;
  margin: 0 auto;
}

.job-detail-page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

.job-detail-page .step-nav {
  margin-top: auto;
}

.page-header {
  margin-bottom: 1.5rem;
}

.page-header h2 {
  font-size: 1.75rem;
  margin-bottom: 0.25rem;
}

.subtitle {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* Job list gap */
.job-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* ------------------------------------------------------------
   Card
   ------------------------------------------------------------ */
.job-card {
  background: var(--surface-card);
  border: none;
  border-radius: 16px;
  padding: 1.1rem 1.25rem;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  cursor: pointer;
  color: inherit;
  font: inherit;
  text-align: left;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}

.job-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: transparent;
  transition: background 0.2s;
}

.job-card.is-urgent::before {
  background: linear-gradient(180deg, #f97316, #ef4444);
}

.job-card:hover {
  background: var(--surface-elevated);
}

.job-card:active {
  transform: scale(0.995);
}

.completed-job-card {
  cursor: default;
}

.completed-job-card:hover {
  background: var(--surface-card);
}

.completed-job-card:active {
  transform: none;
}

.completed-job-card-footer {
  gap: 0.75rem;
}

.report-overview-page {
  padding-bottom: 1rem;
}

.report-overview-header {
  align-items: center;
}

.report-overview-header > div {
  min-width: 0;
}

.report-overview-pdf {
  min-height: 2.5rem;
  margin-left: 0;
}

.report-overview-actions {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
  min-height: 2.5rem;
}

.report-overview-icon-action {
  width: 2.5rem;
  min-width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border-radius: 10px;
}

.report-overview-icon-action:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}


.report-overview-hero {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.report-overview-hero .section-header-row {
  margin-bottom: 0;
}

.report-overview-data-list {
  margin-top: 0.75rem;
}

.report-overview-block-gap {
  margin-top: 1rem;
}

.report-overview-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.report-overview-chip {
  width: fit-content;
}

.report-overview-link-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.report-overview-link-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.3rem 0.75rem;
  width: 100%;
  padding: 0.85rem 1rem;
  border: none;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.report-overview-link-card:hover {
  background: rgba(255, 255, 255, 0.07);
}

.report-overview-link-card .job-number {
  grid-column: 1 / -1;
  margin-bottom: 0;
}

.report-overview-link-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
  font-size: 0.95rem;
}

.report-overview-timesheet-list {
  margin-bottom: 0.75rem;
}

@media (max-width: 640px) {
  .report-overview-header {
    flex-wrap: wrap;
  }

  .report-overview-actions {
    width: 100%;
    margin-left: 0;
  }

  .report-overview-pdf {
    flex: 1 1 auto;
  }

  .completed-job-card-footer {
    align-items: flex-start;
  }
}

.pdf-download-button {
  gap: 0.4rem;
  padding: 0.55rem 0.9rem;
  border-radius: 10px;
  white-space: nowrap;
}

.pdf-download-button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.pdf-preview-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.72);
}

.pdf-preview-panel {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--surface);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}

.pdf-preview-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem;
  border-bottom: 1px solid var(--border);
}

.pdf-preview-header h3 {
  margin: 0.1rem 0 0;
  color: var(--text-primary);
  font-size: 1rem;
  font-weight: 400;
  word-break: break-word;
}

.pdf-preview-header p {
  margin: 0.35rem 0 0;
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.pdf-preview-frame {
  flex: 1;
  width: 100%;
  min-height: 65vh;
  border: 0;
  background: #1f2937;
}

@media (max-width: 640px) {
  .pdf-preview-overlay {
    padding: 0;
  }

  .pdf-preview-panel {
    min-height: 100dvh;
    border: 0;
    border-radius: 0;
  }

  .pdf-preview-frame {
    min-height: 70vh;
  }
}

.spin {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ------------------------------------------------------------
   Card top: SAG-id + customer name (left), status pill (right)
   ------------------------------------------------------------ */
.job-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
}

.job-number {
  display: inline-block;
  font-family: var(--font-main);
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  text-transform: uppercase;
  margin-bottom: 0.3rem;
}

.job-customer {
  font-family: var(--font-heading);
  font-size: 1.12rem;
  font-weight: 400;
  margin: 0;
  line-height: 1.25;
  color: var(--text-primary);
}

/* ------------------------------------------------------------
   Address row
   ------------------------------------------------------------ */
.job-address-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.job-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ------------------------------------------------------------
   Meta row: date, urgency badges, hours
   ------------------------------------------------------------ */
.job-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 0.75rem;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.meta-hours {
  color: var(--text-secondary);
  font-weight: 400;
}

.meta-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.meta-badge.is-urgent {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
}

.meta-badge.is-today {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
}

.meta-badge.is-upcoming {
  background: rgba(0, 112, 243, 0.15);
  color: #60a5fa;
}

/* ------------------------------------------------------------
   Card header: status badge + job ID
   ------------------------------------------------------------ */
.job-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ------------------------------------------------------------
   Status badges
   ------------------------------------------------------------ */
.status-badge {
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.3px;
}

.status-draft {
  background: rgba(161, 161, 170, 0.12);
  color: #a1a1aa;
}

.status-assigned {
  background: rgba(0, 112, 243, 0.12);
  color: #60a5fa;
}

.status-submitted {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
}

.status-inreview {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
}

.status-approved {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
}

.status-rejected {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
}

.status-returned {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
}

.status-archived {
  background: rgba(161, 161, 170, 0.08);
  color: #6b7280;
}

/* ------------------------------------------------------------
   Customer name
   ------------------------------------------------------------ */
.job-customer {
  font-size: 1.05rem;
  font-weight: 400;
  margin: 0;
  line-height: 1.3;
}

/* (legacy detail-row classes removed — meta badges now use job-card-meta) */

/* ------------------------------------------------------------
   Card footer: assigned users + chevron
   ------------------------------------------------------------ */
.job-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.25rem;
  padding-top: 0.25rem;
  border-top: 1px solid var(--surface-border);
}

.job-assigned {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.assigned-user {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.8rem;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.05);
  padding: 0.2rem 0.5rem;
  border-radius: 6px;
}

.unassigned {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.8rem;
  color: #6b7280;
  font-style: italic;
}

.btn-icon {
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: 50%;
  transition: all 0.2s;
}

.btn-icon:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

/* ------------------------------------------------------------
   Skeleton loading
   ------------------------------------------------------------ */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 8px;
}

.skeleton-title {
  width: 140px;
  height: 28px;
  margin-bottom: 8px;
}

.skeleton-subtitle {
  width: 100px;
  height: 16px;
}

.skeleton-badge {
  width: 60px;
  height: 20px;
  border-radius: 999px;
}

.skeleton-id {
  width: 70px;
  height: 14px;
}

.skeleton-name {
  width: 180px;
  height: 18px;
}

.skeleton-address {
  width: 100%;
  height: 14px;
}

.skeleton-tag {
  width: 80px;
  height: 18px;
}

.skeleton-chevron {
  width: 20px;
  height: 20px;
  border-radius: 50%;
}

.job-card-skeleton {
  cursor: default;
  pointer-events: none;
}

.job-card-skeleton:hover {
  background: var(--surface-card);
}

/* ------------------------------------------------------------
   Empty & error states
   ------------------------------------------------------------ */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-secondary);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  text-align: center;
  padding: 4rem 2rem;
  color: #ef4444;
}

.error-state p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  max-width: 280px;
}

/* ------------------------------------------------------------
   Job Detail Page
   ------------------------------------------------------------ */
.detail-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.detail-header .btn-icon {
  flex-shrink: 0;
}

.detail-header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-icon-danger {
  color: rgba(248, 113, 113, 0.7);
  transition: color 0.15s, background 0.15s;
}

.btn-icon-danger:hover {
  color: #ef4444;
  background: rgba(248, 113, 113, 0.1);
}

.detail-title {
  font-size: 1.25rem;
  margin: 0;
}

.save-status {
  display: flex;
  align-items: center;
}

.save-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 400;
  padding: 0.25rem 0.6rem;
  border-radius: 8px;
  white-space: nowrap;
}

.save-indicator.saving {
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.05);
}

.save-indicator.saved {
  color: #93c5fd;
  background: rgba(37, 99, 235, 0.12);
}

.save-indicator.error {
  color: #f87171;
  background: rgba(239, 68, 68, 0.1);
}

.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 4rem 2rem;
  color: var(--text-secondary);
}

.detail-section {
  background: var(--surface-card);
  border: none;
  border-radius: 16px;
  padding: 1.25rem;
  margin-bottom: 1.5rem;
}

.section-header-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
  color: var(--text-primary);
}

.section-header-row h3 {
  font-size: 1rem;
  margin: 0;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.section-title-row h3 {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.03em;
  margin: 0;
}

.collapsible-section {
  padding: 0;
  overflow: hidden;
}

.collapsible-section-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem;
  color: var(--text-primary);
  font: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  cursor: pointer;
}

.collapsible-section-trigger:hover {
  background: rgba(255, 255, 255, 0.03);
}

.collapsible-chevron {
  flex-shrink: 0;
  color: var(--text-secondary);
  transition: transform 0.2s;
}

.collapsible-chevron.open {
  transform: rotate(90deg);
}

.collapsible-section-content {
  padding: 0 1.25rem 1.25rem;
}

.detail-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(14px);
}

.modal-card {
  width: min(100%, 420px);
  padding: 1.4rem;
  background: #111827;
  border: none;
  border-radius: 18px;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
}

.modal-card h3 {
  margin: 0 0 0.45rem;
  font-size: 1.25rem;
}

.modal-card p {
  margin: 0;
  color: var(--text-secondary);
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.work-category-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.work-field-group {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.work-field-label {
  color: var(--text-secondary);
  font-size: 0.78rem;
  font-weight: 400;
  letter-spacing: 0.08em;
}

.category-choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.7rem;
}

.choice-card {
  position: relative;
  overflow: hidden;
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.85rem 0.95rem 0.85rem 1rem;
  color: var(--text-primary);
  font: inherit;
  font-weight: 400;
  text-align: left;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid transparent;
  border-radius: 14px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, transform 0.15s;
}

.choice-card:active {
  transform: scale(0.98);
}

.choice-card.selected {
  background: var(--surface-selected);
}

.choice-card.selected::before,
.multi-select-option.selected::before,
.work-kind-option.selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: rgba(96, 165, 250, 0.85);
}

/* Afslutning — invalid steps warning */
.invalid-steps-warning {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  padding: 1rem 1.1rem;
  margin-bottom: 1.25rem;
  border-radius: 12px;
  background: rgba(234, 88, 12, 0.10);
  border: 1px solid rgba(234, 88, 12, 0.28);
}

.invalid-steps-warning .warning-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  color: #fdba74;
  font-size: 0.88rem;
  font-weight: 500;
  line-height: 1.4;
}

.invalid-steps-warning .warning-title svg {
  flex-shrink: 0;
  color: #fb923c;
}

.invalid-steps-links {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.invalid-step-btn {
  width: 100%;
  justify-content: flex-start;
  padding: 0.7rem 1.1rem;
  font-size: 0.88rem;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.04);
  text-align: left;
}

.invalid-step-btn:hover {
  background: rgba(255, 255, 255, 0.08);
}

.work-kind-list {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.work-kind-option {
  position: relative;
  overflow: hidden;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid transparent;
  border-radius: 12px;
  color: var(--text-primary);
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s;
}

.work-kind-option.selected {
  background: var(--surface-selected);
}

.work-kind-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.form-help-error {
  color: #f87171;
  font-size: 0.78rem;
}

.multi-select-field {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.multi-select-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.multi-select-dropdown {
  position: relative;
}

.multi-select-trigger {
  width: 100%;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem;
  color: var(--text-primary);
  font: inherit;
  text-align: left;
  background: var(--surface-input);
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
}

.multi-select-trigger:hover:not(:disabled),
.multi-select-trigger[aria-expanded="true"] {
  background: var(--surface-elevated);
}

.multi-select-trigger:disabled {
  cursor: wait;
  opacity: 0.65;
}

.multi-select-trigger-content {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-width: 0;
}

.multi-select-chevron {
  flex-shrink: 0;
  color: var(--text-secondary);
  transition: transform 0.2s;
}

.multi-select-chevron.open {
  transform: rotate(90deg);
}

.multi-select-menu {
  position: absolute;
  z-index: 20;
  top: calc(100% + 0.4rem);
  left: 0;
  right: 0;
  max-height: 260px;
  overflow-y: auto;
  padding: 0.35rem;
  background: #111827;
  border: none;
  border-radius: 14px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
}

.multi-select-menu::-webkit-scrollbar {
  width: 5px;
}

.multi-select-menu::-webkit-scrollbar-track {
  background: transparent;
}

.multi-select-menu::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 10px;
}

.multi-select-menu::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

.multi-select-search {
  padding: 0.15rem;
  margin-bottom: 0.2rem;
  background: #111827;
}

.multi-select-search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0.55rem 0.75rem;
  color: var(--text-primary);
  font: inherit;
  font-size: 0.85rem;
  background: rgba(255, 255, 255, 0.05);
  border: none;
  border-radius: 10px;
  outline: none;
  transition: border-color 0.15s;
}

.multi-select-search-input::placeholder {
  color: var(--text-secondary);
}

.multi-select-search-input:focus {
  border-color: rgba(96, 165, 250, 0.5);
}

.multi-select-option {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  color: var(--text-primary);
  font: inherit;
  text-align: left;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid transparent;
  border-radius: 12px;
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s;
}

.multi-select-option:hover {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.045);
}

.multi-select-option.selected {
  border-color: rgba(96, 165, 250, 0.42);
  background: rgba(37, 99, 235, 0.08);
}

.selection-pill {
  flex-shrink: 0;
  margin-left: auto;
  padding: 0.16rem 0.45rem;
  color: #bfdbfe;
  font-size: 0.72rem;
  font-weight: 400;
  letter-spacing: 0.03em;
  line-height: 1.2;
  border: 1px solid rgba(96, 165, 250, 0.26);
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.12);
}

.multi-select-option-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.multi-select-option-text small {
  color: var(--text-secondary);
  font-size: 0.75rem;
  white-space: pre-line;
  line-height: 1.3;
}

.multi-select-menu-empty {
  margin: 0;
  padding: 0.85rem;
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.multi-select-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.multi-select-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.22rem 0.35rem 0.22rem 0.6rem;
  color: #bfdbfe;
  font: inherit;
  background: rgba(96, 165, 250, 0.12);
  border: 1px solid rgba(96, 165, 250, 0.16);
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 400;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
}

.multi-select-chip:hover {
  background: rgba(96, 165, 250, 0.18);
  border-color: rgba(96, 165, 250, 0.28);
}

.multi-select-chip-remove {
  width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: rgba(191, 219, 254, 0.85);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  font-size: 0.9rem;
  line-height: 1;
}

.multi-select-chip:hover .multi-select-chip-remove {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}

.multi-select-empty {
  color: var(--text-secondary);
  font-size: 0.8rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.form-label {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.03em;
}

.form-input-invalid {
  border-color: rgba(239, 68, 68, 0.75);
}

.form-input-invalid:focus {
  border-color: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
}

.form-error-text {
  margin: 0.1rem 0 0;
  color: #f87171;
  font-size: 0.78rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-textarea {
  resize: vertical;
  min-height: 100px;
  font-family: var(--font-main);
  line-height: 1.5;
}

.btn-save {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  margin-top: 0.5rem;
}

.btn-save:disabled {
  opacity: 0.7;
  cursor: wait;
}

/* ------------------------------------------------------------
   Step indicators (stepper)
   ------------------------------------------------------------ */
.step-indicators {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.15rem;
  overflow-x: auto;
  padding-bottom: 0.25rem;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

.step-dot {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 46px;
  padding: 0.6rem 0.9rem;
  border-radius: 14px;
  border: 1px solid transparent;
  background: rgba(255, 255, 255, 0.035);
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 0.84rem;
  white-space: nowrap;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
}

.step-dot.active {
  color: var(--text-primary);
  background: var(--surface-selected-strong);
  box-shadow: 0 10px 26px rgba(37, 99, 235, 0.18);
}

.step-dot.completed {
  background: var(--surface-selected);
  color: #93c5fd;
}

.step-dot.completed:not(.active) {
  opacity: 0.82;
}

.step-label {
  font-weight: 400;
}

/* ------------------------------------------------------------
   Step navigation (prev / next buttons)
   ------------------------------------------------------------ */
.step-nav {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.5rem;
  padding: 0.75rem 1rem;
  background: var(--surface-card);
  border: none;
  border-radius: 16px;
}

.step-nav-sticky {
  position: sticky;
  bottom: 1rem;
  z-index: 15;
  backdrop-filter: blur(18px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.step-nav-sticky.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(calc(100% + 1.5rem));
}

.step-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.25rem;
  font: inherit;
  font-size: 0.85rem;
  font-weight: 400;
  border: 0;
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
}

.step-nav-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-secondary);
  box-shadow: none;
}

.step-nav-btn:disabled:hover {
  background: rgba(255, 255, 255, 0.04);
  transform: none;
}

.step-nav-btn-back {
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.06);
}

.step-nav-btn-back:not(:disabled):hover {
  background: rgba(255, 255, 255, 0.1);
}

.step-nav-btn-next {
  margin-left: auto;
  color: #fff;
  background: rgba(96, 165, 250, 0.2);
}

.step-nav-btn-next--wide {
  flex: 1;
  justify-content: center;
  min-width: 12rem;
}

.step-nav-btn-next:not(:disabled):hover {
  background: rgba(96, 165, 250, 0.35);
}

.step-nav-counter {
  font-size: 0.78rem;
  color: var(--text-secondary);
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

.control-points-list {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.control-point-type + .control-point-type {
  margin-top: 1.25rem;
}

.control-point-type {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
  padding: 0.75rem;
}

.control-point-type.collapsed {
  padding-bottom: 0.5rem;
}

.control-point-type-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  padding: 0;
  font: inherit;
  margin-bottom: 0.75rem;
  text-align: left;
}

.control-point-type.collapsed .control-point-type-header {
  margin-bottom: 0;
}

.control-point-chevron {
  flex-shrink: 0;
  color: var(--text-secondary);
  transition: transform 0.2s ease;
}

.control-point-chevron.open {
  transform: rotate(90deg);
}

.control-point-type-name {
  font-size: 1rem;
  font-weight: 400;
}

.control-point-type-body {
  padding-left: 0;
}

.control-point-category-group + .control-point-category-group {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.control-point-category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.25rem;
}

.control-point-category-label {
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.control-point-category-group.irrelevant .control-point-category-label {
  color: var(--text-disabled, rgba(255, 255, 255, 0.4));
}

.multi-select-option.control-point-irrelevant-row {
  min-height: 42px;
  padding: 0.6rem 0.8rem 0.6rem 1rem;
  margin-bottom: 0;
  color: var(--text-secondary);
}

.multi-select-option.control-point-irrelevant-row:hover {
  color: var(--text-primary);
}

.irrelevant-text {
  font-size: 0.75rem;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  white-space: nowrap;
}

.irrelevant-label {
  display: none;
}

.multi-select-option:disabled {
  opacity: 0.4;
  cursor: default;
}

.multi-select-option:disabled:hover {
  background: rgba(255, 255, 255, 0.025);
}

.multi-select-option.selected:disabled:hover {
  background: rgba(37, 99, 235, 0.08);
}

@media (min-width: 768px) {
  .app-shell {
    flex-direction: row;
  }
  
  .bottom-nav {
    display: none;
  }
  
  .app-content {
    padding-bottom: 1.5rem;
  }
}

/* Validation error */
.validation-error {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  margin-bottom: 1rem;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 10px;
  color: #fca5a5;
  font-size: 0.9rem;
}

/* ------------------------------------------------------------
   Worksheet list (Job step 4)
   ------------------------------------------------------------ */
.worksheet-section-header {
  flex-wrap: wrap;
}

.worksheet-section-header-totals {
  margin-left: auto;
  color: var(--text-secondary);
  font-size: 0.82rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

.worksheet-section-header-totals strong {
  color: var(--text-primary);
  font-weight: 500;
}

.worksheet-list-label {
  display: block;
  margin: 0 0 0.5rem 0;
  padding-left: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.worksheet-list {
  list-style: none;
  margin: 0 0 0.75rem 0;
  padding: 0.35rem;
  background: rgba(17, 24, 39, 0.6);
  border: none;
  border-radius: 14px;
  max-height: 280px;
  overflow-y: auto;
}

.worksheet-list.expanded {
  max-height: none;
  overflow: visible;
}

.worksheet-empty-state {
  margin-bottom: 0.75rem;
}

.worksheet-list::-webkit-scrollbar {
  width: 5px;
}

.worksheet-list::-webkit-scrollbar-track {
  background: transparent;
}

.worksheet-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 10px;
}

.worksheet-list::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

.worksheet-list-item {
  padding: 0.45rem 0.6rem;
  border-radius: 10px;
}

.worksheet-list-item-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-height: 36px;
}

.worksheet-list-item-metrics {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.worksheet-list-item-hours {
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
  gap: 0.2rem;
  min-width: 4.25rem;
  padding: 0.2rem 0.55rem;
  border: 1px solid rgba(96, 165, 250, 0.18);
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.08);
  color: #bfdbfe;
  white-space: nowrap;
}

.worksheet-list-item-hours-value {
  color: var(--text-primary);
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 400;
}

.worksheet-list-item-hours span:not(.worksheet-list-item-hours-value),
.worksheet-list-item-outlay {
  font-size: 0.68rem;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.worksheet-list-item-outlay {
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.12);
  color: #93c5fd;
  white-space: nowrap;
}

.worksheet-list-item.editing {
  background: rgba(255, 255, 255, 0.04);
}

.worksheet-list-item.editing .worksheet-form {
  margin-top: 0.75rem;
  width: 100%;
  background: rgba(0, 0, 0, 0.28);
}

.worksheet-list-item + .worksheet-list-item {
  margin-top: 0.15rem;
}

.worksheet-list-item:hover {
  background: rgba(255, 255, 255, 0.04);
}

.worksheet-list-item-actions {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.worksheet-actions-menu-root {
  position: relative;
}

.worksheet-actions-menu-root .btn-icon {
  min-width: 40px;
  min-height: 40px;
  border: 1px solid transparent;
}

.worksheet-actions-menu-root .btn-icon:hover,
.worksheet-actions-menu-root .btn-icon[aria-expanded="true"] {
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.07);
  color: var(--text-primary);
}

.worksheet-actions-menu {
  position: fixed;
  z-index: 1000;
  min-width: 8.5rem;
  padding: 0.25rem;
  background: #111827;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
}

.worksheet-actions-menu button {
  width: 100%;
  min-height: 2.25rem;
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.45rem 0.65rem;
  color: var(--text-primary);
  font: inherit;
  font-size: 0.85rem;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 9px;
  cursor: pointer;
}

.worksheet-actions-menu button:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.07);
}

.worksheet-actions-menu button.danger {
  color: #f87171;
}

.worksheet-actions-menu button:disabled {
  opacity: 0.45;
  cursor: default;
}

.worksheet-list-item-info {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  flex: 1;
  min-width: 0;
}

.worksheet-list-item-date {
  font-weight: 400;
  color: var(--text-primary);
  font-size: 0.92rem;
  line-height: 1.2;
}

.worksheet-list-item-meta {
  font-size: 0.78rem;
  color: var(--text-secondary);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.worksheet-form {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 0.85rem 0.85rem 0.85rem 1rem;
  background: var(--surface-selected);
  border: none;
  border-radius: 12px;
  position: relative;
}

.worksheet-form::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12px;
  bottom: 12px;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: rgba(96, 165, 250, 0.7);
}

.worksheet-form h4 {
  margin: 0 0 0.1rem 0;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.01em;
}

.worksheet-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.55rem;
}

.worksheet-form .form-input,
.worksheet-form .multi-select-trigger {
  min-height: 40px;
}

.worksheet-form .form-label {
  font-size: 0.72rem;
  margin-bottom: 0.2rem;
}

.worksheet-form-grid .multi-select-field {
  min-width: 0;
}

.worksheet-form-grid-main .multi-select-chips {
  margin-top: 0.15rem;
}

.worksheet-form-grid-hours {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  margin-top: 0;
}

.worksheet-overnight-wrapper {
  align-self: end;
  min-width: 8rem;
}

@media (min-width: 640px) {
  .worksheet-form-grid-main {
    grid-template-columns: 0.8fr 1.2fr;
  }
}

/* ------------------------------------------------------------
   Calendar picker
   ------------------------------------------------------------ */
.calendar-picker-field {
  position: relative;
}

.calendar-picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  cursor: pointer;
}

.calendar-picker-popover {
  position: absolute;
  z-index: 25;
  top: calc(100% + 0.4rem);
  left: 0;
  width: min(19rem, calc(100vw - 3rem));
  padding: 0.75rem;
  background: #111827;
  border: none;
  border-radius: 14px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
}

.calendar-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.65rem;
  color: var(--text-primary);
  font-weight: 400;
  text-transform: capitalize;
}

.calendar-picker-weekdays,
.calendar-picker-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.25rem;
}

.calendar-picker-weekdays {
  margin-bottom: 0.35rem;
  color: var(--text-secondary);
  font-size: 0.7rem;
  text-align: center;
}

.calendar-picker-day {
  min-height: 2rem;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--text-primary);
  cursor: pointer;
}

.calendar-picker-day:hover,
.calendar-picker-day.selected {
  background: var(--accent-color);
  color: white;
}

.worksheet-overnight-wrapper .multi-select-option {
  min-height: 40px;
  width: 100%;
}

.worksheet-form-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0;
  width: 100%;
}

.worksheet-form-actions .btn {
  white-space: nowrap;
  min-height: 38px;
  padding: 0.4rem 0.85rem;
  font-size: 0.85rem;
}

.worksheet-form-actions .btn-primary {
  flex: 2 1 0;
  min-height: 38px;
}

.worksheet-form-actions .btn-secondary {
  flex: 1 1 0;
}

.worksheet-add-trigger {
  width: fit-content;
  min-height: 36px;
  padding: 0.4rem 0.9rem;
  font-size: 0.82rem;
  font-weight: 500;
}

.worksheet-add-trigger-cta {
  width: 100%;
  min-height: 46px;
  padding: 0.65rem 1rem;
  font-size: 0.92rem;
  font-weight: 500;
  margin-top: 0.25rem;
}

/* ------------------------------------------------------------
   Attestation (Job step 5)
   ------------------------------------------------------------ */
.attestation-hero-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-status {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: 14px;
  background: rgba(250, 204, 21, 0.08);
  color: #facc15;
}

.attestation-status.submitted {
  background: rgba(37, 99, 235, 0.08);
  color: #93c5fd;
}

.attestation-status div {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.attestation-status-title {
  color: var(--text-primary);
  font-family: var(--font-heading);
  font-size: 0.98rem;
}

.attestation-status span:not(.attestation-status-title) {
  color: var(--text-secondary);
  font-size: 0.88rem;
}

.attestation-compact-header {
  margin-bottom: 0.65rem;
}

.attestation-timesheet-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.attestation-timesheet-totals {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  margin-top: 0.85rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.attestation-timesheet-totals span {
  display: inline-flex;
  align-items: baseline;
  gap: 0.4rem;
  white-space: nowrap;
}

.attestation-timesheet-totals strong {
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 400;
}

.attestation-timesheet-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 0;
  margin: 0;
  list-style: none;
}

.attestation-timesheet-list li {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem 0.65rem 1rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
}

.attestation-timesheet-list li::before {
  content: '';
  position: absolute;
  top: 12px;
  bottom: 12px;
  left: 0;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: rgba(96, 165, 250, 0.6);
}

.attestation-timesheet-main {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.15rem;
}

.attestation-timesheet-date {
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 400;
}

.attestation-timesheet-user {
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 0.78rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attestation-timesheet-hours {
  display: inline-flex;
  align-items: baseline;
  gap: 0.3rem;
  min-width: 4.5rem;
  justify-content: center;
  padding: 0.35rem 0.6rem;
  border-radius: 10px;
  background: rgba(37, 99, 235, 0.12);
  color: #bfdbfe;
}

.attestation-timesheet-hours-value {
  color: var(--text-primary);
  font-size: 0.95rem;
  font-weight: 400;
}

.attestation-timesheet-hours-unit,
.attestation-timesheet-badge {
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--text-secondary);
}

.attestation-timesheet-badge {
  padding: 0.3rem 0.5rem;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.16);
  color: #93c5fd;
  white-space: nowrap;
}

.attestation-data-list {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.4rem 1.25rem;
  align-items: baseline;
  margin: 0;
}

.attestation-data-pair {
  display: contents;
}

.attestation-data-pair dt {
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 400;
}

.attestation-data-pair dd {
  margin: 0;
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 400;
  word-break: break-word;
}

.attestation-observations-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin: 0.85rem 0 0;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.attestation-observations-list .attestation-data-pair {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.25rem 1.25rem;
  align-items: baseline;
}

.attestation-observations-list .attestation-data-pair dd {
  white-space: pre-wrap;
  line-height: 1.5;
}

.attestation-control-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 0;
  margin: 0;
  list-style: none;
}

.attestation-control-list.compact {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  gap: 0.4rem;
}

.attestation-control-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
}

.attestation-control-list.compact li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  column-gap: 0.45rem;
  row-gap: 0.1rem;
  align-items: start;
  padding: 0.5rem 0.65rem;
  border-radius: 10px;
}

.attestation-control-list.compact small {
  grid-column: 2;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 0.72rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attestation-control-accent {
  width: 3px;
  align-self: stretch;
  min-height: 1.9rem;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.78);
}

.attestation-control-accent.muted {
  background: rgba(245, 158, 11, 0.7);
}

.attestation-control-list-item-muted {
  opacity: 0.85;
}

.attestation-control-list-item-muted span {
  color: var(--text-secondary);
}

.attestation-control-list div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-control-list-title {
  color: var(--text-primary);
  font-size: 0.9rem;
}

.attestation-control-list span {
  color: var(--text-secondary);
  font-size: 0.78rem;
}

.attestation-irrelevant-block {
  margin-top: 0.85rem;
}

.attestation-irrelevant-label {
  display: block;
  margin-bottom: 0.4rem;
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 400;
}

.attestation-irrelevant-block .attestation-control-list.compact {
  margin-top: 0.4rem;
}

.attestation-confirm-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-validation-error {
  align-items: flex-start;
}

.attestation-validation-title {
  display: block;
  margin-bottom: 0.35rem;
}

.attestation-validation-error ul {
  padding-left: 1rem;
  margin: 0;
}

.attestation-confirm-card {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  padding: 1.4rem 1.5rem;
  border-radius: 16px;
  background: linear-gradient(180deg, var(--surface-selected) 0%, rgba(37, 99, 235, 0.04) 100%);
  border: 1px solid rgba(96, 165, 250, 0.32);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
}

.attestation-confirm-card-header {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}

.attestation-confirm-card-icon {
  flex-shrink: 0;
  margin-top: 0.15rem;
  color: #60a5fa;
}

.attestation-confirm-card-heading {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 0;
}

.attestation-confirm-card-title {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.attestation-confirm-card-subtitle {
  margin: 0;
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.45;
}

.attestation-confirm-required {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.75rem 0.95rem;
  border-radius: 10px;
  background: rgba(234, 179, 8, 0.10);
  border: 1px solid rgba(234, 179, 8, 0.32);
  color: #fde68a;
  font-size: 0.88rem;
  line-height: 1.4;
}

.attestation-confirm-required svg {
  flex-shrink: 0;
  color: #fbbf24;
}

.attestation-confirm-step {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(96, 165, 250, 0.18);
  border: 1px solid rgba(96, 165, 250, 0.35);
  color: #bfdbfe;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.attestation-confirm-row {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  padding: 0.9rem 1rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.10);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.attestation-confirm-row:hover {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(96, 165, 250, 0.30);
}

.attestation-confirm-row.confirmed {
  background: rgba(34, 197, 94, 0.10);
  border-color: rgba(34, 197, 94, 0.32);
}

.attestation-confirm-row.confirmed .attestation-confirm-step {
  background: rgba(34, 197, 94, 0.20);
  border-color: rgba(34, 197, 94, 0.45);
  color: #bbf7d0;
}

.attestation-confirm-body {
  flex: 1 1 auto;
  min-width: 0;
}

.attestation-submit-row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.attestation-submit-row .attestation-confirm-step {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.14);
  color: var(--text-secondary);
}

.attestation-submit-row .attestation-confirm-step.unlocked {
  background: rgba(37, 99, 235, 0.22);
  border-color: rgba(96, 165, 250, 0.45);
  color: #dbeafe;
}

.attestation-submit-button {
  width: 100%;
  min-height: 48px;
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  border-radius: 12px;
  flex: 1 1 auto;
  justify-content: center;
}

.attestation-submit-button-locked {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  border: 1px dashed rgba(255, 255, 255, 0.16);
  box-shadow: none;
  cursor: not-allowed;
}

.attestation-submit-button-locked:hover {
  background: rgba(255, 255, 255, 0.05);
  transform: none;
  box-shadow: none;
}

.attestation-submitted-badge {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.9rem 1.1rem;
  border-radius: 12px;
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.32);
  color: #86efac;
}

.attestation-submitted-badge > div {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-submitted-badge-title {
  font-size: 0.95rem;
  font-weight: 500;
  color: #bbf7d0;
}

.attestation-submitted-badge-subtitle {
  font-size: 0.8rem;
  color: rgba(134, 239, 172, 0.85);
  line-height: 1.4;
}

@media (max-width: 640px) {
  .attestation-summary-grid {
    grid-template-columns: 1fr;
  }

  .attestation-timesheet-heading {
    flex-direction: column;
  }

  .attestation-timesheet-totals {
    justify-content: flex-start;
  }

  .attestation-timesheet-list li {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .attestation-timesheet-badge {
    grid-column: 1 / -1;
    width: fit-content;
  }

  .worksheet-list {
    max-height: 320px;
  }

  .worksheet-list-item {
    padding: 0.3rem 0.5rem;
  }

  .worksheet-list-item-row {
    flex-wrap: nowrap;
    gap: 0.45rem;
    min-height: 32px;
  }

  .worksheet-list-item-info {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.3rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .worksheet-list-item-date {
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .worksheet-list-item-meta {
    font-size: 0.72rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .worksheet-list-item-metrics {
    flex: 0 0 auto;
    gap: 0.35rem;
  }

  .worksheet-list-item-hours {
    min-width: 3.4rem;
    padding: 0.12rem 0.45rem;
    gap: 0.15rem;
  }

  .worksheet-list-item-hours-value {
    font-size: 0.85rem;
  }

  .worksheet-list-item-hours span:not(.worksheet-list-item-hours-value),
  .worksheet-list-item-outlay {
    font-size: 0.62rem;
  }

  .worksheet-list-item-outlay {
    padding: 0.1rem 0.4rem;
  }

  .worksheet-list-item-actions .btn-icon {
    min-width: 32px;
    min-height: 32px;
  }

  .worksheet-total-card {
    padding: 0.8rem;
  }

  .attestation-submit-button {
    width: 100%;
  }
}

/* ------------------------------------------------------------
   Submission confirmation
   ------------------------------------------------------------ */
.submitted-confirmation {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 3rem 1.5rem;
  text-align: center;
}

.submitted-confirmation-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--surface-selected-strong);
  color: #60a5fa;
  margin-bottom: 0.5rem;
}

.submitted-confirmation-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.submitted-confirmation-body {
  margin: 0;
  max-width: 36rem;
  color: var(--text-secondary);
  font-size: 1rem;
  line-height: 1.5;
}

.submitted-confirmation-button {
  margin-top: 0.75rem;
  min-width: 12rem;
}

.job-details-header-spacer {
  height: 0;
}

@media (max-width: 640px) {
  .app-header-user {
    display: none;
  }

  .app-header-logout span {
    display: none;
  }

  .app-header-logout {
    padding: 0.5rem;
  }
}
