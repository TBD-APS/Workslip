                <div className="job-card-body">
                  <span className="meta-item customer-job-count">
                     {customer.jobCount} {customer.jobCount === 1 ? 'sag' : 'sager'}
                  </span>
                  {customer.address && (
                    <span className="meta-item">
                      <MapPin size={14} />
                      <span>{customer.address}</span>
                    </span>
