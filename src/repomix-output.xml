  gap: 0.25rem;
  color: var(--text);
  font-size: var(--fs-xs);
  font-weight: 400;
  flex: 1;
  transition: color 0.2s;
}

.nav-item.active {
  color: var(--primary);
}

/* Floating Action Button - Create */
.fab-create {
  position: fixed;
  bottom: calc(var(--bottom-nav-height) + 1.5rem);
  right: 1.5rem;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(44, 84, 172, 0.4);
  z-index: 90;
  transition: transform 0.15s, box-shadow 0.15s;
  cursor: pointer;
}

.fab-create:hover {
  box-shadow: 0 4px 20px rgba(44, 84, 172, 0.6);
}

.fab-create:active {
  transform: scale(0.92);
}

@media (max-width: 480px) {
  .fab-create {
    right: 1rem;
  }
}

/* Job List Components */
.page-container {
  max-width: 600px;
  margin: 0 auto;
  position: relative;
}

.job-detail-page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}


.page-header {
  margin-bottom: 2rem;
}

.page-header h2 {
  font-size: 1.35rem;
  font-weight: 600;
  margin: 0 0 0.2rem;
  letter-spacing: -0.01em;
}

.subtitle {
  color: var(--text-muted);
  font-size: var(--fs-body);
}

/* Top Customers Section */
.top-customers-section {
  margin-bottom: 1.5rem;
}

.top-customers-header {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-bottom: 0.65rem;
}

.top-customers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 0.5rem;
}

.top-customer-card {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.85rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
  text-align: left;
  min-width: 0;
}

@media (hover: hover) {
  .top-customer-card:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
  }
}

.top-customer-card:active {
  transform: scale(0.98);
}

.top-customer-icon {
  color: var(--text-muted);
  flex-shrink: 0;
}

.top-customer-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-customer-contact {
  font-size: var(--fs-xs);
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-left: auto;
}

.text-dim {
  color: var(--text-dim);
}

/* Job list gap */
.job-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.status-filter-scroll {
  position: relative;
  margin-bottom: 1rem;
}

.status-filter-scroll::before,
.status-filter-scroll::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2.5rem;
  z-index: 1;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.status-filter-scroll::before {
  left: 0;
  background: linear-gradient(to right, var(--bg) 10%, transparent);
}

.status-filter-scroll::after {
  right: 0;
  background: linear-gradient(to left, var(--bg) 10%, transparent);
}

.status-filter-scroll[data-scroll-left="true"]::before,
.status-filter-scroll[data-scroll-right="true"]::after {
  opacity: 1;
}

.status-filter {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  gap: 0.5rem;
  scrollbar-width: none;
}

.status-filter::-webkit-scrollbar {
  display: none;
}

@media (min-width: 768px) {
  .status-filter-scroll::before,
  .status-filter-scroll::after {
    display: none;
  }

  .status-filter {
    flex-wrap: wrap;
    overflow-x: visible;
    scrollbar-width: auto;
  }
  .status-filter::-webkit-scrollbar {
    display: block;
  }
}

.status-filter-btn {
  padding: 0.4rem 0.85rem;
  font: inherit;
  font-size: var(--fs-sm);
  color: var(--overlay-light-050);
  background: var(--border);
  border: 2px solid var(--border);
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s, color 0.16s;
  white-space: nowrap;
}


.status-filter-btn.selected {
  border-color: var(--focus-ring);
  background: var(--text);
  color: var(--bg);
}

/* ------------------------------------------------------------
   Card
   ------------------------------------------------------------ */
.job-card {
  background: var(--surface);
  border: none;
  border-radius: var(--radius-lg);
  padding: 1.1rem 1.25rem;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  cursor: pointer;
  color: inherit;
  font: inherit;
  text-align: left;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}

.job-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: transparent;
  transition: background 0.2s;
}


@media (hover: hover) {
.job-card:hover {
  background: var(--surface-raised);
}
}

.job-card:active {
  transform: scale(0.995);
}


.report-overview-page {
  padding-bottom: 1rem;
}

.report-overview-header {
  align-items: center;
}

.report-overview-header > div {
  min-width: 0;
}


.report-overview-actions--left {
  margin-left: 0;
}

.report-overview-actions--right {
  margin-left: auto;
}

.report-overview-toolbar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: var(--section-gap);
}


.report-overview-actions {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
  min-height: 2.5rem;
}

.report-overview-icon-action {
  width: 2.5rem;
  min-width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border-radius: var(--radius-sm);
}

.report-overview-icon-action:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}


.report-overview-hero {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.report-overview-hero .section-header-row {
  margin-bottom: 0;
}

.report-overview-data-list {
  margin-top: var(--section-content-margin);
}

.report-overview-block-gap {
  margin-top: var(--section-content-margin);
}

.report-overview-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.report-overview-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text);
  width: fit-content;
}

.report-overview-link-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.linked-job-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  min-width: 0;
  width: 100%;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

@media (hover: hover) {
  .linked-job-row:hover .linked-job-link {
    text-decoration: underline;
  }
}

.linked-job-row:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.linked-job-link {
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.linked-job-customer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
  min-width: 0;
}

.linked-jobs-variant .multi-select-chip-description {
  color: var(--text);
  font-size: var(--fs-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.assignment-variant .multi-select-chip {
  background: none;
  border: none;
  padding: 0;
  font-size: var(--fs-body);
  font-weight: 400;
}

.linked-jobs-variant .multi-select-option-text {
  flex-direction: row;
  align-items: baseline;
  gap: 0.5rem;
}

.linked-jobs-variant .multi-select-option-text span:first-child {
  color: var(--text);
  font-size: var(--fs-sm);
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.linked-jobs-variant .multi-select-option-text small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
  min-width: 0;
}

.linked-jobs-variant .multi-select-chip {
  background: none;
  border: none;
  padding: 0;
  gap: 0.5rem;
  max-width: 100%;
  overflow: hidden;
}

.linked-jobs-variant .multi-select-chip span:first-child {
  color: var(--text);
  font-weight: 500;
  font-size: var(--fs-sm);
  white-space: nowrap;
}

.linked-jobs-variant .multi-select-chip-description {
  color: var(--text);
  font-size: var(--fs-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}



.report-overview-link-card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  width: 100%;
  padding: 0.85rem 1rem;
  border: none;
  border-radius: var(--radius);
  background: var(--surface-raised);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

@media (hover: hover) {
.report-overview-link-card:hover {
  background: var(--surface-elevated);
}
}

.report-overview-link-card .report-overview-top-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  min-width: 0;
}

.report-overview-link-card .job-number {
  flex-shrink: 0;
}

.report-overview-link-card .report-overview-customer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
}

.report-overview-link-card .report-overview-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.report-overview-link-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.report-overview-timesheet-list {
  margin-bottom: 0.75rem;
}

@media (max-width: 640px) {
  .report-overview-toolbar {
    width: 100%;
  }

  .report-overview-actions {
    width: auto;
    margin-left: 0;
  }

  .report-overview-actions--left {
    margin-left: auto;
  }

  .attestation-control-list.compact {
    grid-template-columns: 1fr;
  }
}


.spin {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ------------------------------------------------------------
   Card top: SAG-id + customer name (left), status pill (right)
   ------------------------------------------------------------ */
.job-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  min-width: 0;
}

.job-card-top > * {
  min-width: 0;
}

.job-card-top-center {
  align-items: center;
  gap: 0.5rem;
}

.job-card-top .customer-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-top .customer-icon {
  flex-shrink: 0;
}

.job-card-top .customer-job-count {
  flex-shrink: 0;
}

.job-number {
  display: inline-block;
  font-family: var(--font-main);
  font-size: var(--fs-xs);
  font-weight: 400;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 0.3rem;
  white-space: nowrap;
}

.job-number-sep {
  margin: 0 0.35rem;
  opacity: 0.5;
}

.job-number-status {
  font-weight: 500;
}

.review-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #eab308;
  margin-left: 6px;
  vertical-align: middle;
  position: relative;
  top: -1px;
}

.unread-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ef4444;
  margin-left: 6px;
  vertical-align: middle;
  position: relative;
  top: -1px;
}

.job-customer {
  font-family: var(--font-heading);
  font-size: var(--fs-lg);
  font-weight: 400;
  margin: 0;
  line-height: 1.25;
  color: var(--text);
}

/* ------------------------------------------------------------
   Address row
   ------------------------------------------------------------ */
.job-address-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.job-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ------------------------------------------------------------
   Meta row: date, urgency badges, hours
   ------------------------------------------------------------ */
.job-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 0.75rem;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.meta-hours {
  color: var(--text-muted);
  font-weight: 400;
}

.user-hours-row {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: var(--fs-xs);
  color: var(--text-muted);
  padding: 0.25rem 0 0;
}

.user-hours-sep {
  opacity: 0.4;
}


/* ------------------------------------------------------------
   Card header: status badge + job ID
   ------------------------------------------------------------ */
.job-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ------------------------------------------------------------
   Status badges
   ------------------------------------------------------------ */
.status-badge {
  padding: 0.2rem 0.65rem;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: 400;
  letter-spacing: 0.3px;
  white-space: nowrap;
  flex-shrink: 0;
}

.job-card-badges {
  display: flex;
  gap: 0.4rem;
  align-items: center;
  flex-shrink: 0;
}

.job-type-badge {
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-pill);
  font-size: var(--fs-2xs);
  font-weight: 500;
  letter-spacing: 0.3px;
  white-space: nowrap;
  flex-shrink: 0;
}

.job-type-v4v05 {
  background: color-mix(in srgb, var(--color-primary) 15%, transparent);
  color: var(--color-primary);
}

.job-type-diverse {
  background: color-mix(in srgb, var(--color-info, #6366f1) 15%, transparent);
  color: var(--color-info, #6366f1);
}


/* ------------------------------------------------------------
   Customer name
   ------------------------------------------------------------ */
.job-customer {
  font-size: var(--fs-lg);
  font-weight: 400;
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* (legacy detail-row classes removed â€” meta badges now use job-card-meta) */

/* ------------------------------------------------------------
   Card footer: assigned users + chevron
   ------------------------------------------------------------ */
.job-card-body {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}

.job-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.25rem;
  padding-top: 0.25rem;
  border-top: 1px solid var(--border);
}

.job-assigned {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.assigned-user {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text);
}

.assigned-user + .assigned-user::before {
  content: ", ";
}

.unassigned {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text-dim);
  font-style: italic;
}

/* Mobile job card - comma-separated list */
.job-card .cell-comma-list {
  font-size: var(--fs-xs);
}

.job-card .cell-comma-list-item {
  display: inline;
  white-space: nowrap;
}

.job-card .cell-comma-list-item + .cell-comma-list-item::before {
  content: ", ";
}

.job-card-footer .cell-comma-list {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.job-card-meta .meta-item:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.btn-icon {
  background: none;
  border: none;
  color: var(--text);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: var(--radius-pill);
  transition: all 0.15s;
}

.btn-icon:active {
  background: var(--surface-selected-strong);
  transform: scale(0.92);
  transition: transform 0.08s ease, background 0.08s ease;
}

@media (hover: hover) {
.btn-icon:hover {
  background: var(--surface-raised);
  color: var(--text);
}
}

/* ------------------------------------------------------------
   Skeleton loading
   ------------------------------------------------------------ */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 25%, rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

.skeleton-title {
  width: 140px;
  height: 28px;
  margin-bottom: 8px;
}

.skeleton-subtitle {
  width: 100px;
  height: 16px;
}

.skeleton-badge {
  width: 60px;
  height: 20px;
  border-radius: var(--radius-pill);
}

.skeleton-id {
  width: 70px;
  height: 14px;
}

.skeleton-name {
  width: 180px;
  height: 18px;
}

.skeleton-address {
  width: 100%;
  height: 14px;
}

.skeleton-tag {
  width: 80px;
  height: 18px;
}

.skeleton-w-60 {
  width: 60% !important;
}
.skeleton-w-40 {
  width: 40% !important;
}
.skeleton-w-30 {
  width: 30% !important;
}

.skeleton-chevron {
  width: 20px;
  height: 20px;
  border-radius: var(--radius-pill);
}

.job-card-skeleton {
  cursor: default;
  pointer-events: none;
}

@media (hover: hover) {
.job-card-skeleton:hover {
  background: var(--surface);
}
}

/* ------------------------------------------------------------
   Empty & error states
   ------------------------------------------------------------ */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-muted);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  text-align: center;
  padding: 4rem 2rem;
  color: var(--danger);
}

.error-state p {
  color: var(--text-muted);
  font-size: var(--fs-body);
  max-width: 280px;
}

.error-state-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  align-items: center;
}

/* ------------------------------------------------------------
   Job Detail Page
   ------------------------------------------------------------ */
.detail-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: var(--section-gap);
}

.detail-header .btn-icon {
  flex-shrink: 0;
}

.detail-header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-icon-danger {
  color: var(--status-red-text);
  transition: color 0.15s, background 0.15s;
}

@media (hover: hover) {
.btn-icon-danger:hover {
  color: var(--danger);
  background: var(--status-red-bg);
}
}

.detail-title {
  font-size: var(--fs-lg);
  margin: 0;
}

.detail-subtitle {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin: 0.15rem 0 0;
}

.create-type-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.create-type-item {
  display: block;
}

.create-type-tile {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1rem 1.1rem;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  text-align: left;
  cursor: pointer;
  font: inherit;
  transition: background 0.15s, border-color 0.15s, transform 0.05s;
}

.create-type-tile:hover:not(.create-type-tile--disabled) {
  background: var(--surface-elevated, var(--surface-raised));
  border-color: var(--primary);
}

.create-type-tile:active:not(.create-type-tile--disabled) {
  transform: scale(0.99);
}

.create-type-tile--disabled {
  cursor: not-allowed;
