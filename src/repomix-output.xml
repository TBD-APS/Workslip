                  "const json = pm.response.json();",
                  "pm.test('response has installationTypes, workKinds, closureFlags', function () {",
                  "  pm.expect(json).to.have.property('installationTypes').that.is.an('array');",
                  "  pm.expect(json).to.have.property('workKinds').that.is.an('array');",
                  "  pm.expect(json).to.have.property('closureFlags').that.is.an('array');",
                  "});",
