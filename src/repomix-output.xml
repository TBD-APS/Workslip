              "raw": "{\n  \"customerId\": null,\n  \"customerSnapshot\": {\n    \"name\": \"Demo Kunde\",\n    \"address\": \"Demo Vej 1, 1000 København\",\n    \"email\": \"{{customerEmail}}\",\n    \"contactPerson\": \"Kunde Kontakt\",\n    \"phone\": \"+459****9999\"\n  },\n  \"reportNumber\": \"{{reportNumber}}\",\n  \"work\": {\n    \"installationTypes\": [\n      {\n        \"id\": \"{{vandInstallationId}}\",\n        \"categories\": [\n          {\n            \"id\": \"{{vandCategoryId}}\",\n            \"controlPoints\": [\n              { \"id\": \"{{vandControlPointId}}\" }\n            ]\n          }\n        ]\n      }\n    ],\n    \"workKind\": \"NewInstallation\",\n    \"closureFlags\": [\n      \"Completed\"\n    ]\n  },\n  \"observations\": {\n    \"reportDate\": \"2026-10-01\",\n    \"taskDescription\": \"Installer og kontroller anlæg.\",\n    \"customerObservations\": \"Kunde ønsker hurtig afslutning.\",\n    \"technicalObservations\": \"Teknisk observation fra tekniker.\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('vandInstallationId', '00000000-0000-0000-0000-000000000000');",
                  "pm.variables.set('vandCategoryId', '00000000-0000-0000-0000-000000000000');",
                  "pm.variables.set('vandControlPointId', '00000000-0000-0000-0000-000000000000');",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/reference-data',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + pm.variables.get('authToken') }",
                  "}, function (err, res) {",
                  "  if (err || res.code !== 200) {",
                  "    console.log('Could not fetch reference data for job installation IDs. Error: ' + (err || res.code));",
                  "    return;",
                  "  }",
                  "  try {",
                  "    var json = res.json().installationTypes;",
                  "    var vand = json.find(function(d) { return d.name.toLowerCase() === 'vandinstallation'; });",
                  "    if (vand && vand.categories.length > 0) {",
                  "      pm.variables.set('vandInstallationId', vand.id);",
                  "      pm.variables.set('vandCategoryId', vand.categories[0].id);",
                  "      if (vand.categories[0].controlPoints.length > 0)",
                  "        pm.variables.set('vandControlPointId', vand.categories[0].controlPoints[0].id);",
                  "    }",
                  "  } catch(e) { console.log('Failed to parse reference data: ' + e); }",
                  "});"
                ]
              }
            },
