        type="button"
        onClick={() => setIsExpanded((open) => !open)}
        aria-expanded={isExpanded}
      >
        <ChevronRight size={18} className={`control-point-chevron${isExpanded ? ' open' : ''}`} />
        <span className="control-point-type-name">{name}</span>
      </button>

