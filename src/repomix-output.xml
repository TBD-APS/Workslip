    {
      "name": "Worksheets",
      "item": [
        {
          "name": "/api/worksheets/jobs/{jobId}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/worksheets/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "worksheets",
                "jobs",
                "{{jobId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{assigneeUserId}}\",\n  \"workDate\": \"{{workDate}}\",\n  \"hoursWorked\": 7.5,\n  \"sleptOnJob\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates or updates (upserts) a worksheet entry for a given job, user, and work date."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date();",
                  "const yyyy = today.getFullYear();",
                  "const mm = String(today.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(today.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('workDate', `${yyyy}-${mm}-${dd}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response is a job summary with worksheets array', function () {",
                  "  pm.expect(json).to.have.property('worksheets');",
                  "  pm.expect(json.worksheets).to.be.an('array');",
                  "});",
                  "pm.test('worksheet for today + assignee is present', function () {",
                  "  const today = new Date().toISOString().slice(0, 10);",
                  "  const assignee = pm.collectionVariables.get('assigneeUserId');",
                  "  const ws = json.worksheets.find(w => w.workDate === today && w.userId === assignee);",
                  "  pm.expect(ws, 'worksheet not found in response').to.exist;",
                  "  pm.collectionVariables.set('worksheetId', ws.id);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "/api/worksheets/{worksheetId}/jobs/{jobId}",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/worksheets/{{worksheetId}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "worksheets",
                "{{worksheetId}}",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Deletes a worksheet entry by worksheet ID and job ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response is a job summary with worksheets array', function () {",
                  "  pm.expect(json).to.have.property('worksheets');",
                  "  pm.expect(json.worksheets).to.be.an('array');",
                  "});",
                  "pm.test('deleted worksheet is no longer in summary', function () {",
                  "  const worksheetId = pm.collectionVariables.get('worksheetId');",
                  "  const ws = json.worksheets.find(w => w.id === worksheetId);",
                  "  pm.expect(ws, 'worksheet still present in response').to.not.exist;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "/api/worksheets/all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/worksheets/all?year={{currentYear}}&month={{currentMonth}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "worksheets",
                "all"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "{{currentYear}}"
                },
                {
                  "key": "month",
                  "value": "{{currentMonth}}"
                }
              ]
            },
            "description": "Retrieves all worksheets for the organization for a given month (admin only). Returns worksheets grouped by week with all employee hours."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date();",
                  "pm.collectionVariables.set('currentYear', today.getFullYear());",
                  "pm.collectionVariables.set('currentMonth', today.getMonth() + 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response contains month data with weeks', function () {",
                  "  pm.expect(json).to.have.property('year');",
                  "  pm.expect(json).to.have.property('month');",
                  "  pm.expect(json).to.have.property('totalHours');",
                  "  pm.expect(json).to.have.property('weeks');",
                  "  pm.expect(json.weeks).to.be.an('array');",
                  "});",
                  "pm.test('week entries include user display names', function () {",
                  "  const weeks = json.weeks;",
                  "  if (weeks.length > 0 && weeks[0].days.length > 0) {",
                  "    const entries = weeks[0].days[0].entries;",
                  "    if (entries.length > 0) {",
                  "      pm.expect(entries[0]).to.have.property('userDisplayName');",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = `${Date.now()}${Math.floor(Math.random() * 1000).toString().padStart(3, '0')}`;",
          "  const numericTail = runId.slice(-8);",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('organizationCvr', numericTail.padStart(8, '0'));",
          "  pm.collectionVariables.set('organizationName', `Integration VVS ${runId}`);",
          "  pm.collectionVariables.set('testEmail', `rbj@17v3ygzs.mailosaur.net`);",
          "  pm.collectionVariables.set('assigneeEmail', `assignee+${runId}@17v3ygzs.mailosaur.net`);",
          "  pm.collectionVariables.set('adminDisplayName', `Integration Admin ${runId}`);",
          "  pm.collectionVariables.set('adminPhone', '+4512345678');",
          "  pm.collectionVariables.set('userDisplayName', `Integration User ${runId}`);",
          "  pm.collectionVariables.set('inviteBaseUrl', '{{baseUrl}}/invite');",
          "  pm.collectionVariables.set('userPhone', '+4512345678');",
          "  pm.collectionVariables.set('reportNumber', `WS-IT-${runId}`);",
          "  pm.collectionVariables.set('customerEmail', `integration-customer+${runId}@example.com`);",
          "}"
        ]
      }
    }
  ]
