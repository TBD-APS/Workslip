  flex-direction: column;
  gap: 0.5rem;
  align-items: center;
}

/* ------------------------------------------------------------
   Job Detail Page
   ------------------------------------------------------------ */
.detail-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: var(--section-gap);
}

.detail-header .btn-icon {
  flex-shrink: 0;
}

.detail-header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-icon-danger {
  color: var(--status-red-text);
  transition: color 0.15s, background 0.15s;
}

@media (hover: hover) {
.btn-icon-danger:hover {
  color: var(--danger);
  background: var(--status-red-bg);
}
}

.detail-title {
  font-size: var(--fs-lg);
  margin: 0;
}

.detail-subtitle {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin: 0.15rem 0 0;
}

.create-type-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.create-type-item {
  display: block;
}

.create-type-tile {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1rem 1.1rem;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  text-align: left;
  cursor: pointer;
  font: inherit;
  transition: background 0.15s, border-color 0.15s, transform 0.05s;
}

.create-type-tile:hover:not(.create-type-tile--disabled) {
  background: var(--surface-elevated, var(--surface-raised));
  border-color: var(--primary);
}

.create-type-tile:active:not(.create-type-tile--disabled) {
  transform: scale(0.99);
}

.create-type-tile--disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.create-type-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--primary);
}

.create-type-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.create-type-label {
  font-weight: 600;
  font-size: var(--fs-body);
}

.create-type-description {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 0.15rem;
}

.create-type-chevron {
  font-size: 1.5rem;
  color: var(--text-muted);
  line-height: 1;
}

.create-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0.55rem;
  border-radius: var(--radius-sm);
  background: var(--surface);
  border: 1px solid var(--border);
  font-size: var(--fs-xs);
  color: var(--text-muted);
  white-space: nowrap;
}

.save-status {
  display: flex;
  align-items: center;
}

.save-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: var(--fs-xs);
  font-weight: 400;
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  box-shadow: 0 10px 24px var(--surface-raised);
  backdrop-filter: blur(12px);
}

.save-indicator.saving {
  color: #fff;
  background: var(--primary);
}

.save-indicator.saved {
  color: #fff;
  background: var(--primary);
}

.save-indicator.error {
  color: var(--status-red-text);
  background: var(--status-red-bg);
}

.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 4rem 2rem;
  color: var(--text-muted);
}

.detail-section {
  background: var(--surface);
  border: none;
  border-radius: var(--radius-lg);
  padding: var(--card-padding);
  margin-bottom: var(--section-gap);
}

.detail-section-spacer {
  margin-bottom: 1.5rem;
}

.report-overview-colpair {
  margin-bottom: var(--section-gap);
}

.report-overview-colpair > .detail-section {
  margin-bottom: 0;
}

.section-header-row {
  display: flex;
  align-items: center;
  gap: var(--section-header-gap);
  margin-bottom: var(--section-header-margin);
  color: var(--text);
}

.section-header-row h3 {
  font-size: var(--fs-body);
  margin: 0;
}

.customer-search-slot {
  overflow: hidden;
  transition: max-height 0.2s ease;
}

.customer-search-slot:not(.is-open) {
  max-height: 0;
}

.customer-search-slot.is-open {
  max-height: 200px;
}

.readonly-indicator {
  color: var(--text-muted);
  opacity: 0.5;
  flex-shrink: 0;
}

.required-asterisk {
  color: var(--danger);
  margin-left: 0.2rem;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: var(--section-header-gap);
}

.section-title-row h3 {
  font-size: var(--fs-body);
  
  color: var(--text);
  letter-spacing: 0.03em;
  margin: 0;
}

.collapsible-section {
  padding: 0;
  overflow: hidden;
}

.collapsible-section-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  padding: var(--card-padding);
  color: var(--text);
  font: inherit;
  text-align: left;
  background: var(--surface);
  border: 0;
  cursor: pointer;
}

@media (hover: hover) {
.collapsible-section-trigger:hover {
  background: var(--surface-raised);
}
}

.collapsible-chevron {
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform 0.2s;
}

.collapsible-chevron.open {
  transform: rotate(90deg);
}

.collapsible-section-content {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: var(--card-padding) var(--card-padding) var(--card-padding);
}

.detail-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: var(--overlay-medium);
  backdrop-filter: blur(14px);
}

.modal-card {
  width: min(100%, 420px);
  padding: 1.4rem;
  background: var(--surface-modal);
  border: none;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.modal-card h3 {
  margin: 0 0 0.45rem;
  font-size: var(--fs-lg);
}

.modal-card p {
  margin: 0;
  color: var(--text-muted);
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.modal-actions--double {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
}

.modal-actions--triple {
  grid-template-columns: 1fr 1fr 1fr;
}

.work-category-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.work-field-group {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.work-field-label {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 400;
  letter-spacing: 0.08em;
}

.category-choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.7rem;
}

.choice-card {
  position: relative;
  overflow: hidden;
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.85rem 0.95rem 0.85rem 1rem;
  color: var(--text);
  font: inherit;
  font-weight: 400;
  text-align: left;
  background: var(--surface-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, transform 0.15s;
}

.choice-card:active {
  transform: scale(0.98);
}

.choice-card.selected {
  background: var(--surface-selected);
  border-color: var(--surface-selected);
}

.choice-card.selected::before,
.multi-select-option.selected::before,
.work-kind-option.selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: var(--overlay-light-03);
}

/* Afslutning — invalid steps warning */

.work-kind-list {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.work-kind-option {
  position: relative;
  overflow: hidden;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: var(--fs-body);
}

.work-kind-option:hover {
  background: var(--surface-input);
}

.work-kind-option.selected {
  background: var(--surface-selected);
  border-color: var(--focus-ring);
}

.work-kind-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.form-help-error {
  color: var(--text);
  font-size: var(--fs-xs);
}

.multi-select-field {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.multi-select-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.multi-select-dropdown {
  position: relative;
}

.multi-select-trigger {
  width: 100%;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem;
  color: var(--text);
  font: inherit;
  text-align: left;
  background: var(--surface-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: all 0.2s ease;
}

.multi-select-trigger:hover:not(:disabled),
.multi-select-trigger[aria-expanded="true"] {
  background: rgba(0, 0, 0, 0.3);
  border-color: var(--focus-ring);
}

.multi-select-trigger:disabled {
  cursor: wait;
  opacity: 0.65;
}

.multi-select-trigger-content {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-width: 0;
}

.multi-select-trigger-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.multi-select-chevron {
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform 0.2s;
}

.multi-select-chevron.open {
  transform: rotate(90deg);
}

.multi-select-menu {
  position: absolute;
  z-index: 20;
  top: calc(100% + 0.4rem);
  left: 0;
  right: 0;
  max-height: 500px;
  max-height: min(500px, calc(100vh - 180px));
  overflow-y: auto;
  padding: 0.35rem;
  background: var(--surface-actions-menu);
  border: none;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.multi-select-menu::-webkit-scrollbar {
  width: 5px;
}

.multi-select-menu::-webkit-scrollbar-track {
  background: transparent;
}

.multi-select-menu::-webkit-scrollbar-thumb {
  background: var(--surface-elevated);
  border-radius: var(--radius-sm);
}

@media (hover: hover) {
.multi-select-menu::-webkit-scrollbar-thumb:hover {
  background: var(--focus-ring);
}
}

.multi-select-search {
  padding: 0.15rem;
  margin-bottom: 0.2rem;
  background: var(--surface-actions-menu);
}

.multi-select-search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0.55rem 0.75rem;
  color: var(--text);
  font: inherit;
  font-size: var(--fs-sm);
  background: var(--surface);
  border: none;
  border-radius: var(--radius-sm);
  outline: none;
  transition: border-color 0.15s;
}

.multi-select-search-input::placeholder {
  color: var(--text-muted);
  opacity: 0.6;
}

.multi-select-search-input:focus::placeholder,
.search-input:focus::placeholder {
  opacity: 0;
}

.multi-select-search-input:focus {
  border-color: var(--focus-ring);
}

.multi-select-option {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  color: var(--text);
  font: inherit;
  text-align: left;
  background: var(--surface);
  border: 1px solid transparent;
  border-radius: var(--radius);
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s;
}

@media (hover: hover) {
.multi-select-option:hover {
  border-color: var(--border);
  background: var(--surface);
}
}

.multi-select-option.selected {
  border-color: var(--focus-ring);
  background: var(--surface-selected);
}

.selection-pill {
  flex-shrink: 0;
  margin-left: auto;
  padding: 0.16rem 0.45rem;
  color: var(--text);
  font-size: var(--fs-xs);
  font-weight: 400;
  letter-spacing: 0.03em;
  line-height: 1.2;
  border: 1px solid var(--surface-elevated);
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
}

.multi-select-option-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.multi-select-option-text small {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  white-space: pre-line;
  line-height: 1.3;
}

.multi-select-menu-empty {
  margin: 0;
  padding: 0.85rem;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.single-select-footer {
  border-top: 1px solid var(--border);
  padding: 0.6rem 0.85rem;
}

.single-select-footer-text {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-style: italic;
  opacity: 0.7;
}

.multi-select-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.multi-select-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.22rem 0 0.20rem 0.5rem;
  color: var(--text);
  font: inherit;
  background: var(--surface-selected);
  border: 1px solid var(--surface-elevated);
  border-radius: var(--radius-sm);
  font-size: var(--fs-xs);
  font-weight: 400;
  transition: background 0.2s, border-color 0.2s;
}

.multi-select-chip-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  margin: 0;
  padding: 0;
  color: var(--text-muted);
  background: transparent;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: color 0.15s, background 0.15s;
}

@media (hover: hover) {
.multi-select-chip-remove:hover {
  color: var(--text);
  background: var(--border);
}
}

.multi-select-empty {
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.form-label {
  font-size: var(--fs-xs);
  font-weight: 400;
  color: var(--text-muted);
  letter-spacing: 0.03em;
}

.form-input-invalid {
  border-color: var(--danger);
}

.form-input-invalid:focus {
  border-color: var(--danger);
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
}

.form-error-text {
  margin: 0.1rem 0 0;
  color: var(--status-red-text);
  font-size: var(--fs-xs);
}

.form-readonly-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: var(--surface-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  min-height: 48px;
  align-items: center;
}

.form-readonly-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.22rem 0.55rem;
  background: var(--surface-selected);
  border: 1px solid var(--surface-elevated);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-size: var(--fs-xs);
  font-weight: 400;
}

.form-readonly-value {
  font-size: var(--fs-xs);
  color: var(--text);
  line-height: 1.5;
}

.form-readonly-empty {
  color: var(--text-dim);
  font-size: var(--fs-sm);
  font-style: italic;
}


.form-textarea {
  resize: vertical;
  min-height: 100px;
  font-family: var(--font-main);
  line-height: 1.5;
}



/* ------------------------------------------------------------
   Step indicators (stepper)
   ------------------------------------------------------------ */
.step-indicators {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.15rem;
  overflow-x: auto;
  padding-bottom: 0.25rem;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

.step-dot {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 46px;
  padding: 0.6rem 0.9rem;
  border-radius: var(--radius-sm);
  border: none;
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  font-size: var(--fs-sm);
  white-space: nowrap;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
}

.step-dot.active {
  color: white;
  background: var(--primary);
  border: none;
}

.step-dot.completed {
  background: var(--surface-selected-strong);
  color: var(--text);
  border: none;
}

.step-dot[aria-disabled="true"] {
  opacity: 0.5;
  cursor: not-allowed;
}


.step-label {
  font-weight: 400;
}

/* ------------------------------------------------------------
   Step navigation (prev / next buttons)
   ------------------------------------------------------------ */
.step-nav {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: var(--surface);
  border: none;
  border-radius: var(--radius-lg);
  backdrop-filter: blur(18px);
}

.step-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.25rem;
  font: inherit;
  font-size: var(--fs-sm);
  font-weight: 400;
  border: 0;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
}

.step-nav-btn:active {
  transform: scale(0.96);
  transition: transform 0.08s ease;
}

.step-nav-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: var(--surface-raised);
  color: var(--text-muted);
  box-shadow: none;
}

@media (hover: hover) {
.step-nav-btn:disabled:hover {
  background: var(--surface-raised);
  transform: none;
}
}

.step-nav-btn-back {
  color: var(--text);
  background: var(--surface-raised);
}

.step-nav-btn-back:active {
  background: var(--surface-selected-strong);
  transform: scale(0.96);
}

@media (hover: hover) {
.step-nav-btn-back:not(:disabled):hover {
  background: var(--surface-selected-strong);
}
}

.step-nav-btn-next {
  margin-left: auto;
  color: white;
  background: var(--primary);
  border: 1px solid var(--border);
}

.step-nav-btn-next svg {
  color: white;
}

.step-nav-btn-next:active {
  background: var(--surface-selected-strong);
  border-color: var(--focus-ring);
  transform: scale(0.96);
}

.step-nav-btn-next--wide {
  flex: 1;
  justify-content: center;
  min-width: 12rem;
}

@media (hover: hover) {
.step-nav-btn-next:not(:disabled):hover {
  background: var(--surface-selected-strong);
  border-color: var(--focus-ring);
}
}

.step-nav-counter {
  font-size: var(--fs-xs);
  color: var(--text-muted);
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

.control-points-list {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.control-point-type + .control-point-type {
  margin-top: 1.25rem;
}

.control-point-type {
  background: var(--surface-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.75rem;
  transition: all 0.2s ease;
}

.control-point-type:focus-within {
  border-color: var(--focus-ring);
  background: rgba(0, 0, 0, 0.3);
}

.control-point-type.collapsed {
  padding-bottom: 0.5rem;
}

.control-point-type-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  padding: 0;
  font: inherit;
  margin-bottom: 0.75rem;
  text-align: left;
}

.control-point-type.collapsed .control-point-type-header {
  margin-bottom: 0;
}

.control-point-chevron {
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform 0.2s ease;
}

.control-point-chevron.open {
  transform: rotate(90deg);
}

.control-point-type-name {
  font-size: var(--fs-body);
  font-weight: 400;
}

.control-point-type-body {
  padding-left: 0;
}

.control-point-category-group + .control-point-category-group {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
}

.control-point-category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.25rem;
}

.control-point-category-label {
  font-size: var(--fs-xs);
  font-weight: 400;
  color: var(--text);
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.control-point-category-group.irrelevant .control-point-category-label {
  color: var(--text-disabled, rgba(255, 255, 255, 0.4));
}

.multi-select-option.control-point-irrelevant-row {
  min-height: 42px;
  padding: 0.6rem 0.8rem 0.6rem 1rem;
  margin-bottom: 0;
  color: var(--text);
}

@media (hover: hover) {
.multi-select-option.control-point-irrelevant-row:hover {
  color: var(--text);
}
}


.irrelevant-label {
  display: none;
}

.multi-select-option:disabled {
  opacity: 0.4;
  cursor: default;
}

@media (hover: hover) {
.multi-select-option:disabled:hover {
  background: var(--surface);
}
}

@media (hover: hover) {
.multi-select-option.selected:disabled:hover {
  background: var(--surface);
}
}

@media (min-width: 768px) {
  .bottom-nav {
    position: static;
    height: auto;
    padding: 0.5rem 1.5rem;
    flex-direction: row;
    justify-content: flex-start;
    gap: 0.5rem;
    border-top: none;
    border-bottom: 1px solid var(--border);
    order: 1;
  }

  .bottom-nav.keyboard-visible {
    display: flex;
  }

  .app-content {
    padding-bottom: 1.5rem;
    order: 2;
  }

  .app-header {
    order: 0;
  }

  .app-shell {
    display: flex;
    flex-direction: column;
  }

  .page-container {
    max-width: none;
  }

  .nav-item {
    flex-direction: row;
    gap: 0.5rem;
    flex: none;
    padding: 0.5rem 0.75rem;
  }

  .nav-item-fab {
    display: none;
  }

  .fab-button {
    display: none;
  }

  .search-input-wrapper {
    max-width: 420px;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 0;
  }

  .pagination-info {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    min-width: 120px;
    text-align: center;
  }

  .pagination-controls .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .data-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-sm);
  }

  .data-table thead th {
    position: sticky;
    top: 0;
    background: var(--bg);
    padding: 0.75rem 1rem;
    text-align: left;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    user-select: none;
    cursor: default;
  }

  .data-table thead th.sortable.sorted {
    color: #fff;
  }

  .data-table .sort-trigger {
    cursor: pointer;
    transition: color 0.15s;
  }

  .data-table .sort-trigger:hover {
    color: var(--text);
  }

  .data-table thead th .sort-icon {
    display: inline-flex;
    margin-left: 0.3rem;
    opacity: 0.4;
    vertical-align: middle;
  }

  .data-table thead th.sortable.sorted .sort-icon {
    opacity: 1;
  }

  .data-table thead th .col-resize-handle {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 14px;
    cursor: col-resize;
    user-select: none;
    z-index: 1;
  }

  .data-table thead th .col-resize-handle::after {
    content: '';
    position: absolute;
    right: 2px;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: var(--border);
    transition: background 0.15s;
  }

  .data-table thead th:hover .col-resize-handle::after {
    background: var(--primary);
  }

  .data-table thead th .col-resize-handle:active::after,
  .data-table thead th .col-resize-handle--active::after {
    background: var(--primary);
    width: 2px;
  }

  .data-table tbody tr {
    transition: background 0.12s;
  }

  .data-table tbody tr.clickable {
    cursor: pointer;
  }

  .data-table tbody tr.clickable:hover {
    background: var(--surface);
  }

  .data-table tbody td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table .col-status {
    width: 110px;
  }

  .data-table .col-hours {
    width: 70px;
    text-align: right;
  }

  .data-table .col-users {
    width: 150px;
  }

  .data-table .col-actions {
    width: 40px;
    text-align: right;
  }

  .data-table .col-name {
    width: 22%;
  }

  .data-table .col-address {
    width: 18%;
  }

  .data-table .col-email {
    width: 20%;
  }

  .data-table .col-contact {
    width: 16%;
  }

  .data-table .col-number {
    width: 100px;
  }

  .data-table .col-installation {
    width: 140px;
  }

  .data-table .col-role {
    width: 150px;
  }

  .data-table .col-date {
    width: 120px;
  }

  .data-table .cell-comma-list {
    font-size: var(--fs-xs);
  }

  .data-table .cell-comma-list-item {
    display: inline;
    white-space: nowrap;
  }

  .data-table .cell-comma-list-item + .cell-comma-list-item::before {
    content: ", ";
  }

  .data-table .status-badge-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  .data-table-loading-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--text);
    z-index: 10;
    animation: dataTableLoadingBar 1.2s ease-in-out infinite;
  }

  @keyframes dataTableLoadingBar {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  .data-table .status-badge-cell.cell-status-0 {
    background: var(--status-blue-bg);
    color: var(--status-blue-text);
  }

  .data-table .status-badge-cell.cell-status-1 {
    background: var(--status-amber-bg);
    color: var(--status-amber-text);
  }

  .data-table .status-badge-cell.cell-status-2 {
    background: var(--status-green-bg);
    color: var(--status-green-text);
  }

  .data-table .status-badge-cell.cell-status-3 {
    background: var(--status-red-bg);
    color: var(--status-red-text);
  }

  .data-table .cell-number {
    font-variant-numeric: tabular-nums;
  }

  .data-table .cell-date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .data-table .row-link-icon {
    opacity: 0;
    transition: opacity 0.12s;
    color: var(--text-muted);
  }

  .data-table tbody tr:hover .row-link-icon {
    opacity: 1;
  }

  .app-content {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Report detail: header + toolbar in one row, content below */
  .report-overview-page {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    max-width: none;
  }

  .report-overview-page > .detail-header {
    flex: 1;
    min-width: 0;
  }

  .report-overview-page > .report-overview-toolbar {
    margin-left: auto;
    margin-bottom: 0;
  }

  .report-overview-page > .report-overview-grid,
  .report-overview-page > .kontrolpunkter-section,
  .report-overview-page > .detail-loading,
  .report-overview-page > .error-state {
    flex: 0 0 100%;
  }

  .report-overview-page > .report-overview-grid {
    margin-top: var(--section-gap);
  }

  .report-overview-page > .kontrolpunkter-section {
    margin-top: var(--section-gap);
  }

  /* 2-column grid for main sections */
  .report-overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem var(--section-gap);
    align-items: start;
    align-content: start;
  }

  .report-overview-grid > .detail-section,
  .report-overview-grid > .collapsible-section {
    margin-bottom: 0;
    background: none;
    border: none;
    border-radius: 0;
    padding: 0 0 var(--section-gap) 0;
    border-bottom: 1px solid var(--border);
  }

  .report-overview-grid > .report-overview-toolbar {
    margin-bottom: 0;
  }

  .report-overview-grid > .report-overview-colpair {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--section-gap);
    margin-bottom: 0;
    padding: 0 0 var(--section-gap) 0;
    border-bottom: 1px solid var(--border);
  }

  .report-overview-grid > .report-overview-colpair > .detail-section {
    margin-bottom: 0;
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    border-bottom: none;
  }

  .report-overview-grid > .detail-section:last-child,
  .report-overview-grid > .collapsible-section:last-child,
  .report-overview-grid > .report-overview-colpair:last-child {
    border-bottom: none;
  }

  /* Kontrolpunkter: full-width section below the grid */
  .report-overview-page > .kontrolpunkter-section {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    margin-top: var(--section-gap);
  }

  .report-overview-page > .kontrolpunkter-section .collapsible-section-trigger {
    cursor: pointer;
    padding: var(--card-padding);
    margin-bottom: var(--section-header-margin);
    border-radius: var(--radius-lg);
  }

  .report-overview-page > .kontrolpunkter-section .collapsible-section-content {
    display: block;
  }

  /* Collapsible sections inside grid: show toggle arrow */
  .report-overview-grid .collapsible-section-trigger {
    cursor: pointer;
    padding: var(--card-padding);
    margin-bottom: var(--section-header-margin);
    border-radius: var(--radius-lg);
  }

  .report-overview-grid .collapsible-section-content {
    display: block;
  }

  /* Section headers: consistent */
  .report-overview-grid .section-header-row,
  .report-overview-grid .attestation-compact-header {
    margin-bottom: var(--section-header-margin);
  }

  .report-overview-grid .report-overview-hero .section-header-row {
    margin-bottom: var(--section-header-margin);
  }

  /* Content spacing: consistent (flat layout, no gap) */
  .report-overview-grid .attestation-data-list,
  .report-overview-grid .report-overview-chip-list,
  .report-overview-grid .report-overview-link-list,
  .report-overview-grid .worksheet-list-section {
    margin-top: 0;
  }

  .report-overview-grid .attestation-observations-list {
    margin: 0;
    padding-top: 0;
    border-top: none;
  }

  /* Section headers: cleaner */
  .report-overview-grid .section-header-row {
    margin-bottom: 0.75rem;
  }
}

/* Validation error */
.validation-error {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  margin-bottom: 1rem;
  background: var(--status-red-bg);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: var(--radius-sm);
  color: var(--status-red-text);
  font-size: var(--fs-body);
}

/* ------------------------------------------------------------
   Worksheet list (Job step 4)
   ------------------------------------------------------------ */

/* ------------------------------------------------------------
   Unified Worksheet List Component
   ------------------------------------------------------------ */
.worksheet-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 1rem;
  margin: 0;
  list-style: none;
}

.worksheet-list-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem 0.65rem 1rem;
  border-radius: var(--radius);
  background: var(--surface);
  border: 1px solid var(--border);
  min-height: 48px;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.worksheet-list-item::before {
  content: '';
  position: absolute;
  top: 10px;
  bottom: 10px;
  left: 0;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: transparent;
}

.worksheet-list-item.is-selected::before {
  background: var(--primary);
}

.worksheet-list-item-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: row;
  align-items: baseline;
  gap: 0.5rem;
}

.worksheet-list-item-title {
  overflow: hidden;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.worksheet-list-item-subtitle {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 400;
  white-space: nowrap;
  flex-shrink: 0;
}

.worksheet-list-item-metrics {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 0.5rem;
  flex-shrink: 0;
  max-width: 100%;
}

.worksheet-list-item-badge {
  display: inline-flex;
  align-items: baseline;
  gap: 0.25rem;
  padding: 0.3rem 0.65rem;
  border-radius: var(--radius-pill);
  color: var(--text);
  font-size: var(--fs-xs);
  white-space: nowrap;
  border: 1px solid var(--border);
}

.worksheet-list-item-tag {
  padding: 0.3rem 0.6rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  font-size: var(--fs-xs);
  font-weight: 500;
  white-space: nowrap;
}

.worksheet-list-item-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.worksheet-list--detail {
  gap: 0.5rem;
}

.worksheet-list-item--detail {
  align-items: center;
  gap: 0.75rem;
}

.worksheet-list-item-main--detail {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  overflow: hidden;
  gap: 0.12rem;
  flex: 1 1 auto;
}

.worksheet-list-item-main--detail .worksheet-list-item-title {
  font-size: var(--fs-sm);
  line-height: 1.2;
}

.worksheet-list-item--detail .worksheet-list-item-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.worksheet-list-item-subtitle--detail {
  font-size: var(--fs-xs);
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 0 0 auto;
}

.worksheet-list-item-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 0.4rem;
  min-width: 0;
  margin-left: auto;
  flex: 0 0 auto;
}

.worksheet-list-item-actions--detail {
  margin-left: 0;
  flex: 0 0 auto;
}

.worksheet-list-item--editing {
  flex-wrap: wrap;
  align-items: flex-start;
}

.worksheet-list-item-edit {
  flex: 1 0 100%;
  width: 100%;
}

.worksheet-list-item--editing .worksheet-form {
  width: 100%;
  margin-top: 0.15rem;
}

.worksheet-actions-menu {
  position: fixed;
  z-index: 2500;
  display: flex;
  flex-direction: column;
  min-width: 10rem;
  padding: 0.35rem;
  background: var(--surface-actions-menu);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(16px);
}

.worksheet-actions-menu button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.55rem 0.7rem;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: var(--fs-sm);
  text-align: left;
  cursor: pointer;
}

.worksheet-actions-menu button:hover {
  background: var(--surface-raised);
}

.worksheet-actions-menu button.danger {
  color: var(--status-red-text);
}

.worksheet-actions-menu button.danger:hover {
  background: var(--status-red-bg);
}

@media (max-width: 640px) {
  .worksheet-list-item {
    gap: 0.5rem;
    padding: 0.5rem 0.65rem 0.5rem 0.85rem;
    flex-wrap: wrap;
  }

  .worksheet-list-item--detail {
    flex-wrap: nowrap;
  }

  .worksheet-list-item-main {
    gap: 0.4rem;
    width: 100%;
  }

  .worksheet-list-item-main--detail {
    gap: 0.12rem;
    width: auto;
  }

  .worksheet-list-item-metrics {
    width: 100%;
    justify-content: flex-end;
  }

  .worksheet-list-item-meta {
    width: auto;
  }

  .worksheet-list-item-badge {
    padding: 0.25rem 0.55rem;
  }

  .worksheet-list-item-edit {
    min-width: 0;
  }
}

.worksheet-form {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  padding: 0.65rem;
  background: var(--surface-overlay);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  position: relative;
}

.worksheet-form--compact {
  box-shadow: none;
}

.worksheet-form h4 {
  margin: 0 0 0.1rem 0;
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.01em;
}

.worksheet-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.4rem;
}

.worksheet-form .form-input,
.worksheet-form .multi-select-trigger {
  min-height: 38px;
}

.worksheet-form .form-label {
  font-size: var(--fs-xs);
  margin-bottom: 0.15rem;
}

.worksheet-form-grid .multi-select-field {
  min-width: 0;
}

.worksheet-form-grid-main .multi-select-chips {
  margin-top: 0.1rem;
}

.worksheet-form-grid-hours {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  margin-top: 0;
}

.worksheet-overnight-wrapper {
  align-self: end;
  min-width: 7rem;
  display: flex;
}

@media (min-width: 640px) {
  .worksheet-form-grid-main {
    grid-template-columns: 0.8fr 1.2fr;
  }
}

/* ------------------------------------------------------------
   Calendar picker
   ------------------------------------------------------------ */
.calendar-picker-field {
  position: relative;
}

.calendar-picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  cursor: pointer;
}

.calendar-picker-popover {
  position: absolute;
  z-index: 25;
  top: calc(100% + 0.4rem);
  left: 0;
  width: min(19rem, calc(100vw - 3rem));
  padding: 0.75rem;
  background: var(--surface-modal);
  border: none;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.calendar-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.65rem;
  color: var(--text);
  font-weight: 400;
  text-transform: capitalize;
}

.calendar-picker-weekdays,
.calendar-picker-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.25rem;
}

.calendar-picker-weekdays {
  margin-bottom: 0.35rem;
  color: var(--text-muted);
  font-size: var(--fs-xs);
  text-align: center;
}

.calendar-picker-day {
  min-height: 2rem;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text);
  cursor: pointer;
}

.calendar-picker-day:hover,
.calendar-picker-day.selected {
  background: var(--primary);
  color: white;
}

.worksheet-overnight-wrapper .multi-select-option {
  min-height: 38px;
  width: 100%;
  padding-top: 0.35rem;
  padding-bottom: 0.35rem;
}

.worksheet-form-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0;
  width: 100%;
}

.worksheet-form-actions .btn {
  white-space: nowrap;
  min-height: 36px;
  padding: 0.35rem 0.8rem;
  font-size: var(--fs-sm);
}

.worksheet-form-actions .btn-primary {
  flex: 2 1 0;
  min-height: 36px;
}

.worksheet-form-actions .btn-secondary {
  flex: 1 1 0;
}

.worksheet-form-actions--compact {
  gap: 0.35rem;
}

.worksheet-add-trigger {
  width: fit-content;
  min-height: 36px;
  padding: 0.4rem 0.9rem;
  font-size: var(--fs-lg);
  font-weight: 500;
}

.worksheet-add-trigger-cta {
  width: 100%;
  min-height: 46px;
  padding: 0.65rem 1rem;
  font-size: var(--fs-body);
  font-weight: 400;
  margin-top: 0.75rem;
  background: var(--surface-selected);
  border-color: var(--border);
  box-shadow: none;
}

@media (hover: hover) {
.worksheet-add-trigger-cta:hover {
  background: var(--surface-selected-strong);
  border-color: var(--focus-ring);
  transform: translateY(-1px);
}
}

/* ------------------------------------------------------------
   Attestation (Job step 5)
   ------------------------------------------------------------ */
.attestation-hero-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-status {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: var(--radius-lg);
  background: var(--status-amber-bg);
  color: var(--warning);
}

.attestation-status.submitted {
  background: var(--status-blue-bg);
  color: var(--status-blue-text);
}

.attestation-status div {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.attestation-status-title {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: var(--fs-body);
}

.attestation-status span:not(.attestation-status-title) {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.attestation-compact-header {
  margin-bottom: var(--section-header-margin);
}

.worksheet-list-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.worksheet-list--scrollable {
  max-height: 400px;
  overflow-y: auto;
  padding-right: 0.25rem;
}

.worksheet-list--scrollable::-webkit-scrollbar {
  width: 4px;
}

.worksheet-list--scrollable::-webkit-scrollbar-track {
  background: transparent;
}

.worksheet-list--scrollable::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: var(--radius-pill);
}

.worksheet-list-totals {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  margin-top: var(--section-content-margin);
  padding-top: var(--section-content-margin);
  border-top: 1px solid var(--border);
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.worksheet-list-totals span {
  display: inline-flex;
  align-items: baseline;
  gap: 0.4rem;
  white-space: nowrap;
}

.worksheet-list-totals strong {
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
}

.attestation-data-list {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.4rem 1.25rem;
  align-items: baseline;
  margin: 0;
}

.attestation-data-pair {
  display: contents;
}

.attestation-data-pair dt {
  color: var(--text-muted);
  font-size: var(--fs-sm);
  font-weight: 400;
}

.attestation-data-pair dd {
  margin: 0;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  word-break: break-word;
}

.attestation-observations-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin: var(--section-content-margin) 0 0;
  padding-top: var(--section-content-margin);
  border-top: 1px solid var(--surface-elevated);
}

.attestation-observations-list .attestation-data-pair {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.25rem 1.25rem;
  align-items: baseline;
}

.attestation-observations-list .attestation-data-pair dd {
  white-space: pre-wrap;
  line-height: 1.5;
}

.attestation-control-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 0;
  margin: 0;
}

.attestation-control-list.compact {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  gap: 0.4rem;
}

/* Control point grid: installation types side by side */
.attestation-control-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  gap: 1.5rem;
  align-items: start;
}

.attestation-installation-block {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.attestation-installation-title {
  font-size: var(--fs-body);
  font-weight: 500;
  margin: 0;
  color: var(--text);
}

/* Categories within installation type, flowing horizontally */
.attestation-category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: start;
}

.attestation-category-block {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  min-width: 12rem;
  flex: 1;
}

.attestation-category-label {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 500;
  letter-spacing: 0.05em;
}

.attestation-category-block--muted {
  opacity: 0.55;
}

.attestation-irrelevant-section {
  margin-top: 1.5rem;
}

.attestation-irrelevant-section-title {
  font-size: var(--fs-body);
  font-weight: 500;
  margin: 0 0 0.75rem;
  color: var(--text-muted);
}

.attestation-control-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem;
  border-radius: var(--radius);
}

.attestation-control-list.compact li {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  padding: 0;
  border-radius: 0;
  color: var(--text);
}

.attestation-control-list.compact .attestation-control-point-name {
  display: inline-flex;
  align-items: baseline;
  gap: 0.3rem;
  font-size: var(--fs-sm);
  color: var(--text);
  white-space: normal;
}

.attestation-control-point-check {
  color: var(--success);
  font-size: var(--fs-xs);
}

.attestation-control-list.compact span,
.attestation-control-list.compact small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attestation-control-list.compact span {
  color: var(--text);
  font-size: var(--fs-sm);
  overflow: visible;
  white-space: normal;
  text-overflow: clip;
}

.attestation-control-list.compact small {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.attestation-control-list div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-control-list span {
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.attestation-irrelevant-block {
  margin-top: var(--section-content-margin);
  padding-top: var(--section-content-margin);
  border-top: 1px solid var(--border);
}

.attestation-irrelevant-label {
  display: block;
  margin-bottom: 0.4rem;
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 500;
  letter-spacing: 0.05em;
}

.attestation-irrelevant-block .attestation-control-list.compact {
  margin-top: 0;
}

.attestation-confirm-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-validation-error {
  align-items: flex-start;
}

.attestation-validation-title {
  display: block;
  margin-bottom: 0.35rem;
}

.attestation-validation-error ul {
  padding-left: 1rem;
  margin: 0;
}

.attestation-confirm-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.9rem 1rem;
  color: var(--text);
  background: var(--surface);
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

@media (hover: hover) {
.attestation-confirm-row:hover {
  background: var(--overlay-light-0055);
  border-color: var(--border);
}
}

.attestation-confirm-row.confirmed {
  background: var(--surface);
  border-color: var(--border);
}

.attestation-confirm-row.disabled {
  cursor: default;
  opacity: 0.65;
}

@media (hover: hover) {
.attestation-confirm-row.disabled:hover {
  background: var(--surface);
  border-color: var(--surface-selected-strong);
}
}

@media (hover: hover) {
.attestation-confirm-row.confirmed.disabled:hover {
  background: var(--surface);
  border-color: var(--border);
}
}

.attestation-confirm-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-confirm-label {
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.35;
}

.attestation-confirm-description {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  line-height: 1.4;
}

.attestation-confirm-row input {
  position: relative;
  flex: 0 0 auto;
  width: 1.25rem;
  height: 1.25rem;
  margin: 0.05rem 0 0;
  appearance: none;
  -webkit-appearance: none;
  background: var(--overlay-dark-095);
  border: 1px solid var(--text-muted);
  border-radius: var(--radius-sm);
  box-shadow: inset 0 1px 0 var(--surface-selected);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.attestation-confirm-row input:checked {
  background: var(--surface-selected);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--surface-elevated);
}

.attestation-confirm-row input:checked::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 46%;
  width: 0.32rem;
  height: 0.62rem;
  border: solid var(--text);
  border-width: 0 2px 2px 0;
  transform: translate(-50%, -50%) rotate(45deg);
  transform-origin: center;
}

.attestation-confirm-row input:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

.attestation-confirm-row input:disabled {
  cursor: default;
}

.attestation-submit-row {
  display: flex;
}

.attestation-submit-button {
  width: 100%;
  min-height: 48px;
  padding: 0.75rem 1.5rem;
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: 0.01em;
  border-radius: var(--radius);
  flex: 1 1 auto;
  justify-content: center;
}

.attestation-submit-button-locked {
  background: var(--surface);
  color: var(--text-muted);
  border: 1px dashed var(--border);
  box-shadow: none;
  cursor: not-allowed;
}

@media (hover: hover) {
.attestation-submit-button-locked:hover {
  background: var(--surface);
  transform: none;
  box-shadow: none;
}
}

.attestation-submitted-badge {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.9rem 1.1rem;
  border-radius: var(--radius);
  background: var(--status-green-bg);
  border: 1px solid rgba(34, 197, 94, 0.32);
  color: var(--status-green-text);
}

.attestation-submitted-badge > div {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-submitted-badge-title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--status-green-text);
}

.attestation-submitted-badge-subtitle {
  font-size: var(--fs-xs);
  color: var(--status-green-text);
  line-height: 1.4;
}

@media (max-width: 640px) {
  .worksheet-list--scrollable {
    max-height: 320px;
  }

  .attestation-submit-button {
    width: 100%;
  }
}

/* ------------------------------------------------------------
   Submission confirmation
   ------------------------------------------------------------ */
.submission-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 5rem 1.5rem;
  text-align: center;
  min-height: 50vh;
}

.submission-overlay-spinner {
  color: var(--primary);
  animation: spin 0.8s linear infinite;
}

.submission-overlay-title {
  margin: 0;
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--text);
}

.submission-overlay-body {
  margin: 0;
  color: var(--text-muted);
  font-size: var(--fs-body);
}

@keyframes pop-in {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes ring-draw {
  0% { stroke-dashoffset: 226; }
  100% { stroke-dashoffset: 0; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.submitted-confirmation {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 3rem 1.5rem;
  text-align: center;
}

.submitted-confirmation-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: white;
  margin-bottom: 0.5rem;
  animation: pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.submitted-confirmation-title {
  margin: 0;
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
}

.submitted-confirmation-body {
  margin: 0;
  max-width: 36rem;
  color: var(--text-muted);
  font-size: var(--fs-body);
  line-height: 1.5;
}

.submitted-confirmation-date {
  margin: 0;
  color: var(--text-dim);
  font-size: var(--fs-xs);
}

.submitted-confirmation-button {
  margin-top: 0.75rem;
  min-width: 12rem;
}

.job-details-header-spacer {
  height: 0;
}

.btn-icon-back {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border-radius: var(--radius-pill);
  transition: all 0.2s;
  margin-right: 0.25rem;
}

@media (hover: hover) {
.btn-icon-back:hover {
  background: var(--surface-raised);
  color: var(--text);
}
}

.section-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--text);
  margin: 1.5rem 0 0.75rem;
  letter-spacing: -0.01em;
}

.user-detail-info {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1rem 1.25rem;
  background: var(--surface);
  border-radius: var(--radius);
  margin-bottom: 0.5rem;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--text);
  font-size: var(--fs-body);
}

.detail-row svg {
  flex-shrink: 0;
  color: var(--text-muted);
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 1rem;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0.65rem 0.75rem 0.65rem 2.2rem;
  color: var(--text);
  font: inherit;
  font-size: var(--fs-body);
  background: var(--surface);
  border: 1px solid var(--surface-selected-strong);
  border-radius: var(--radius-sm);
  outline: none;
  transition: border-color 0.15s;
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-input:focus {
  border-color: var(--focus-ring);
}

.search-input-icon {
  position: absolute;
  left: 0.7rem;
  color: var(--text-muted);
  pointer-events: none;
}

.search-input-clear {
  position: absolute;
  right: 0.4rem;
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: var(--radius-pill);
  transition: color 0.15s, background 0.15s;
}

@media (hover: hover) {
.search-input-clear:hover {
  color: var(--text);
  background: var(--surface-raised);
}
}

.job-sort-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.job-sort-secondary {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.sort-label {
  font-size: 0.875rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.sort-btn {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.3rem 0.75rem;
  font-size: 0.8125rem;
  color: var(--text);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}

.sort-btn:hover {
  background: var(--surface-raised);
  border-color: var(--border-strong);
  color: var(--text);
}

.sort-btn.active {
  border-color: var(--primary);
  color: var(--text);
  font-weight: 500;
}

.search-input-icon {
  position: absolute;
  left: 0.65rem;
  color: var(--text-muted);
  pointer-events: none;
}

.job-card--disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.meta-item--success {
  color: var(--status-green-text);
}

.meta-item--muted {
  color: var(--text-muted);
}


@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

@media (max-width: 640px) {
  .app-header-user {
    display: none;
  }

  .app-header-logout span {
    display: none;
  }

  .app-header-logout {
    padding: 0.5rem;
  }
}

.edit-form-bottom-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 2rem;
}

.edit-form-bottom-btn {
  flex: 1;
  gap: 0.5rem;
}

.edit-form-bottom-actions .btn-primary {
  flex: 1.5;
}

.edit-form-save-btn {
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
}

.invite-send-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  margin-top: 1rem;
}

.invite-send-btn:disabled {
  opacity: 0.35;
  background: var(--text-dim);
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
}

/* Settings / Invite UI */
.section-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--card-padding);
}

.section-card-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: var(--fs-body);
  font-weight: 500;
  margin: 0 0 1rem;
  color: var(--text);
}

.invite-input-row {
  display: flex;
  gap: 0.5rem;
}

.invite-add-btn {
  flex-shrink: 0;
  padding: 0.75rem 1rem;
}

.invite-email-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-top: 0.75rem;
}

.invite-email-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0.75rem;
  background: var(--surface-raised);
  border-radius: var(--radius-sm);
  font-size: var(--fs-body);
}

.invite-status-list {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.invite-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.65rem 0.75rem;
  background: var(--surface-raised);
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
}

.invite-status-left {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-width: 0;
}

.invite-status-email {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
}

.invite-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  white-space: nowrap;
  flex-shrink: 0;
}

.invite-status-date {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  flex-shrink: 0;
  margin-left: 0.5rem;
}

/* ------------------------------------------------------------
   My worksheets monthly overview
   ------------------------------------------------------------ */
.time-overview-page {
  max-width: 1100px;
}

.time-overview-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.time-month-controls {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
}

.time-month-switcher {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.35rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text);
  text-transform: capitalize;
  white-space: nowrap;
}

.time-month-switcher span {
  min-width: 9rem;
  text-align: center;
  font-size: var(--fs-body);
}

.time-month-button {
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-pill);
}

.time-today-button {
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  color: var(--text-muted);
  font: inherit;
  font-size: var(--fs-xs);
  cursor: pointer;
}

.time-today-button:not(:disabled) {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.time-today-button:disabled {
  opacity: 0.45;
  cursor: default;
}

.time-summary-grid {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.35rem;
  width: 100%;
}

.time-summary-card {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.22rem 0.55rem;
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  border: 1px solid var(--border);
}

.time-summary-card > div {
  display: inline-flex;
  align-items: center;
  gap: 0.28rem;
}

.time-summary-card span {
  display: inline-flex;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-summary-card strong {
  display: inline-flex;
  color: var(--text);
  font-size: var(--fs-xs);
  font-weight: 400;
}

.time-summary-icon {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: 1.1rem;
  height: 1.1rem;
  border-radius: var(--radius-pill);
  color: var(--text-muted) !important;
  background: transparent;
}

.time-overview-page .empty-state {
  padding: 1rem 1rem;
}

.time-week-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.time-week-card {
  padding: 1rem;
  border-radius: var(--radius-lg);
  background: var(--surface);
  border: 1px solid var(--border);
}

.time-week-card:not(.is-expanded) .time-week-header {
  margin-bottom: 0;
}

.time-week-skeleton {
  min-height: 220px;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 25%, rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.time-week-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.85rem;
}

.time-week-header h3 {
  margin: 0;
  color: var(--text);
  font-size: var(--fs-body);
}

.time-week-totals {
  display: inline-flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-week-totals span {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.55rem;
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text-muted);
}

.time-week-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.6rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  color: var(--text);
  font: inherit;
  font-size: var(--fs-xs);
  cursor: pointer;
}

.time-week-toggle svg {
  transition: transform 0.16s ease;
}

.time-week-card.is-expanded .time-week-toggle svg {
  transform: rotate(180deg);
}

.time-day-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.5rem;
}

.time-day-cell {
  min-height: 132px;
  padding: 0.65rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.time-day-cell.muted {
  opacity: 0.42;
}

.time-day-cell.has-entries {
  background: var(--surface);
  border-color: var(--surface-selected-strong);
}

.time-day-cell--empty {
  opacity: 0.5;
}

.time-day-cell--empty .time-day-head p {
  display: none;
}

.time-day-cell--weekend {
  background: var(--surface-raised);
  border-color: var(--surface-elevated);
}

.time-day-cell--weekend.muted {
  background: var(--surface);
  border-color: var(--border);
}

.time-day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.55rem;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-day-head strong {
  color: var(--text);
  font-size: var(--fs-xs);
  white-space: nowrap;
}

.time-entry-list {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.time-entry-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 0.25rem;
  padding: 0.55rem;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: rgba(0,0,0,0.28);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.time-entry-card:hover,
.time-entry-card:focus-visible {
  border-color: var(--surface-elevated);
  background: var(--surface-elevated);
  outline: none;
}

.time-entry-top,
.time-entry-meta,
.time-entry-address,
.time-entry-outlay,
.time-entry-user {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.time-entry-user {
  font-size: 0.75rem;
  color: var(--text-muted);
  padding: 0.1rem 0.3rem;
  margin-bottom: 0.2rem;
}

.time-entry-top {
  justify-content: space-between;
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.time-entry-meta {
  justify-content: flex-end;
  gap: 0.35rem;
  white-space: nowrap;
}

.time-entry-card strong {
  color: var(--text);
  font-size: var(--fs-sm);
  font-weight: 400;
  line-height: 1.25;
}

.time-entry-address {
  color: var(--text-muted);
  font-size: var(--fs-xs);
  line-height: 1.25;
}

.time-entry-outlay {
  padding: 0.12rem 0.4rem;
  border-radius: var(--radius-pill);
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

@media (max-width: 900px) {
  .time-day-grid {
    grid-template-columns: 1fr;
  }

  .time-day-cell {
    min-height: auto;
  }
}

@media (max-width: 640px) {
  .time-overview-header {
    flex-direction: column;
  }

  .time-month-controls,
  .time-month-switcher,
  .time-summary-grid {
    width: 100%;
  }

  .time-month-controls {
    align-items: stretch;
  }

  .time-month-switcher {
    justify-content: space-between;
  }

  .time-summary-grid {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .time-week-header {
    flex-direction: column;
  }

  .time-week-totals {
    justify-content: flex-start;
  }
}

@media (min-width: 768px) {
  .time-overview-page {
    max-width: none;
    padding: 0 2rem;
  }

  .time-overview-header {
    align-items: center;
    margin-bottom: 2rem;
  }

  .time-overview-header > div:first-child {
    flex: 1;
  }

  .time-month-controls {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }

  .time-today-button {
    white-space: nowrap;
  }

  .time-summary-grid {
    gap: 1rem;
    justify-content: flex-end;
  }

  .time-summary-card {
    padding: 0.35rem 0.75rem;
    gap: 0.5rem;
  }

  .time-summary-card > div {
    gap: 0.4rem;
  }

  .time-week-card {
    padding: 1.25rem;
  }

  .time-week-header {
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .time-week-header > div:first-child {
    flex: 1;
  }

  .time-week-totals {
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .time-week-totals span {
    padding: 0.3rem 0.7rem;
    font-size: var(--fs-xs);
  }

  .time-day-grid {
    gap: 0.75rem;
  }

  .time-day-cell {
    min-height: 160px;
    padding: 0.8rem;
  }

  .time-day-head {
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .time-entry-card {
    padding: 0.65rem;
    gap: 0.3rem;
  }

  .time-entry-card strong {
    font-size: var(--fs-sm);
  }

  .time-entry-user {
    font-size: 0.7rem;
  }
}

/* Admin Weekly Overview */
.admin-weekly-overview {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.admin-week-card {
  border-radius: var(--radius-lg);
  background: var(--surface);
  border: 1px solid var(--border);
  overflow: auto;
}

.admin-week-card.is-current {
  border-color: var(--primary);
  background: var(--surface);
  box-shadow: 0 0 0 2px rgba(var(--primary-rgb), 0.1);
}

.admin-week-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid var(--border);
  background: var(--surface-raised);
}

.admin-week-title h3 {
  margin: 0;
  font-size: var(--fs-base);
  font-weight: 500;
}

.admin-week-meta {
  display: flex;
  gap: 1rem;
  align-items: center;
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

.admin-week-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
  background: var(--surface);
}

.admin-week-table thead {
  background: var(--surface-raised);
  position: sticky;
  top: 0;
}

.admin-week-table thead th {
  padding: 0.5rem 0.6rem;
  text-align: center;
  font-weight: 600;
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border: 1px solid var(--border);
  white-space: nowrap;
  background: var(--surface-raised);
}

.admin-col-name {
  text-align: left !important;
  font-weight: 600;
  min-width: 120px;
}

.admin-col-day {
  min-width: 60px;
}

.admin-col-total {
  min-width: 60px;
  border-left: 2px solid var(--primary) !important;
}

.admin-day-short {
  display: block;
  font-size: 0.65rem;
  color: var(--text-muted);
  text-transform: uppercase;
  font-weight: 500;
  line-height: 1;
}

.admin-day-num {
  display: block;
  font-weight: 700;
  color: var(--text);
  font-size: 0.9rem;
  line-height: 1.1;
}

.admin-col-hours {
  font-variant-numeric: tabular-nums;
  color: var(--text);
  font-weight: 500;
}

.admin-week-table tbody tr {
  border-bottom: 1px solid var(--border);
  transition: background-color 0.2s;
}

.admin-week-table tbody tr:hover {
  background-color: var(--surface-raised);
}

.admin-user-row td {
  padding: 0.5rem 0.6rem;
  text-align: center;
  border-right: 1px solid var(--border);
  color: var(--text);
}

.admin-user-row .admin-col-name {
  text-align: left;
  background: var(--surface-raised);
  font-weight: 500;
  border-right: 1px solid var(--border);
}

.admin-user-row td:last-child {
  border-right: none;
  background: var(--surface-raised);
  font-weight: 600;
  border-left: 2px solid var(--border);
}

.admin-row-total {
  background: var(--surface-raised);
  font-weight: 700;
  border-top: 2px solid var(--border);
}

.admin-row-total td {
  padding: 0.5rem 0.6rem;
  text-align: center;
  border-right: 1px solid var(--border);
  background: var(--surface-raised);
  color: var(--text);
  font-weight: 600;
}

.admin-row-total .admin-col-name {
  text-align: left;
  border-right: 1px solid var(--border);
}

.admin-row-total td:last-child {
  border-right: none;
  background: var(--primary-soft) !important;
  color: var(--primary) !important;
  border-left: 2px solid var(--primary);
}

@media (min-width: 768px) {
  .admin-week-title {
    padding: 1rem 1.25rem;
  }

  .admin-week-title h3 {
    font-size: var(--fs-lg);
  }

  .admin-week-table {
    font-size: 0.9375rem;
  }

  .admin-week-table thead th,
  .admin-week-table tbody td {
    padding: 0.65rem 0.75rem;
  }

  .admin-col-name {
    min-width: 140px;
  }

  .admin-col-day {
    min-width: 70px;
  }
}

/* Job History Drawer */
.drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-dark-04);
  backdrop-filter: blur(4px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.drawer-overlay.open {
  opacity: 1;
  visibility: visible;
}

.drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 100%;
  max-width: 450px;
  height: 100%;
  background: var(--bg);
  z-index: 1001;
  box-shadow: -4px 0 20px rgba(0,0,0,0.3);
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.drawer.open {
  right: 0;
}

.drawer-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--surface-raised);
}

.drawer-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--text);
}

.drawer-title h2 {
  margin: 0;
  font-size: var(--fs-lg);
  font-weight: 500;
}

.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
}

.history-timeline {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-event {
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 0.15s ease;
}

.history-event-header {
  padding: 1rem;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

@media (hover: hover) {
.history-event-header:hover {
  background: var(--overlay-light-002);
}
}

.history-event-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}

.history-event-user, .history-event-time {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.history-event-type-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-event-type-label {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text-muted);
}

.history-event-summary {
  padding: 0 1rem 0.5rem;
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 1.4;
}

.history-event-details {
  border-top: 1px solid var(--border);
  padding: 0.75rem;
  background: var(--overlay-dark-01);
  overflow-x: auto; /* Enable scrolling on small screens */
}

.history-changes-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-sm);
  table-layout: fixed; /* Force fixed layout to respect widths */
}

.history-changes-table th {
  text-align: left;
  padding: 0.5rem;
  color: var(--text-muted);
  font-weight: 400;
  border-bottom: 1px solid var(--border);
}

.history-changes-table td {
  padding: 0.6rem 0.5rem;
  vertical-align: top;
  word-wrap: break-word; /* Force wrapping of long words */
}

.change-field {
  color: var(--text);
  font-weight: 500;
  width: 30%; /* Set explicit width */
}

.change-value-old {
  color: var(--text-muted);
  opacity: 0.9;
}

.change-value-old, .change-value-new {
  width: 35%; /* Set explicit width */
}


.value-empty {
  font-style: italic;
  font-size: var(--fs-xs);
}

.drawer-loading, .drawer-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200px;
  color: var(--text-muted);
  text-align: center;
}

.history-btn {
  margin-right: 0.25rem;
  color: var(--text-muted);
}

@media (hover: hover) {
.history-btn:hover {
  color: var(--text);
  background: var(--surface-raised);
}
}

/* Infinite Scroll */
.infinite-scroll-sentinel {
  width: 100%;
  min-height: 1px;
}

.infinite-scroll-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1.5rem;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.infinite-scroll-loading .spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid var(--border);
  border-top-color: var(--primary);
  border-radius: var(--radius-pill);
  animation: spin 0.6s linear infinite;
}

/* Invite Accept Page */
.invite-container {
  justify-content: center;
  align-items: center;
  min-height: 100dvh;
}

.invite-card {
  width: min(100%, 420px);
  padding: 2.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 24px;
  backdrop-filter: blur(20px);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  text-align: center;
  z-index: 1;
}

.invite-logo-wrapper {
  justify-content: center;
  margin-bottom: 1.5rem;
}

.invite-status-icon {
  margin-bottom: 1rem;
}

.invite-status-icon--success {
  color: var(--success);
}

.invite-status-icon--danger {
  color: var(--danger);
}

.invite-title {
  margin-bottom: 0.5rem;
}

.invite-text {
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.invite-text--long {
  margin-bottom: 2rem;
}

.invite-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.invite-field {
  text-align: left;
}

.invite-label {
  display: block;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-bottom: 0.35rem;
}

.invite-input-wrapper {
  position: relative;
}

.invite-input-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-dim);
}

.invite-input {
  width: 100%;
  padding: 0.7rem 0.75rem 0.7rem 2.5rem;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: 12px;
  color: var(--text);
  font-size: var(--fs-body);
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.invite-input:focus {
  border-color: var(--focus-ring);
}

.invite-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.invite-btn-accept {
  width: 100%;
}

.invite-btn-submit {
  margin-top: 0.5rem;
}

.invite-error-badge {
  padding: 0.75rem 1rem;
  background: var(--status-red-bg);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 12px;
  margin-bottom: 1.5rem;
  color: var(--status-red-text);
  font-size: var(--fs-sm);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-align: left;
}

.invite-footer {
  margin-top: 1.5rem;
  font-size: var(--fs-sm);
}

/* ------------------------------------------------------------
   Login page
   ------------------------------------------------------------ */
.app-container-center {
  justify-content: center;
  align-items: center;
}

.login-card {
  width: 100%;
  max-width: 400px;
  padding: 2rem;
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 24px;
  backdrop-filter: blur(20px);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

.login-card-header {
  text-align: center;
  margin-bottom: 2rem;
}

.login-card-header h2 {
  margin-bottom: 0.5rem;
}

.login-card-header p {
  color: var(--text-secondary);
}

.login-email-info {
  font-weight: 400;
  font-size: 1.1rem;
  margin-top: 0.25rem;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.login-form label {
  display: block;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
  font-weight: 400;
}

.login-form .btn-primary {
  width: 100%;
  margin-top: 0.5rem;
}

.login-form .btn-primary svg:first-child {
  margin-right: 0.5rem;
}

.logo-center {
  justify-content: center;
  margin-bottom: 1rem;
}

/* ------------------------------------------------------------
   AppLayout
   ------------------------------------------------------------ */
.logo-header {
  font-size: 1.25rem;
}

.user-avatar-initial {
  font-size: 0.9rem;
  font-weight: 500;
}

/* ------------------------------------------------------------
   Login page — reauth spinner
   ------------------------------------------------------------ */
.reauth-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 24px;
  backdrop-filter: blur(20px);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  max-width: 400px;
  width: 100%;
}

.reauth-card .animate-spin {
  color: var(--text-secondary);
}

.reauth-card p {
  color: var(--text-secondary);
  text-align: center;
  margin: 0;
}

.reauth-cancel-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-secondary);
  font-size: 0.9rem;
  padding: 0.5rem;
  text-decoration: underline;
}

/* ------------------------------------------------------------
   Login page — email step buttons
   ------------------------------------------------------------ */
.login-email-step {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.login-otc-btn {
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-secondary);
  font-size: 0.9rem;
  padding: 0.75rem;
}

.login-submit-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  position: relative;
  overflow: hidden;
}

.login-submit-btn:disabled {
  opacity: 0.7;
  cursor: wait;
}

.login-submit-btn-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: inherit;
  backdrop-filter: blur(2px);
}

/* ------------------------------------------------------------
   Login page — code step back button
   ------------------------------------------------------------ */
.login-back-btn {
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.9rem;
  padding: 0.75rem;
}

/* ------------------------------------------------------------
   Login page — error banner
   ------------------------------------------------------------ */
.login-error-banner {
  padding: 0.75rem 1rem;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 12px;
  margin-bottom: 1.5rem;
  color: #ef4444;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* ------------------------------------------------------------
   Login page — email sent info
   ------------------------------------------------------------ */

/* ------------------------------------------------------------
   Login page — back to front page
   ------------------------------------------------------------ */
.login-frontpage-footer {
  text-align: center;
  margin-top: 1.5rem;
  font-size: 0.9rem;
}

.login-frontpage-footer a {
  color: var(--text-secondary);
}

/* ------------------------------------------------------------
   Login page — dev login section
   ------------------------------------------------------------ */
.login-dev-section {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--surface-border);
}

.login-dev-buttons {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.login-dev-btn {
  width: 100%;
  font-size: 0.85rem;
}

/* ------------------------------------------------------------
   Protected route loading
   ------------------------------------------------------------ */
.protected-route-loading {
  text-align: center;
  padding: 2rem;
  color: var(--text-secondary);
}

/* ------------------------------------------------------------
   Invite — submit button disabled state
   ------------------------------------------------------------ */
.invite-btn-submit:disabled {
  opacity: 0.7;
  cursor: wait;
}

/* ------------------------------------------------------------
   Invite — footer link
   ------------------------------------------------------------ */
.invite-footer-link {
  color: var(--text-muted);
}

/* ------------------------------------------------------------
   Customer actions — context menu anchor + edit form
   ------------------------------------------------------------ */
.job-card-wrapper {
  position: relative;
  overflow: visible;
}

.job-card-wrapper .job-card {
  width: 100%;
}

.customer-actions-anchor {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  z-index: 10;
}

.customer-actions-anchor .customer-actions-btn {
  opacity: 1;
}

.customer-edit-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin: 0.75rem 0;
}

/* ------------------------------------------------------------
   Utility classes for inline style cleanup
   ------------------------------------------------------------ */
.flex-row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.flex-row-center {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.flex-row-end {
  display: flex;
  gap: 0.25rem;
  justify-content: flex-end;
}
.inline-flex-center {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}
.flex-1 {
  flex: 1;
}
.flex-shrink-0 {
  flex-shrink: 0;
}
.text-muted {
  color: var(--text-muted);
}
.opacity-50 {
  opacity: 0.5;
}
.skeleton-w-70 {
  width: 70% !important;
}
.skeleton-w-50 {
  width: 50% !important;
}
.skeleton-w-80 {
  width: 80% !important;
}
.skeleton-w-2rem {
  width: 2rem !important;
}
.skeleton-w-1-5rem {
  width: 1.5rem !important;
}
.btn-reset {
  cursor: pointer;
  width: 100%;
  background: none;
  border: 0;
  font: inherit;
  text-align: left;
  color: inherit;
}
.spinner-white {
  width: 16px;
  height: 16px;
  border: 2px solid white;
  border-top-color: transparent;
  border-radius: 50%;
  margin-right: 8px;
}
.chevron-icon {
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform 0.2s;
  margin-left: auto;
}
