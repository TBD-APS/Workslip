                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/jobs/{id}/assign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}",
                "assign"
              ]
            },
            "description": "Assigns a job to a user through the query-bound userId parameter.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userIds\": [\n    \"{{creatorUserId}}\",\n    \"{{assigneeUserId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK or 404 Not Found', function () { pm.expect([200, 404]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const ids = json.assignedUsers.map(user => user.id);",
                  "  pm.test('multiple assigned users returned', function () {",
                  "    pm.expect(json.assignedUsers).to.be.an('array');",
                  "    pm.expect(ids).to.include(pm.variables.get('creatorUserId'));",
                  "    pm.expect(ids).to.include(pm.variables.get('assigneeUserId'));",
                  "  });",
                  "  pm.test('legacy assignedUser removed', function () { pm.expect(json).to.not.have.property('assignedUser'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/jobs?customerNameSearch",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/?customerNameSearch=test",
              "host": [
