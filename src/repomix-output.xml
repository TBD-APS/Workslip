                  "pm.test('link id captured', function () { pm.expect(link.id).to.be.a('string').and.not.empty; });",
                  "pm.test('link view model hides internal timestamp', function () { pm.expect(link).to.not.have.property('createdAt'); });",
                  "pm.test('linked report info returned', function () { pm.expect(link.linkedReportNumber).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/jobs/{id}/links batch delete",
          "request": {
