        app.MapOrganizationEndpoints();
        app.MapAuthEndpoints();
        app.MapUserEndpoints();
        app.MapJobEndpoints();
        app.MapJobLinkEndpoints();
        app.MapWorkSheetEndpoints();
        app.MapReferenceDataEndpoints();

        return app;
    }
