/* App Shell & Forms CSS */

/* Forms */
.form-input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 1rem;
  transition: all 0.2s ease;
}

.form-input:focus {
  outline: none;
  border-color: var(--accent-color);
  box-shadow: 0 0 0 2px rgba(0, 112, 243, 0.2);
}

.form-input::placeholder {
  color: var(--text-secondary);
  opacity: 0.5;
}

/* App Shell Layout (Mobile First) */
.app-shell {
  display: flex;
  flex-direction: column;
  height: 100dvh; /* use dvh for mobile browsers */
  background-color: var(--bg-color);
  overflow: hidden;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.5rem;
  background: rgba(5, 5, 5, 0.8);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--surface-border);
  z-index: 10;
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
}

.app-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  padding-bottom: calc(80px + 1.5rem); /* Make room for bottom nav */
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 80px;
  background: rgba(15, 15, 15, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--surface-border);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  color: var(--text-secondary);
  font-size: 0.75rem;
  font-weight: 500;
  flex: 1;
  transition: color 0.2s;
}

.nav-item.active {
  color: var(--accent-color);
}

.nav-item-fab {
  flex: 1;
  display: flex;
  justify-content: center;
  transform: translateY(-20px);
}

.fab-button {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--accent-gradient);
  border: none;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(0, 112, 243, 0.4);
  cursor: pointer;
  transition: transform 0.2s;
}

.fab-button:active {
  transform: scale(0.95);
}

/* Job List Components */
.page-container {
  max-width: 600px;
  margin: 0 auto;
}

.page-header {
  margin-bottom: 1.5rem;
}

.page-header h2 {
  font-size: 1.75rem;
  margin-bottom: 0.25rem;
}

.subtitle {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* Job list gap */
.job-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* ------------------------------------------------------------
   Card
   ------------------------------------------------------------ */
.job-card {
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 16px;
  padding: 1.1rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}

.job-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: transparent;
  transition: background 0.2s;
}

.job-card.is-urgent::before {
  background: linear-gradient(180deg, #f97316, #ef4444);
}

.job-card:hover {
  border-color: rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.05);
}

.job-card:active {
  transform: scale(0.995);
}

/* ------------------------------------------------------------
   Card top: SAG-id + customer name (left), status pill (right)
   ------------------------------------------------------------ */
.job-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
}

.job-number {
  display: inline-block;
  font-family: var(--font-main);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  text-transform: uppercase;
  margin-bottom: 0.3rem;
}

.job-customer {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.25;
  color: var(--text-primary);
}

/* ------------------------------------------------------------
   Address row
   ------------------------------------------------------------ */
.job-address-row {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.job-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ------------------------------------------------------------
   Meta row: date, urgency badges, hours
   ------------------------------------------------------------ */
.job-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 0.75rem;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.meta-hours {
  color: var(--text-secondary);
  font-weight: 500;
}

.meta-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.meta-badge.is-urgent {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
}

.meta-badge.is-today {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
}

.meta-badge.is-upcoming {
  background: rgba(0, 112, 243, 0.15);
  color: #60a5fa;
}

/* ------------------------------------------------------------
   Card header: status badge + job ID
   ------------------------------------------------------------ */
.job-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ------------------------------------------------------------
   Status badges
   ------------------------------------------------------------ */
.status-badge {
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.3px;
}

.status-draft {
  background: rgba(161, 161, 170, 0.12);
  color: #a1a1aa;
}

.status-assigned {
  background: rgba(0, 112, 243, 0.12);
  color: #60a5fa;
}

.status-submitted {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
}

.status-inreview {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
}

.status-approved {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
}

.status-rejected {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
}

.status-returned {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
}

.status-archived {
  background: rgba(161, 161, 170, 0.08);
  color: #6b7280;
}

/* ------------------------------------------------------------
   Customer name
   ------------------------------------------------------------ */
.job-customer {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.3;
}

/* (legacy detail-row classes removed — meta badges now use job-card-meta) */

/* ------------------------------------------------------------
   Card footer: assigned users + chevron
   ------------------------------------------------------------ */
.job-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.25rem;
  padding-top: 0.25rem;
  border-top: 1px solid var(--surface-border);
}

.job-assigned {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.assigned-user {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.8rem;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.05);
  padding: 0.2rem 0.5rem;
  border-radius: 6px;
}

.unassigned {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.8rem;
  color: #6b7280;
  font-style: italic;
}

.btn-icon {
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: 50%;
  transition: all 0.2s;
}

.btn-icon:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

/* ------------------------------------------------------------
   Skeleton loading
   ------------------------------------------------------------ */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 8px;
}

.skeleton-title {
  width: 140px;
  height: 28px;
  margin-bottom: 8px;
}

.skeleton-subtitle {
  width: 100px;
  height: 16px;
}

.skeleton-badge {
  width: 60px;
  height: 20px;
  border-radius: 999px;
}

.skeleton-id {
  width: 70px;
  height: 14px;
}

.skeleton-name {
  width: 180px;
  height: 18px;
}

.skeleton-address {
  width: 100%;
  height: 14px;
}

.skeleton-tag {
  width: 80px;
  height: 18px;
}

.skeleton-chevron {
  width: 20px;
  height: 20px;
  border-radius: 50%;
}

.job-card-skeleton {
  cursor: default;
  pointer-events: none;
}

.job-card-skeleton:hover {
  border-color: var(--surface-border);
  background: var(--surface-color);
}

/* ------------------------------------------------------------
   Empty & error states
   ------------------------------------------------------------ */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-secondary);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  text-align: center;
  padding: 4rem 2rem;
  color: #ef4444;
}

.error-state p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  max-width: 280px;
}

@media (min-width: 768px) {
  .app-shell {
    flex-direction: row;
  }
  
  .bottom-nav {
    display: none;
  }
  
  .app-content {
    padding-bottom: 1.5rem;
  }
}
