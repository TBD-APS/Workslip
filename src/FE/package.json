{
  "name": "fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:api:local && npm run sync:fonts",
    "dev": "vite",
    "generate:api:local": "node scripts/generate-api-client.mjs",
    "generate:api:live": "dotenv -e .env.local -- orval --config orval.config.ts",
    "generate:api:dev": "dotenv -e .env.dev -- orval --config orval.config.ts",
    "generate:api:prod": "dotenv -e .env.production -- orval --config orval.config.ts",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "check:prototype-safety": "node scripts/check-prototype-safety.mjs",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "prebuild": "npm run check:prototype-safety && npm run sync:fonts",
    "build": "tsc -b && npm run typecheck:sw && vite build",
    "build:dev": "npm run generate:api:dev && npm run sync:fonts && tsc -b && npm run typecheck:sw && vite build",
    "build:local": "npm run generate:api:local && npm run sync:fonts && tsc -b && npm run typecheck:sw && vite build",
    "test": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:api:watch": "orval --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@tanstack/react-query": "^5.100.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.18.0",
    "lucide-react": "^1.17.0",
    "qs": "^6.15.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.76.1",
    "react-router-dom": "^7.15.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.13.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "26.1.0",
    "orval": "^8.18.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "ejs": "5.0.1"
  }
}
