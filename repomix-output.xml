/* ------------------------------------------------------------
   Skeleton loading
   ------------------------------------------------------------ */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 8px;
}

.skeleton-title {
  width: 140px;
  height: 28px;
  margin-bottom: 8px;
}

.skeleton-subtitle {
  width: 100px;
  height: 16px;
}

.skeleton-badge {
  width: 60px;
  height: 20px;
  border-radius: 999px;
}

.skeleton-id {
  width: 70px;
  height: 14px;
}

.skeleton-name {
  width: 180px;
  height: 18px;
}

.skeleton-address {
  width: 100%;
  height: 14px;
}

.skeleton-tag {
  width: 80px;
  height: 18px;
}

.skeleton-chevron {
  width: 20px;
  height: 20px;
  border-radius: 50%;
}

.job-card-skeleton {
