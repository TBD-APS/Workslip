  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
  font-size: 0.95rem;
}

.report-overview-timesheet-list {
  margin-bottom: 0.75rem;
}

@media (max-width: 640px) {
  .report-overview-header {
    flex-wrap: wrap;
  }

  .report-overview-actions {
    width: 100%;
    margin-left: 0;
