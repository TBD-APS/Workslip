  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.16);
  --focus-ring: rgba(255, 255, 255, 0.2);

  /* Overlays */
  --overlay-subtle: rgba(0, 0, 0, 0.4);
  --overlay-medium: rgba(0, 0, 0, 0.6);
  --overlay-heavy: rgba(0, 0, 0, 0.85);
  --overlay-blur: rgba(5, 5, 5, 0.8);

  /* Status System */
  --status-blue-bg: rgba(37, 99, 235, 0.12);
  --status-blue-text: #60a5fa;
  --status-red-bg: rgba(239, 68, 68, 0.12);
  --status-red-text: #f87171;
  --status-amber-bg: rgba(245, 158, 11, 0.15);
  --status-amber-text: #fcd34d;
