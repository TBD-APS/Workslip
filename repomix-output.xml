[data-theme="day"] .bg-glow-1 {
  background: radial-gradient(circle, rgba(0, 112, 243, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
}

[data-theme="day"] .bg-glow-2 {
  background: radial-gradient(circle, rgba(0, 198, 255, 0.06) 0%, rgba(0, 0, 0, 0) 70%);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

strong,
b {
  font-weight: 400;
}

html,
body {
  min-height: 100vh;
  overflow-anchor: none;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  font-weight: 400;
  line-height: 1.2;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s ease;
}

@media (hover: hover) {
  a:hover {
    color: var(--primary);
  }
}

.app-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  min-height: 100dvh;
  padding-top: calc(env(safe-area-inset-top, 0px) + 1rem);
  padding-right: env(safe-area-inset-right, 0px);
  padding-left: env(safe-area-inset-left, 0px);
}

.bg-glow-wrapper {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

.bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.5;
  animation: float 20s ease-in-out infinite alternate;
}

.bg-glow-1 {
  top: -10%;
  left: 10%;
  width: 50vw;
  height: 50vw;
  background: radial-gradient(circle, rgba(0, 112, 243, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
}

.bg-glow-2 {
  right: -5%;
  bottom: -10%;
  width: 60vw;
  height: 60vw;
  background: radial-gradient(circle, rgba(0, 198, 255, 0.1) 0%, rgba(0, 0, 0, 0) 70%);
  animation-delay: -10s;
}

@keyframes float {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(5%, 5%) scale(1.1); }
  100% { transform: translate(-5%, -5%) scale(0.9); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

.logo {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 400;
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  color: inherit;
}

.logo-icon {
  color: #00c6ff;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius);
  font-size: 0.95rem;
  font-weight: 400;
  cursor: pointer;
  transition: all 0.15s ease;
  border: none;
  font-family: var(--font-main);
}

.btn-pill {
  border-radius: 9999px;
}

.btn-sm {
  padding: 0.35rem 0.85rem;
  font-size: 0.82rem;
  border-radius: var(--radius-sm);
}

.btn:active {
  transform: scale(0.97);
  transition: transform 0.08s ease;
}

.btn-primary {
  background: var(--primary);
  color: white;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
}

.btn-primary:active {
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.2);
  transform: scale(0.97);
}

.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
  backdrop-filter: blur(10px);
}

.btn-secondary:active {
  background: var(--surface-selected);
  transform: scale(0.97);
}

.btn-danger {
  background: var(--danger);
  color: white;
  box-shadow: 0 4px 14px rgba(220, 38, 38, 0.28);
}

.btn-danger:active,
.btn-outline:active,
.btn-outline-danger:active {
  transform: scale(0.97);
}

.btn-outline {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
}

.btn-outline-danger {
  background: transparent;
  color: var(--danger);
  border: 1px solid var(--danger);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (hover: hover) {
  .btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.38);
  }

  .btn-secondary:hover {
    background: var(--surface-raised);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .btn-danger:hover {
    background: var(--danger-hover);
    transform: translateY(-1px);
  }

  .btn-outline:hover {
    background: var(--surface);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--text);
  }

  .btn-outline-danger:hover {
    background: rgba(239, 68, 68, 0.08);
  }
}
