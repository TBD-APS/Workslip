        context.JobReportInstallations.Add(new JobReportInstallationRow
        {
            Id = instAId,
            OrganizationId = orgId,
            JobReportId = jobId,
            InstallationTypeDefinitionId = instTypeAId,
            SortOrder = 1
        });
        context.JobReportInstallationCategories.AddRange(
