  font-size: 0.85rem;
}

.pdf-preview-frame {
  flex: 1;
  width: 100%;
  border: 0;
  background: var(--bg-color);
}

.spin {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ------------------------------------------------------------
   Card top: SAG-id + customer name (left), status pill (right)
   ------------------------------------------------------------ */
.job-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
}

.job-number {
  display: inline-block;
  font-family: var(--font-main);
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.08em;
