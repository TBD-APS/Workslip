.detail-header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-icon-danger {
  color: rgba(248, 113, 113, 0.7);
  transition: color 0.15s, background 0.15s;
}

.btn-icon-danger:hover {
  color: #ef4444;
  background: rgba(248, 113, 113, 0.1);
}

.detail-title {
  font-size: 1.25rem;
  margin: 0;
