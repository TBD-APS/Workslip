/* ------------------------------------------------------------
   Address row
   ------------------------------------------------------------ */
.job-address-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.job-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ------------------------------------------------------------
   Meta row: date, urgency badges, hours
   ------------------------------------------------------------ */
.job-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 0.75rem;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.meta-hours {
  color: var(--text-muted);
  font-weight: 400;
}

.job-card-meta .meta-updated {
  white-space: nowrap;
}

.user-hours-row {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: var(--fs-xs);
  color: var(--text-muted);
  padding: 0.25rem 0 0;
}

.user-hours-sep {
  opacity: 0.4;
}


/* ------------------------------------------------------------
   Card header: status badge + job ID
   ------------------------------------------------------------ */
.job-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ------------------------------------------------------------
   Status badges
   ------------------------------------------------------------ */
.status-badge {
  padding: 0.2rem 0.65rem;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: 400;
  letter-spacing: 0.3px;
  white-space: nowrap;
  flex-shrink: 0;
}

.job-card-badges {
  display: flex;
  gap: 0.4rem;
  align-items: center;
  flex-shrink: 0;
}

.job-type-badge {
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-pill);
  font-size: var(--fs-2xs);
  font-weight: 500;
  letter-spacing: 0.3px;
  white-space: nowrap;
  flex-shrink: 0;
}

.job-type-v4v05 {
  background: color-mix(in srgb, var(--color-primary) 15%, transparent);
  color: var(--color-primary);
}

.job-type-diverse {
  background: color-mix(in srgb, var(--color-info, #6366f1) 15%, transparent);
  color: var(--color-info, #6366f1);
}


/* ------------------------------------------------------------
   Customer name
   ------------------------------------------------------------ */
.job-customer {
  font-size: var(--fs-lg);
  font-weight: 400;
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* (legacy detail-row classes removed â€” meta badges now use job-card-meta) */

/* ------------------------------------------------------------
   Card footer: assigned users + chevron
   ------------------------------------------------------------ */
.job-card-body {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}

.job-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.25rem;
  padding-top: 0.25rem;
  border-top: 1px solid var(--border);
}

.job-assigned {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.assigned-user {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text);
}

.assigned-user + .assigned-user::before {
  content: ", ";
}

.unassigned {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text-dim);
  font-style: italic;
}

/* Mobile job card - comma-separated list */
.job-card .cell-comma-list {
  font-size: var(--fs-xs);
}

.job-card .cell-comma-list-item {
  display: inline;
  white-space: nowrap;
}

.job-card .cell-comma-list-item + .cell-comma-list-item::before {
  content: ", ";
}

.job-card-footer .cell-comma-list {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.job-card-meta .meta-item:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.btn-icon {
  background: none;
  border: none;
  color: var(--text);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: var(--radius-pill);
  transition: all 0.15s;
}

.btn-icon:active {
  background: var(--surface-selected-strong);
  transform: scale(0.92);
  transition: transform 0.08s ease, background 0.08s ease;
}

@media (hover: hover) {
.btn-icon:hover {
  background: var(--surface-raised);
  color: var(--text);
}
}

/* ------------------------------------------------------------
   Skeleton loading
   ------------------------------------------------------------ */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 25%, rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

.skeleton-title {
  width: 140px;
  height: 28px;
  margin-bottom: 8px;
}

.skeleton-subtitle {
  width: 100px;
  height: 16px;
}

.skeleton-badge {
  width: 60px;
  height: 20px;
  border-radius: var(--radius-pill);
}

.skeleton-id {
  width: 70px;
  height: 14px;
}

.skeleton-name {
  width: 180px;
  height: 18px;
}

.skeleton-address {
  width: 100%;
  height: 14px;
}

.skeleton-tag {
  width: 80px;
  height: 18px;
}

.skeleton-w-60 {
  width: 60% !important;
}
.skeleton-w-40 {
  width: 40% !important;
}
.skeleton-w-30 {
  width: 30% !important;
}

.skeleton-chevron {
  width: 20px;
  height: 20px;
  border-radius: var(--radius-pill);
}

.job-card-skeleton {
  cursor: default;
  pointer-events: none;
}

@media (hover: hover) {
.job-card-skeleton:hover {
  background: var(--surface);
}
}

/* ------------------------------------------------------------
   Empty & error states
   ------------------------------------------------------------ */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-muted);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  text-align: center;
  padding: 4rem 2rem;
  color: var(--danger);
}

.error-state p {
  color: var(--text-muted);
  font-size: var(--fs-body);
  max-width: 280px;
}

.error-state-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  align-items: center;
}

/* ------------------------------------------------------------
