}

.status-assigned {
  background: rgba(0, 112, 243, 0.12);
  color: #60a5fa;
}

.status-submitted {
  background: rgba(10, 0, 0, 0.12);
  color: #ffffff;
}

.status-inreview {
  background: rgba(161, 161, 170, 0.12);
  color: #a1a1aa;
}

.status-approved {
