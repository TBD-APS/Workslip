}

/* ------------------------------------------------------------
   Meta row: date, urgency badges, hours
   ------------------------------------------------------------ */
.job-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 0.75rem;
  font-size: 0.78rem;
