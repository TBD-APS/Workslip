  justify-content: flex-end;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

.admin-total-value {
  font-weight: 500;
  color: var(--text);
}

.admin-col-total {
  width: 60px;
  min-width: 50px;
  border-left: 2px solid var(--border-strong) !important;
}

.admin-day-short {
  display: block;
  font-size: 0.65rem;
  color: var(--text-muted);
  font-weight: 500;
  line-height: 1;
}

.admin-day-num {
  display: block;
  font-weight: 400;
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1.1;
}

.admin-col-hours {
  font-variant-numeric: tabular-nums;
  color: var(--text);
  font-weight: 500;
}

.admin-week-table tbody tr {
  border-bottom: 1px solid var(--border);
  transition: background-color 0.2s;
}

.admin-week-table tbody tr:hover {
  background-color: var(--surface-raised);
}

.admin-user-row td {
  padding: 0.5rem 0.5rem;
