<file path=".github/workflows/integration-tests.yml">
name: Workslip Integration Tests

on:
  workflow_dispatch:
    inputs:
      base_url:
        description: 'Non-production Workslip API base URL. Overrides WORKSLIP_INTEGRATION_BASE_URL secret when set.'
        required: false
        type: string

jobs:
  postman:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Run Postman integration tests
        env:
          INPUT_BASE_URL: ${{ inputs.base_url }}
          SECRET_BASE_URL: ${{ secrets.WORKSLIP_INTEGRATION_BASE_URL }}
          WORKSLIP_AUTH_TOKEN: ${{ secrets.WORKSLIP_AUTH_TOKEN }}
        run: |
          set -euo pipefail
          base_url="$INPUT_BASE_URL"
          if [ -z "$base_url" ]; then
            base_url="$SECRET_BASE_URL"
          fi
          if [ -z "$base_url" ]; then
            echo "::error::Set workflow input base_url or repository secret WORKSLIP_INTEGRATION_BASE_URL."
            exit 64
          fi
          src/BE/WorkslipApi/Postman/run-integration-tests.sh "$base_url"
</file>

<file path=".github/workflows/react-doctor.yml">
# React Doctor — finds security, performance, correctness, accessibility,
# bundle-size, and architecture issues in React codebases.
#
# Docs: https://www.react.doctor/ci
# Source: https://github.com/millionco/react-doctor

name: React Doctor

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  push:
    branches: [main]

permissions:
  contents: read
  pull-requests: write
  issues: write

concurrency:
  group: react-doctor-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  react-doctor:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: millionco/react-doctor@v1
        with:
          directory: src/FE
</file>

<file path=".github/workflows/release.yml">
name: Linear Release

on:
  push:
    branches: [main] # Skift til master eller prod hvis nødvendigt

jobs:
  linear-release:
    runs-on: ubuntu-latest
    steps:
      # VIGTIGT: fetch-depth: 0 er påkrævet for at actionen kan læse hele commit-historikken
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 

      - name: Run Linear Release Sync
        uses: linear/linear-release-action@v0
        with:
          access_key: ${{ secrets.LINEAR_ACCESS_KEY }}
</file>

