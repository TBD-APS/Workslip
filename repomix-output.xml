                JobReportInstallationId = instAId,
                ControlCategoryId = cat1Id,
                SortOrder = 1,
                IsIrrelevant = false
            },
            new JobReportInstallationCategoryRow
            {
                Id = catJoinA2Id,
                JobReportInstallationId = instAId,
                ControlCategoryId = cat2Id,
                SortOrder = 2,
                IsIrrelevant = false
