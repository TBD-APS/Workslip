import { useMemo, useState } from 'react';
import { FileSpreadsheet, Trash2 } from 'lucide-react';
import type { useJobDetails } from '../../hooks/useJobDetails';
import { useGetApiUsers } from '../../../../api/generated/users/users';
import { getUserList } from '../../utils';
import { useAuth } from '../../../../providers/AuthContext';

type Props = {
  details: ReturnType<typeof useJobDetails>;
};

const formatDate = (workDate: string) => {
  // WorksheetResponse.workDate is a string (ISO yyyy-MM-dd from the BE).
  return workDate;
};

const todayIso = () => {
  const today = new Date();
  const yyyy = today.getFullYear();
  const mm = String(today.getMonth() + 1).padStart(2, '0');
  const dd = String(today.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
};

export function JobWorksheetsStep({ details }: Props) {
  const worksheets = details.worksheets;
  const usersQuery = useGetApiUsers();
  const users = useMemo(() => getUserList(usersQuery.data), [usersQuery.data]);
  const userById = useMemo(() => new Map(users.map((u) => [u.id, u])), [users]);
  const { user } = useAuth();

  const [workDate, setWorkDate] = useState(todayIso());
  const [hoursWorked, setHoursWorked] = useState<string>('8');
  const [sleptOnJob, setSleptOnJob] = useState(false);
  const [userId, setUserId] = useState<string>(() => {
    const match = users.find((u) => u.email === user?.email);
    return match?.id ?? users[0]?.id ?? '';
  });
  const [hoursError, setHoursError] = useState<string | null>(null);

  const handleSubmit = (event: React.FormEvent) => {
    event.preventDefault();
    const hours = Number(hoursWorked);
    if (!Number.isFinite(hours) || hours <= 0) {
      setHoursError('Timer skal være større end 0');
      return;
    }
    if (!userId) {
      setHoursError('Vælg en montør');
      return;
    }
    setHoursError(null);
    details.upsertWorksheet({ userId, workDate, hoursWorked: hours, sleptOnJob });
  };

  const handleDelete = (worksheetId: string) => {
    if (!confirm('Er du sikker på, at du vil slette denne arbejdsseddel?')) return;
    details.deleteWorksheet(worksheetId);
  };

  return (
    <section className="detail-section">
      <div className="section-header-row">
        <FileSpreadsheet size={18} />
        <h3>Arbejdssedler</h3>
      </div>

      <h4 className="subsection-title">Eksisterende arbejdssedler</h4>
      {worksheets.length === 0 ? (
        <p className="empty-state-text">Ingen arbejdssedler endnu.</p>
      ) : (
        <table className="worksheets-table">
          <thead>
            <tr>
              <th>Dato</th>
              <th>Montør</th>
              <th>Timer</th>
              <th>Overnattet</th>
              <th aria-label="Handlinger" />
            </tr>
          </thead>
          <tbody>
            {worksheets.map((w) => (
              <tr key={w.id}>
                <td>{formatDate(w.workDate)}</td>
                <td>{userById.get(w.userId)?.displayName ?? '—'}</td>
                <td>{w.hoursWorked}</td>
                <td>{w.sleptOnJob ? 'Ja' : 'Nej'}</td>
                <td>
                  <button
                    className="btn-icon btn-icon-danger"
                    onClick={() => handleDelete(w.id)}
                    aria-label="Slet arbejdsseddel"
                  >
                    <Trash2 size={16} />
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <h4 className="subsection-title">Tilføj arbejdsseddel</h4>
      <form className="worksheet-form" onSubmit={handleSubmit}>
        <label className="form-field">
          <span>Dato</span>
          <input
            type="date"
            value={workDate}
            onChange={(e) => setWorkDate(e.target.value)}
            required
          />
        </label>

        <label className="form-field">
          <span>Montør</span>
          <select value={userId} onChange={(e) => setUserId(e.target.value)} required>
            {users.map((u) => (
              <option key={u.id} value={u.id}>
                {u.displayName}
              </option>
            ))}
          </select>
        </label>

        <label className="form-field">
          <span>Timer</span>
          <input
            type="number"
            min={0}
            step={0.5}
            value={hoursWorked}
            onChange={(e) => {
              setHoursWorked(e.target.value);
              if (hoursError) setHoursError(null);
            }}
            required
          />
          {hoursError && <span className="form-field-error">{hoursError}</span>}
        </label>

        <label className="form-field form-field-checkbox">
          <input
            type="checkbox"
            checked={sleptOnJob}
            onChange={(e) => setSleptOnJob(e.target.checked)}
          />
          <span>Overnattet</span>
        </label>

        <button type="submit" className="btn btn-primary">
          Tilføj arbejdsseddel
        </button>
      </form>
    </section>
  );
}
```

