    [Fact]
    public async Task MarkOpenedAsync_WhenInviteValid_EnsuresEntraGuestBeforeMarkingOpened()
    {
        var invite = CreateInvite();
        var invites = new FakeInviteRepository(invite);
        var entra = new FakeEntraService();
