  border-right: 1px solid var(--border);
  color: var(--text);
  font-size: 0.8rem;
}

.admin-user-row .admin-col-name {
  text-align: left;
  background: var(--surface-raised);
  font-weight: 500;
  border-right: 1px solid var(--border);
}

.admin-user-row td:last-child {
  border-right: none;
  background: var(--surface-raised);
  font-weight: 600;
  border-left: 2px solid var(--border);
}

.admin-row-total {
  background: var(--surface-raised);
  font-weight: 700;
  border-top: 2px solid var(--border);
}

.admin-row-total td {
  padding: 0.5rem 0.5rem;
  text-align: center;
  border-right: 1px solid var(--border);
  background: var(--surface-raised);
  color: var(--text);
  font-weight: 600;
  font-size: 0.8rem;
}

.admin-row-total .admin-col-name {
  text-align: left;
  border-right: 1px solid var(--border);
}

.admin-row-total td:last-child {
  border-right: none;
  border-left: 2px solid var(--primary);
}

@media (min-width: 768px) {
  .admin-week-title {
    padding: 1rem 1.25rem;
  }

  .admin-week-title h3 {
    font-size: var(--fs-lg);
  }

  .admin-week-table {
    font-size: 0.9375rem;
  }

  .admin-week-table thead th {
    padding: 0.6rem 0.75rem;
    font-size: 0.75rem;
  }

  .admin-week-table thead th,
  .admin-week-table tbody td {
    padding: 0.75rem 0.85rem;
  }

  .admin-col-name {
    width: 140px;
    min-width: 120px;
  }

  .admin-col-day {
    width: auto;
  }

  .admin-user-row td {
    padding: 0.75rem 0.85rem;
    font-size: 0.9375rem;
  }

  .admin-row-total td {
    padding: 0.75rem 0.85rem;
    font-size: 0.9375rem;
  }

  .admin-day-num {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
  }
