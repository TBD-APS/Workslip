}

@media (hover: hover) {
  .linked-job-row:hover .linked-job-link {
    text-decoration: underline;
  }
}

.linked-job-row:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.linked-job-link {
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.linked-job-customer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
  min-width: 0;
}

.linked-jobs-variant .multi-select-chip-description {
  color: var(--text);
  font-size: var(--fs-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.assignment-variant .multi-select-chip {
  background: none;
  border: none;
  padding: 0;
  font-size: var(--fs-body);
  font-weight: 400;
}

.linked-jobs-variant .multi-select-option-text {
  flex-direction: row;
  align-items: baseline;
  gap: 0.5rem;
}

.linked-jobs-variant .multi-select-option-text span:first-child {
  color: var(--text);
  font-size: var(--fs-sm);
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.linked-jobs-variant .multi-select-option-text small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
  min-width: 0;
}

.linked-jobs-variant .multi-select-chip {
  background: none;
  border: none;
  padding: 0;
  gap: 0.5rem;
  max-width: 100%;
  overflow: hidden;
}

.linked-jobs-variant .multi-select-chip span:first-child {
  color: var(--text);
  font-weight: 500;
  font-size: var(--fs-sm);
  white-space: nowrap;
}

.linked-jobs-variant .multi-select-chip-description {
  color: var(--text);
  font-size: var(--fs-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}



.report-overview-link-card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  width: 100%;
  padding: 0.85rem 1rem;
  border: none;
  border-radius: var(--radius);
  background: var(--surface-raised);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

@media (hover: hover) {
.report-overview-link-card:hover {
  background: var(--surface-elevated);
}
}

.report-overview-link-card .report-overview-top-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  min-width: 0;
}

.report-overview-link-card .job-number {
  flex-shrink: 0;
}

.report-overview-link-card .report-overview-customer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
}

.report-overview-link-card .report-overview-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.report-overview-link-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.report-overview-timesheet-list {
  margin-bottom: 0.75rem;
}

@media (max-width: 640px) {
  .report-overview-toolbar {
    width: 100%;
  }

  .report-overview-actions {
    width: auto;
    margin-left: 0;
  }

  .report-overview-actions--left {
    margin-left: auto;
  }

  .attestation-control-list.compact {
    grid-template-columns: 1fr;
  }
}


.spin {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ------------------------------------------------------------
   Card top: SAG-id + customer name (left), status pill (right)
   ------------------------------------------------------------ */
.job-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  min-width: 0;
}

.job-card-top > * {
  min-width: 0;
}

.job-card-top-center {
  align-items: center;
  gap: 0.5rem;
}

.customer-card-identity {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.customer-card-identity .customer-number {
  font-size: var(--fs-xs);
}

.job-card-top .customer-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-top .customer-icon {
  flex-shrink: 0;
}

.job-card-top .customer-job-count {
  flex-shrink: 0;
}

.job-number {
  display: inline-block;
  font-family: var(--font-main);
  font-size: var(--fs-xs);
  font-weight: 400;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 0.3rem;
  white-space: nowrap;
}

.job-number-sep {
  margin: 0 0.35rem;
  opacity: 0.5;
}

.job-number-status {
  font-weight: 500;
}

.review-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #eab308;
  margin-left: 6px;
  vertical-align: middle;
  position: relative;
  top: -1px;
}

.unread-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3b82f6;
  margin-left: 6px;
  vertical-align: middle;
  position: relative;
  top: -1px;
}

.unassigned-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3b82f6;
  margin-left: 6px;
  vertical-align: middle;
  position: relative;
  top: -1px;
}

.approved-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  margin-left: 6px;
  vertical-align: middle;
  position: relative;
  top: -1px;
}

.rejected-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ef4444;
