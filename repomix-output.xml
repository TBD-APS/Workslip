  border-top: 2px solid var(--border);
}

.admin-row-total td {
  padding: 0.5rem 0.5rem;
  text-align: center;
  border-right: 1px solid var(--border);
  background: var(--surface-raised);
  color: var(--text);
  font-weight: 600;
  font-size: 0.8rem;
}

.admin-row-total .admin-col-name {
  text-align: left;
  border-right: 1px solid var(--border);
}

.admin-row-total td:last-child {
  border-right: none;
}

@media (min-width: 768px) {
  .admin-week-title {
    padding: 1rem 1.25rem;
  }

  .admin-week-title h3 {
    font-size: var(--fs-lg);
  }

