    public static JobLinkViewModel ToLink(JobLinkResponse link) => new(
        link.Id,
        link.ReportId,
        link.LinkedReportId,
        link.LinkedReportNumber,
        link.LinkedCustomerName,
        link.LinkedStatus);

    public static List<JobLinkViewModel> ToLinkList(IReadOnlyList<JobLinkResponse> links) =>
