  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem;
  color: var(--text-primary);
  font: inherit;
  text-align: left;
  background: transparent;
  border: 0;
  cursor: pointer;
}

.collapsible-section-trigger:hover {
  background: rgba(255, 255, 255, 0.03);
}

.collapsible-chevron {
  flex-shrink: 0;
  color: var(--text-secondary);
  transition: transform 0.2s;
}

.collapsible-chevron.open {
  transform: rotate(90deg);
}

.collapsible-section-content {
  padding: 0 1.25rem 1.25rem;
}

.detail-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(14px);
}

.modal-card {
  width: min(100%, 420px);
  padding: 1.4rem;
  background: #111827;
  border: none;
  border-radius: 18px;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
}

.modal-card h3 {
  margin: 0 0 0.45rem;
  font-size: 1.25rem;
}

.modal-card p {
  margin: 0;
  color: var(--text-secondary);
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.work-category-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.work-field-group {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.work-field-label {
  color: var(--text-secondary);
  font-size: 0.78rem;
  font-weight: 400;
  letter-spacing: 0.08em;
}

.category-choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.7rem;
}

.choice-card {
  position: relative;
  overflow: hidden;
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.85rem 0.95rem 0.85rem 1rem;
  color: var(--text-primary);
  font: inherit;
  font-weight: 400;
  text-align: left;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid transparent;
  border-radius: 14px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, transform 0.15s;
}

.choice-card:active {
  transform: scale(0.98);
}

.choice-card.selected {
  background: var(--surface-selected);
}

.choice-card.selected::before,
.multi-select-option.selected::before,
.work-kind-option.selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: rgba(96, 165, 250, 0.85);
}

/* Afslutning — invalid steps warning */
.invalid-steps-warning {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  padding: 1rem 1.1rem;
  margin-bottom: 1.25rem;
  border-radius: 12px;
  background: rgba(234, 88, 12, 0.10);
  border: 1px solid rgba(234, 88, 12, 0.28);
}

.invalid-steps-warning .warning-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  color: #fdba74;
  font-size: 0.88rem;
  font-weight: 500;
  line-height: 1.4;
}

.invalid-steps-warning .warning-title svg {
  flex-shrink: 0;
  color: #fb923c;
}

.invalid-steps-links {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.invalid-step-btn {
  width: 100%;
  justify-content: flex-start;
  padding: 0.7rem 1.1rem;
  font-size: 0.88rem;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.04);
  text-align: left;
}

.invalid-step-btn:hover {
  background: rgba(255, 255, 255, 0.08);
}

.work-kind-list {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.work-kind-option {
  position: relative;
  overflow: hidden;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid transparent;
  border-radius: 12px;
  color: var(--text-primary);
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s;
}

.work-kind-option.selected {
  background: var(--surface-selected);
}

.work-kind-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.form-help-error {
  color: #f87171;
  font-size: 0.78rem;
}

.multi-select-field {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.multi-select-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.multi-select-dropdown {
  position: relative;
}

.multi-select-trigger {
  width: 100%;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem;
  color: var(--text-primary);
  font: inherit;
  text-align: left;
  background: var(--surface-input);
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
}

.multi-select-trigger:hover:not(:disabled),
.multi-select-trigger[aria-expanded="true"] {
  background: var(--surface-elevated);
}

.multi-select-trigger:disabled {
  cursor: wait;
  opacity: 0.65;
}

.multi-select-trigger-content {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-width: 0;
}

.multi-select-chevron {
  flex-shrink: 0;
  color: var(--text-secondary);
  transition: transform 0.2s;
}

.multi-select-chevron.open {
  transform: rotate(90deg);
}

.multi-select-menu {
  position: absolute;
  z-index: 20;
  top: calc(100% + 0.4rem);
  left: 0;
  right: 0;
  max-height: 260px;
  overflow-y: auto;
  padding: 0.35rem;
  background: #111827;
  border: none;
  border-radius: 14px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
}

.multi-select-menu::-webkit-scrollbar {
  width: 5px;
}

.multi-select-menu::-webkit-scrollbar-track {
  background: transparent;
}

.multi-select-menu::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 10px;
}

.multi-select-menu::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

.multi-select-search {
  padding: 0.15rem;
  margin-bottom: 0.2rem;
  background: #111827;
}

.multi-select-search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0.55rem 0.75rem;
  color: var(--text-primary);
  font: inherit;
  font-size: 0.85rem;
  background: rgba(255, 255, 255, 0.05);
  border: none;
  border-radius: 10px;
  outline: none;
  transition: border-color 0.15s;
}

.multi-select-search-input::placeholder {
  color: var(--text-secondary);
}

.multi-select-search-input:focus {
  border-color: rgba(96, 165, 250, 0.5);
}

.multi-select-option {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem 0.75rem 1rem;
  color: var(--text-primary);
  font: inherit;
  text-align: left;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid transparent;
  border-radius: 12px;
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s;
}

.multi-select-option:hover {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.045);
}

.multi-select-option.selected {
  border-color: rgba(96, 165, 250, 0.42);
  background: rgba(37, 99, 235, 0.08);
}

.selection-pill {
  flex-shrink: 0;
  margin-left: auto;
  padding: 0.16rem 0.45rem;
  color: #bfdbfe;
  font-size: 0.72rem;
  font-weight: 400;
  letter-spacing: 0.03em;
  line-height: 1.2;
  border: 1px solid rgba(96, 165, 250, 0.26);
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.12);
}

.multi-select-option-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.multi-select-option-text small {
  color: var(--text-secondary);
  font-size: 0.75rem;
  white-space: pre-line;
  line-height: 1.3;
}

.multi-select-menu-empty {
  margin: 0;
  padding: 0.85rem;
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.multi-select-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.multi-select-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.22rem 0.35rem 0.22rem 0.6rem;
  color: #bfdbfe;
  font: inherit;
  background: rgba(96, 165, 250, 0.12);
  border: 1px solid rgba(96, 165, 250, 0.16);
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 400;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
}

.multi-select-chip:hover {
  background: rgba(96, 165, 250, 0.18);
  border-color: rgba(96, 165, 250, 0.28);
}

.multi-select-chip-remove {
  width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: rgba(191, 219, 254, 0.85);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  font-size: 0.9rem;
  line-height: 1;
}

.multi-select-chip:hover .multi-select-chip-remove {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}

.multi-select-empty {
  color: var(--text-secondary);
  font-size: 0.8rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.form-label {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.03em;
}

.form-input-invalid {
  border-color: rgba(239, 68, 68, 0.75);
}

.form-input-invalid:focus {
  border-color: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
}

.form-error-text {
  margin: 0.1rem 0 0;
  color: #f87171;
  font-size: 0.78rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-textarea {
  resize: vertical;
  min-height: 100px;
  font-family: var(--font-main);
  line-height: 1.5;
}

.btn-save {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  margin-top: 0.5rem;
}

.btn-save:disabled {
  opacity: 0.7;
  cursor: wait;
}

/* ------------------------------------------------------------
   Step indicators (stepper)
   ------------------------------------------------------------ */
.step-indicators {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.15rem;
  overflow-x: auto;
  padding-bottom: 0.25rem;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

.step-dot {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 46px;
  padding: 0.6rem 0.9rem;
  border-radius: 14px;
  border: 1px solid transparent;
  background: rgba(255, 255, 255, 0.035);
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 0.84rem;
  white-space: nowrap;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
}

.step-dot.active {
  color: var(--text-primary);
  background: var(--surface-selected-strong);
  box-shadow: 0 10px 26px rgba(37, 99, 235, 0.18);
}

.step-dot.completed {
  background: var(--surface-selected);
  color: #93c5fd;
}

.step-dot.completed:not(.active) {
  opacity: 0.82;
}

.step-label {
  font-weight: 400;
}

/* ------------------------------------------------------------
   Step navigation (prev / next buttons)
   ------------------------------------------------------------ */
.step-nav {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: var(--surface-card);
  border: none;
  border-radius: 16px;
}

.step-nav-sticky {
  position: sticky;
  bottom: 1rem;
  z-index: 15;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.step-nav-status-slot {
  display: flex;
  justify-content: center;
  margin-bottom: 0.5rem;
  pointer-events: none;
}

.step-nav-sticky .step-nav {
  backdrop-filter: blur(18px);
}

.step-nav-sticky.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(calc(100% + 1.5rem));
}

.step-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.25rem;
  font: inherit;
  font-size: 0.85rem;
  font-weight: 400;
  border: 0;
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
}

.step-nav-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-secondary);
  box-shadow: none;
}

.step-nav-btn:disabled:hover {
  background: rgba(255, 255, 255, 0.04);
  transform: none;
}

.step-nav-btn-back {
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.06);
}

.step-nav-btn-back:not(:disabled):hover {
  background: rgba(255, 255, 255, 0.1);
}

.step-nav-btn-next {
  margin-left: auto;
  color: #fff;
  background: rgba(96, 165, 250, 0.2);
}

.step-nav-btn-next--wide {
  flex: 1;
  justify-content: center;
  min-width: 12rem;
}

.step-nav-btn-next:not(:disabled):hover {
  background: rgba(96, 165, 250, 0.35);
}

.step-nav-counter {
  font-size: 0.78rem;
  color: var(--text-secondary);
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

.control-points-list {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.control-point-type + .control-point-type {
  margin-top: 1.25rem;
}

.control-point-type {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
  padding: 0.75rem;
}

.control-point-type.collapsed {
  padding-bottom: 0.5rem;
}

.control-point-type-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  padding: 0;
  font: inherit;
  margin-bottom: 0.75rem;
  text-align: left;
}

.control-point-type.collapsed .control-point-type-header {
  margin-bottom: 0;
}

.control-point-chevron {
  flex-shrink: 0;
  color: var(--text-secondary);
  transition: transform 0.2s ease;
}

.control-point-chevron.open {
  transform: rotate(90deg);
}

.control-point-type-name {
  font-size: 1rem;
  font-weight: 400;
}

.control-point-type-body {
  padding-left: 0;
}

.control-point-category-group + .control-point-category-group {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.control-point-category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.25rem;
}

.control-point-category-label {
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.control-point-category-group.irrelevant .control-point-category-label {
  color: var(--text-disabled, rgba(255, 255, 255, 0.4));
}

.multi-select-option.control-point-irrelevant-row {
  min-height: 42px;
  padding: 0.6rem 0.8rem 0.6rem 1rem;
  margin-bottom: 0;
  color: var(--text-secondary);
}

.multi-select-option.control-point-irrelevant-row:hover {
  color: var(--text-primary);
}

.irrelevant-text {
  font-size: 0.75rem;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  white-space: nowrap;
}

.irrelevant-label {
  display: none;
}

.multi-select-option:disabled {
  opacity: 0.4;
  cursor: default;
}

.multi-select-option:disabled:hover {
  background: rgba(255, 255, 255, 0.025);
}

.multi-select-option.selected:disabled:hover {
  background: rgba(37, 99, 235, 0.08);
}

@media (min-width: 768px) {
  .app-shell {
    flex-direction: row;
  }
  
  .bottom-nav {
    display: none;
  }
  
  .app-content {
    padding-bottom: 1.5rem;
  }
}

/* Validation error */
.validation-error {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  margin-bottom: 1rem;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 10px;
  color: #fca5a5;
  font-size: 0.9rem;
}

/* ------------------------------------------------------------
   Worksheet list (Job step 4)
   ------------------------------------------------------------ */
.worksheet-section-header {
  flex-wrap: wrap;
}

.worksheet-section-header-totals {
  margin-left: auto;
  color: var(--text-secondary);
  font-size: 0.82rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

.worksheet-section-header-totals strong {
  color: var(--text-primary);
  font-weight: 500;
}

.worksheet-list-label {
  display: block;
  margin: 0 0 0.5rem 0;
  padding-left: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.worksheet-list {
  list-style: none;
  margin: 0 0 0.75rem 0;
  padding: 0.35rem;
  background: rgba(17, 24, 39, 0.6);
  border: none;
  border-radius: 14px;
  max-height: 280px;
  overflow-y: auto;
}

.worksheet-list.expanded {
  max-height: none;
  overflow: visible;
}

.worksheet-empty-state {
  margin-bottom: 0.75rem;
}

.worksheet-list::-webkit-scrollbar {
  width: 5px;
}

.worksheet-list::-webkit-scrollbar-track {
  background: transparent;
}

.worksheet-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 10px;
}

.worksheet-list::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

.worksheet-list-item {
  padding: 0.45rem 0.6rem;
  border-radius: 10px;
}

.worksheet-list-item-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-height: 36px;
}

.worksheet-list-item-metrics {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.worksheet-list-item-hours {
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
  gap: 0.2rem;
  min-width: 4.25rem;
  padding: 0.2rem 0.55rem;
  border: 1px solid rgba(96, 165, 250, 0.18);
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.08);
  color: #bfdbfe;
  white-space: nowrap;
}

.worksheet-list-item-hours-value {
  color: var(--text-primary);
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 400;
}

.worksheet-list-item-hours span:not(.worksheet-list-item-hours-value),
.worksheet-list-item-outlay {
  font-size: 0.68rem;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.worksheet-list-item-outlay {
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.12);
  color: #93c5fd;
  white-space: nowrap;
}

.worksheet-list-item.editing {
  background: rgba(255, 255, 255, 0.04);
}

.worksheet-list-item.editing .worksheet-form {
  margin-top: 0.75rem;
  width: 100%;
  background: rgba(0, 0, 0, 0.28);
}

.worksheet-list-item + .worksheet-list-item {
  margin-top: 0.15rem;
}

.worksheet-list-item:hover {
  background: rgba(255, 255, 255, 0.04);
}

.worksheet-list-item-actions {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.worksheet-actions-menu-root {
  position: relative;
}

.worksheet-actions-menu-root .btn-icon {
  min-width: 40px;
  min-height: 40px;
  border: 1px solid transparent;
}

.worksheet-actions-menu-root .btn-icon:hover,
.worksheet-actions-menu-root .btn-icon[aria-expanded="true"] {
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.07);
  color: var(--text-primary);
}

.worksheet-actions-menu {
  position: fixed;
  z-index: 1000;
  min-width: 8.5rem;
  padding: 0.25rem;
  background: #111827;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
}

.worksheet-actions-menu button {
  width: 100%;
  min-height: 2.25rem;
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.45rem 0.65rem;
  color: var(--text-primary);
  font: inherit;
  font-size: 0.85rem;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 9px;
  cursor: pointer;
}

.worksheet-actions-menu button:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.07);
}

.worksheet-actions-menu button.danger {
  color: #f87171;
}

.worksheet-actions-menu button:disabled {
  opacity: 0.45;
  cursor: default;
}

.worksheet-list-item-info {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  flex: 1;
  min-width: 0;
}

.worksheet-list-item-date {
  font-weight: 400;
  color: var(--text-primary);
  font-size: 0.92rem;
  line-height: 1.2;
}

.worksheet-list-item-meta {
  font-size: 0.78rem;
  color: var(--text-secondary);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.worksheet-form {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 0.85rem 0.85rem 0.85rem 1rem;
  background: var(--surface-selected);
  border: none;
  border-radius: 12px;
  position: relative;
}

.worksheet-form::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12px;
  bottom: 12px;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: rgba(96, 165, 250, 0.7);
}

.worksheet-form h4 {
  margin: 0 0 0.1rem 0;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.01em;
}

.worksheet-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.55rem;
}

.worksheet-form .form-input,
.worksheet-form .multi-select-trigger {
  min-height: 40px;
}

.worksheet-form .form-label {
  font-size: 0.72rem;
  margin-bottom: 0.2rem;
}

.worksheet-form-grid .multi-select-field {
  min-width: 0;
}

.worksheet-form-grid-main .multi-select-chips {
  margin-top: 0.15rem;
}

.worksheet-form-grid-hours {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  margin-top: 0;
}

.worksheet-overnight-wrapper {
  align-self: end;
  min-width: 8rem;
}

@media (min-width: 640px) {
  .worksheet-form-grid-main {
    grid-template-columns: 0.8fr 1.2fr;
  }
}

/* ------------------------------------------------------------
   Calendar picker
   ------------------------------------------------------------ */
.calendar-picker-field {
  position: relative;
}

.calendar-picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  cursor: pointer;
}

.calendar-picker-popover {
  position: absolute;
  z-index: 25;
  top: calc(100% + 0.4rem);
  left: 0;
  width: min(19rem, calc(100vw - 3rem));
  padding: 0.75rem;
  background: #111827;
  border: none;
  border-radius: 14px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
}

.calendar-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.65rem;
  color: var(--text-primary);
  font-weight: 400;
  text-transform: capitalize;
}

.calendar-picker-weekdays,
.calendar-picker-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.25rem;
}

.calendar-picker-weekdays {
  margin-bottom: 0.35rem;
  color: var(--text-secondary);
  font-size: 0.7rem;
  text-align: center;
}

.calendar-picker-day {
  min-height: 2rem;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--text-primary);
  cursor: pointer;
}

.calendar-picker-day:hover,
.calendar-picker-day.selected {
  background: var(--accent-color);
  color: white;
}

.worksheet-overnight-wrapper .multi-select-option {
  min-height: 40px;
  width: 100%;
}

.worksheet-form-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0;
  width: 100%;
}

.worksheet-form-actions .btn {
  white-space: nowrap;
  min-height: 38px;
  padding: 0.4rem 0.85rem;
  font-size: 0.85rem;
}

.worksheet-form-actions .btn-primary {
  flex: 2 1 0;
  min-height: 38px;
}

.worksheet-form-actions .btn-secondary {
  flex: 1 1 0;
}

.worksheet-add-trigger {
  width: fit-content;
  min-height: 36px;
  padding: 0.4rem 0.9rem;
  font-size: 0.82rem;
  font-weight: 500;
}

.worksheet-add-trigger-cta {
  width: 100%;
  min-height: 46px;
  padding: 0.65rem 1rem;
  font-size: 0.92rem;
  font-weight: 500;
  margin-top: 0.25rem;
}

/* ------------------------------------------------------------
   Attestation (Job step 5)
   ------------------------------------------------------------ */
.attestation-hero-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-status {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: 14px;
  background: rgba(250, 204, 21, 0.08);
  color: #facc15;
}

.attestation-status.submitted {
  background: rgba(37, 99, 235, 0.08);
  color: #93c5fd;
}

.attestation-status div {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.attestation-status-title {
  color: var(--text-primary);
  font-family: var(--font-heading);
  font-size: 0.98rem;
}

.attestation-status span:not(.attestation-status-title) {
  color: var(--text-secondary);
  font-size: 0.88rem;
}

.attestation-compact-header {
  margin-bottom: 0.65rem;
}

.attestation-timesheet-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.attestation-timesheet-totals {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  margin-top: 0.85rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.attestation-timesheet-totals span {
  display: inline-flex;
  align-items: baseline;
  gap: 0.4rem;
  white-space: nowrap;
}

.attestation-timesheet-totals strong {
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 400;
}

.attestation-timesheet-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 0;
  margin: 0;
  list-style: none;
}

.attestation-timesheet-list li {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem 0.65rem 1rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
}

.attestation-timesheet-list li::before {
  content: '';
  position: absolute;
  top: 12px;
  bottom: 12px;
  left: 0;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: rgba(96, 165, 250, 0.6);
}

.attestation-timesheet-main {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.15rem;
}

.attestation-timesheet-date {
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 400;
}

.attestation-timesheet-user {
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 0.78rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attestation-timesheet-hours {
  display: inline-flex;
  align-items: baseline;
  gap: 0.3rem;
  min-width: 4.5rem;
  justify-content: center;
  padding: 0.35rem 0.6rem;
  border-radius: 10px;
  background: rgba(37, 99, 235, 0.12);
  color: #bfdbfe;
}

.attestation-timesheet-hours-value {
  color: var(--text-primary);
  font-size: 0.95rem;
  font-weight: 400;
}

.attestation-timesheet-hours-unit,
.attestation-timesheet-badge {
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--text-secondary);
}

.attestation-timesheet-badge {
  padding: 0.3rem 0.5rem;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.16);
  color: #93c5fd;
  white-space: nowrap;
}

.attestation-data-list {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.4rem 1.25rem;
  align-items: baseline;
  margin: 0;
}

.attestation-data-pair {
  display: contents;
}

.attestation-data-pair dt {
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 400;
}

.attestation-data-pair dd {
  margin: 0;
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 400;
  word-break: break-word;
}

.attestation-observations-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin: 0.85rem 0 0;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.attestation-observations-list .attestation-data-pair {
  display: grid;
  grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr);
  gap: 0.25rem 1.25rem;
  align-items: baseline;
}

.attestation-observations-list .attestation-data-pair dd {
  white-space: pre-wrap;
  line-height: 1.5;
}

.attestation-control-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 0;
  margin: 0;
  list-style: none;
}

.attestation-control-list.compact {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  gap: 0.4rem;
}

.attestation-control-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
}

.attestation-control-list.compact li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  column-gap: 0.45rem;
  row-gap: 0.1rem;
  align-items: start;
  padding: 0.5rem 0.65rem;
  border-radius: 10px;
}

.attestation-control-list.compact small {
  grid-column: 2;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 0.72rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attestation-control-accent {
  width: 3px;
  align-self: stretch;
  min-height: 1.9rem;
  border-radius: 999px;
  background: rgba(96, 165, 250, 0.78);
}

.attestation-control-accent.muted {
  background: rgba(245, 158, 11, 0.7);
}

.attestation-control-list-item-muted {
  opacity: 0.85;
}

.attestation-control-list-item-muted span {
  color: var(--text-secondary);
}

.attestation-control-list div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-control-list-title {
  color: var(--text-primary);
  font-size: 0.9rem;
}

.attestation-control-list span {
  color: var(--text-secondary);
  font-size: 0.78rem;
}

.attestation-irrelevant-block {
  margin-top: 0.85rem;
}

.attestation-irrelevant-label {
  display: block;
  margin-bottom: 0.4rem;
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 400;
}

.attestation-irrelevant-block .attestation-control-list.compact {
  margin-top: 0.4rem;
}

.attestation-confirm-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.attestation-validation-error {
  align-items: flex-start;
}

.attestation-validation-title {
  display: block;
  margin-bottom: 0.35rem;
}

.attestation-validation-error ul {
  padding-left: 1rem;
  margin: 0;
}

.attestation-confirm-card {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  padding: 1.4rem 1.5rem;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(96, 165, 250, 0.32);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
}

.attestation-confirm-card-header {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}

.attestation-confirm-card-icon {
  flex-shrink: 0;
  margin-top: 0.15rem;
  color: #60a5fa;
}

.attestation-confirm-card-heading {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 0;
}

.attestation-confirm-card-title {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.attestation-confirm-card-subtitle {
  margin: 0;
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.45;
}

.attestation-confirm-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.9rem 1rem;
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 12px;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.attestation-confirm-row:hover {
  background: rgba(255, 255, 255, 0.055);
  border-color: rgba(96, 165, 250, 0.28);
}

.attestation-confirm-row.confirmed {
  background: rgba(37, 99, 235, 0.10);
  border-color: rgba(96, 165, 250, 0.38);
}

.attestation-confirm-row.disabled {
  cursor: default;
  opacity: 0.65;
}

.attestation-confirm-row.disabled:hover {
  background: rgba(255, 255, 255, 0.035);
  border-color: rgba(255, 255, 255, 0.10);
}

.attestation-confirm-row.confirmed.disabled:hover {
  background: rgba(37, 99, 235, 0.10);
  border-color: rgba(96, 165, 250, 0.38);
}

.attestation-confirm-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-confirm-label {
  color: var(--text-primary);
  font-size: 0.95rem;
  line-height: 1.35;
}

.attestation-confirm-description {
  color: var(--text-secondary);
  font-size: 0.8rem;
  line-height: 1.4;
}

.attestation-confirm-row input {
  position: relative;
  flex: 0 0 auto;
  width: 1.25rem;
  height: 1.25rem;
  margin: 0.05rem 0 0;
  appearance: none;
  -webkit-appearance: none;
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(148, 163, 184, 0.55);
  border-radius: 6px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.attestation-confirm-row input:checked {
  background: #2563eb;
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.16);
}

.attestation-confirm-row input:checked::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 46%;
  width: 0.32rem;
  height: 0.62rem;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: translate(-50%, -50%) rotate(45deg);
  transform-origin: center;
}

.attestation-confirm-row input:focus-visible {
  outline: 2px solid rgba(96, 165, 250, 0.75);
  outline-offset: 2px;
}

.attestation-confirm-row input:disabled {
  cursor: default;
}

.attestation-submit-row {
  display: flex;
}

.attestation-submit-button {
  width: 100%;
  min-height: 48px;
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  border-radius: 12px;
  flex: 1 1 auto;
  justify-content: center;
}

.attestation-submit-button-locked {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  border: 1px dashed rgba(255, 255, 255, 0.16);
  box-shadow: none;
  cursor: not-allowed;
}

.attestation-submit-button-locked:hover {
  background: rgba(255, 255, 255, 0.05);
  transform: none;
  box-shadow: none;
}

.attestation-submitted-badge {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.9rem 1.1rem;
  border-radius: 12px;
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.32);
  color: #86efac;
}

.attestation-submitted-badge > div {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.attestation-submitted-badge-title {
  font-size: 0.95rem;
  font-weight: 500;
  color: #bbf7d0;
}

.attestation-submitted-badge-subtitle {
  font-size: 0.8rem;
  color: rgba(134, 239, 172, 0.85);
  line-height: 1.4;
}

@media (max-width: 640px) {
  .attestation-summary-grid {
    grid-template-columns: 1fr;
  }

  .attestation-timesheet-heading {
    flex-direction: column;
  }

  .attestation-timesheet-totals {
    justify-content: flex-start;
  }

  .attestation-timesheet-list li {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .attestation-timesheet-badge {
    grid-column: 1 / -1;
    width: fit-content;
  }

  .worksheet-list {
    max-height: 320px;
  }

  .worksheet-list-item {
    padding: 0.3rem 0.5rem;
  }

  .worksheet-list-item-row {
    flex-wrap: nowrap;
    gap: 0.45rem;
    min-height: 32px;
  }

  .worksheet-list-item-info {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.3rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .worksheet-list-item-date {
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .worksheet-list-item-meta {
    font-size: 0.72rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .worksheet-list-item-metrics {
    flex: 0 0 auto;
    gap: 0.35rem;
  }

  .worksheet-list-item-hours {
    min-width: 3.4rem;
    padding: 0.12rem 0.45rem;
    gap: 0.15rem;
  }

  .worksheet-list-item-hours-value {
    font-size: 0.85rem;
  }

  .worksheet-list-item-hours span:not(.worksheet-list-item-hours-value),
  .worksheet-list-item-outlay {
    font-size: 0.62rem;
  }

  .worksheet-list-item-outlay {
    padding: 0.1rem 0.4rem;
  }

  .worksheet-list-item-actions .btn-icon {
    min-width: 32px;
    min-height: 32px;
  }

  .worksheet-total-card {
    padding: 0.8rem;
  }

  .attestation-submit-button {
    width: 100%;
  }
}

/* ------------------------------------------------------------
   Submission confirmation
   ------------------------------------------------------------ */
.submitted-confirmation {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 3rem 1.5rem;
  text-align: center;
}

.submitted-confirmation-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--surface-selected-strong);
  color: #60a5fa;
  margin-bottom: 0.5rem;
}

.submitted-confirmation-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.submitted-confirmation-body {
  margin: 0;
  max-width: 36rem;
  color: var(--text-secondary);
  font-size: 1rem;
  line-height: 1.5;
}

.submitted-confirmation-button {
  margin-top: 0.75rem;
  min-width: 12rem;
}

.job-details-header-spacer {
  height: 0;
}

.btn-icon-back {
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border-radius: 50%;
  transition: all 0.2s;
  margin-right: 0.25rem;
}

.btn-icon-back:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

.section-title {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-secondary);
  margin: 1rem 0 0.5rem;
  letter-spacing: 0.02em;
}

.user-detail-info {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1rem 1.25rem;
  background: var(--surface-card);
  border-radius: 12px;
  margin-bottom: 0.5rem;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--text-primary);
  font-size: 0.9rem;
}

.detail-row svg {
  flex-shrink: 0;
  color: var(--text-secondary);
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0.65rem 0.75rem 0.65rem 2.2rem;
  color: var(--text-primary);
  font: inherit;
  font-size: 0.9rem;
  background: var(--surface-card);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  outline: none;
  transition: border-color 0.15s;
}

.search-input::placeholder {
  color: var(--text-secondary);
}

.search-input:focus {
  border-color: rgba(96, 165, 250, 0.5);
}

.search-input-icon {
  position: absolute;
  left: 0.7rem;
  color: var(--text-secondary);
  pointer-events: none;
}

.search-input-clear {
  position: absolute;
  right: 0.4rem;
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  border-radius: 50%;
  transition: color 0.15s, background 0.15s;
}

.search-input-clear:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.08);
}

.search-bar-spacer {
  margin-bottom: 1rem;
}

.search-input-icon {
  position: absolute;
  left: 0.65rem;
  color: var(--text-secondary);
  pointer-events: none;
}

.job-card--disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.meta-item--success {
  color: #22c55e;
}

.meta-item--muted {
  color: var(--text-secondary);
}

.meta-item--action {
  color: var(--text-primary);
  font-weight: 500;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

@media (max-width: 640px) {
  .app-header-user {
    display: none;
  }

  .app-header-logout span {
    display: none;
  }

  .app-header-logout {
    padding: 0.5rem;
  }
}

.edit-form-bottom-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 2rem;
}

.edit-form-bottom-btn {
  flex: 1;
  gap: 0.5rem;
}

.edit-form-bottom-actions .btn-primary {
  flex: 1.5;
}

.invite-send-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  margin-top: 1rem;
}

.invite-send-btn:disabled {
  opacity: 0.35;
  background: #4b5563;
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
}

/* Settings / Invite UI */
.section-card {
  background: var(--surface-card);
  border-radius: 16px;
  padding: 1.25rem;
}

.section-card-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1rem;
  font-weight: 500;
  margin: 0 0 1rem;
  color: var(--text-primary);
}

.invite-input-row {
  display: flex;
  gap: 0.5rem;
}

.invite-add-btn {
  flex-shrink: 0;
  padding: 0.75rem 1rem;
}

.invite-email-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-top: 0.75rem;
}

.invite-email-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0.75rem;
  background: var(--surface-elevated);
  border-radius: 10px;
  font-size: 0.9rem;
}

.invite-status-list {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.invite-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.65rem 0.75rem;
  background: var(--surface-elevated);
  border-radius: 10px;
  font-size: 0.85rem;
}

.invite-status-left {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-width: 0;
}

.invite-status-email {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
}

.invite-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  font-size: 0.72rem;
  white-space: nowrap;
  flex-shrink: 0;
}

.invite-status-badge.status-sent {
  background: rgba(96,165,250,0.12);
  color: #93c5fd;
}

.invite-status-badge.status-opened {
  background: rgba(251,191,36,0.12);
  color: #fcd34d;
}

.invite-status-badge.status-accepted {
  background: rgba(52,211,153,0.12);
  color: #6ee7b7;
}

.invite-status-badge.status-expired {
  background: rgba(248,113,113,0.12);
  color: #fca5a5;
}

.invite-status-date {
  color: var(--text-secondary);
  font-size: 0.78rem;
  flex-shrink: 0;
  margin-left: 0.5rem;
}

/* ------------------------------------------------------------
   My worksheets monthly overview
   ------------------------------------------------------------ */
.time-overview-page {
  max-width: 1100px;
}

.time-overview-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.time-month-controls {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
}

.time-month-switcher {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.35rem;
  border: 1px solid var(--surface-border);
  border-radius: 999px;
  background: var(--surface-card);
  color: var(--text-primary);
  text-transform: capitalize;
  white-space: nowrap;
}

.time-month-switcher span {
  min-width: 9rem;
  text-align: center;
  font-size: 0.9rem;
}

.time-month-button {
  width: 2rem;
  height: 2rem;
  border-radius: 999px;
}

.time-today-button {
  padding: 0.4rem 0.8rem;
  border: 1px solid rgba(96, 165, 250, 0.35);
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.1);
  color: #bfdbfe;
  font: inherit;
  font-size: 0.82rem;
  cursor: pointer;
}

.time-today-button:disabled {
  opacity: 0.45;
  cursor: default;
}

.time-summary-grid {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.35rem;
  width: 100%;
}

.time-summary-card {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.22rem 0.55rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.time-summary-card > div {
  display: inline-flex;
  align-items: center;
  gap: 0.28rem;
}

.time-summary-card span {
  display: inline-flex;
  color: var(--text-secondary);
  font-size: 0.68rem;
}

.time-summary-card strong {
  display: inline-flex;
  color: var(--text-primary);
  font-size: 0.78rem;
  font-weight: 400;
}

.time-summary-icon {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: 1.1rem;
  height: 1.1rem;
  border-radius: 999px;
  color: #93c5fd !important;
  background: transparent;
}

.time-week-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.time-week-card {
  padding: 1rem;
  border-radius: 18px;
  background: var(--surface-card);
  border: 1px solid var(--surface-border);
}

.time-week-card:not(.is-expanded) .time-week-header {
  margin-bottom: 0;
}

.time-week-skeleton {
  min-height: 220px;
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.time-week-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.85rem;
}

.time-week-header h3 {
  margin: 0;
  color: var(--text-primary);
  font-size: 1rem;
}

.time-week-totals {
  display: inline-flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
  color: var(--text-secondary);
  font-size: 0.82rem;
}

.time-week-totals span {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.55rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
}

.time-week-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.6rem;
  border: 1px solid rgba(96, 165, 250, 0.3);
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.12);
  color: #bfdbfe;
  font: inherit;
  font-size: 0.82rem;
  cursor: pointer;
}

.time-week-toggle svg {
  transition: transform 0.16s ease;
}

.time-week-card.is-expanded .time-week-toggle svg {
  transform: rotate(180deg);
}

.time-day-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.5rem;
}

.time-day-cell {
  min-height: 132px;
  padding: 0.65rem;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.025);
}

.time-day-cell.muted {
  opacity: 0.42;
}

.time-day-cell.has-entries {
  background: rgba(37, 99, 235, 0.08);
  border-color: rgba(96, 165, 250, 0.22);
}

.time-day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.55rem;
  color: var(--text-secondary);
  font-size: 0.76rem;
  text-transform: capitalize;
}

.time-day-head strong {
  color: #bfdbfe;
  font-size: 0.78rem;
  white-space: nowrap;
}

.time-entry-list {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.time-entry-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 0.25rem;
  padding: 0.55rem;
  border: 1px solid transparent;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.22);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.time-entry-card:hover,
.time-entry-card:focus-visible {
  border-color: rgba(96, 165, 250, 0.3);
  background: rgba(37, 99, 235, 0.16);
  outline: none;
}

.time-entry-top,
.time-entry-meta,
.time-entry-address,
.time-entry-outlay {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.time-entry-top {
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 0.72rem;
}

.time-entry-meta {
  justify-content: flex-end;
  gap: 0.35rem;
  white-space: nowrap;
}

.time-entry-card strong {
  color: var(--text-primary);
  font-size: 0.84rem;
  font-weight: 400;
  line-height: 1.25;
}

.time-entry-address {
  color: var(--text-secondary);
  font-size: 0.72rem;
  line-height: 1.25;
}

.time-entry-outlay {
  padding: 0.12rem 0.4rem;
  border-radius: 999px;
  color: #fcd34d;
  background: rgba(251, 191, 36, 0.12);
  font-size: 0.7rem;
}

@media (max-width: 900px) {
  .time-day-grid {
    grid-template-columns: 1fr;
  }

  .time-day-cell {
    min-height: auto;
  }
}

@media (max-width: 640px) {
  .time-overview-header {
    flex-direction: column;
  }

  .time-month-controls,
  .time-month-switcher,
  .time-summary-grid {
    width: 100%;
  }

  .time-month-controls {
    align-items: stretch;
  }

  .time-month-switcher {
    justify-content: space-between;
  }

  .time-summary-grid {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .time-week-header {
    flex-direction: column;
  }

  .time-week-totals {
    justify-content: flex-start;
  }
}

/* Job History Drawer */
.drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.drawer-overlay.open {
  opacity: 1;
  visibility: visible;
}

.drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 100%;
  max-width: 450px;
  height: 100%;
  background: var(--bg-color);
  z-index: 1001;
  box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.drawer.open {
  right: 0;
}

.drawer-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--surface-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--surface-elevated);
}

.drawer-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--text-primary);
}

.drawer-title h2 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 500;
}

.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
}

.history-timeline {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-event {
  background: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.history-event-header {
  padding: 1rem;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.history-event-header:hover {
  background: rgba(255, 255, 255, 0.02);
}

.history-event-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.history-event-user, .history-event-time {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.history-event-type-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-event-type-label {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-secondary);
}

.history-event-summary {
  padding: 0 1rem 0.5rem;
  font-size: 0.9rem;
  color: var(--text-primary);
  line-height: 1.4;
}

.history-event-details {
  border-top: 1px solid var(--surface-border);
  padding: 0.75rem;
  background: rgba(0, 0, 0, 0.1);
  overflow-x: auto; /* Enable scrolling on small screens */
}

.history-changes-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  table-layout: fixed; /* Force fixed layout to respect widths */
}

.history-changes-table th {
  text-align: left;
  padding: 0.5rem;
  color: var(--text-secondary);
  font-weight: 400;
  border-bottom: 1px solid var(--surface-border);
}

.history-changes-table td {
  padding: 0.6rem 0.5rem;
  vertical-align: top;
  word-wrap: break-word; /* Force wrapping of long words */
}

.change-field {
  color: var(--text-primary);
  font-weight: 500;
  width: 30%; /* Set explicit width */
}

.change-value-old {
  color: var(--text-secondary);
  opacity: 0.9;
}

.change-value-old, .change-value-new {
  width: 35%; /* Set explicit width */
}


.value-empty {
  font-style: italic;
  font-size: 0.8rem;
}

.drawer-loading, .drawer-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200px;
  color: var(--text-secondary);
  text-align: center;
}

.history-btn {
  margin-right: 0.25rem;
  color: var(--text-secondary);
}

.history-btn:hover {
  color: var(--text-primary);
  background: var(--surface-elevated);
}

/* Infinite Scroll */
.infinite-scroll-sentinel {
  width: 100%;
  min-height: 1px;
}

.infinite-scroll-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1.5rem;
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.infinite-scroll-loading .spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid var(--surface-border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}
