{
    public static async Task Seed(SqlDbContext db)
    {
        db.IsSeeding = true;
        try
        {
            await SeedCore(db);
        }
        finally
        {
            db.IsSeeding = false;
        }
    }

    private static async Task SeedCore(SqlDbContext db)
    {
        await NormalizeExclusiveClosureFlagSelectionsAsync(db);

