}

.create-type-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.create-type-item {
  display: block;
}

.create-type-tile {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1rem 1.1rem;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  text-align: left;
  cursor: pointer;
  font: inherit;
  transition: background 0.15s, border-color 0.15s, transform 0.05s;
}

.create-type-tile:hover:not(.create-type-tile--disabled) {
  background: var(--surface-elevated, var(--surface-raised));
  border-color: var(--primary);
}

.create-type-tile:active:not(.create-type-tile--disabled) {
  transform: scale(0.99);
}

.create-type-tile--disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.create-type-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--primary);
}

.create-type-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.create-type-label {
  font-weight: 600;
  font-size: var(--fs-body);
}

.create-type-description {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 0.15rem;
}

.create-type-chevron {
  font-size: 1.5rem;
  color: var(--text-muted);
  line-height: 1;
}

.create-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0.55rem;
  border-radius: var(--radius-sm);
  background: var(--surface);
  border: 1px solid var(--border);
  font-size: var(--fs-xs);
  color: var(--text-muted);
  white-space: nowrap;
}

