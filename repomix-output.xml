}

.admin-user-row .admin-col-name {
  text-align: left;
  background: var(--surface-raised);
  font-weight: 500;
  border-right: 1px solid var(--border);
}

.admin-user-row td:last-child {
  border-right: none;
  background: var(--surface-raised);
  font-weight: 600;
