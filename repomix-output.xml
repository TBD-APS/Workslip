        })),
        isIrrelevant: form.work.irrelevantCategoryIds.includes(`${type.id}-${cat.id}`),
      })),
    })),
    workKind: form.work.workKind || null,
    customWorkKind: form.work.customWorkKind.trim() || null,
    closureFlags: null,
