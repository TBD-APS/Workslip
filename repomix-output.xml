  border-radius: var(--radius-sm);
}

.linked-job-link {
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.linked-job-customer {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
  font-size: var(--fs-body);
  min-width: 0;
}

.linked-jobs-variant .multi-select-chip-description {
  color: var(--text);
  font-size: var(--fs-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.assignment-variant .multi-select-chip {
  background: none;
  border: none;
  padding: 0;
