/* Job History Drawer */
.drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-dark-04);
  backdrop-filter: blur(4px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.drawer-overlay.open {
  opacity: 1;
  visibility: visible;
}

.drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 100%;
  max-width: 450px;
  height: 100%;
  background: var(--bg);
  z-index: 1001;
  box-shadow: -4px 0 20px rgba(0,0,0,0.3);
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  touch-action: pan-y;
  overscroll-behavior: contain;
  will-change: transform;
}

.drawer.open {
  right: 0;
}

.drawer-header {
  padding: 1.25rem 1.5rem;
  padding-top: calc(1.25rem + env(safe-area-inset-top, 0px));
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--surface-raised);
}

.drawer-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--text);
}

.drawer-title h2 {
  margin: 0;
  font-size: var(--fs-lg);
  font-weight: 500;
}

.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
}

.drawer-back-hint {
  position: absolute;
  top: 50%;
  left: 0.4rem;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  border: none;
  background: transparent;
  color: var(--text-muted);
  opacity: 0.4;
  cursor: pointer;
  z-index: 2;
  transition: opacity 0.2s ease;
}

.drawer-back-hint:hover {
  opacity: 0.75;
}

.drawer-back-hint svg {
  animation: drawer-back-pulse 2s ease-in-out infinite;
}

@keyframes drawer-back-pulse {
  0%, 100% { transform: translateX(0); opacity: 0.4; }
  50% { transform: translateX(-3px); opacity: 0.9; }
}

.history-timeline {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-event {
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 0.15s ease;
}

.history-event-header {
  padding: 1rem;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

@media (hover: hover) {
.history-event-header:hover {
  background: var(--overlay-light-002);
}
}

.history-event-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}

.history-event-user, .history-event-time {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.history-event-type-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-event-type-label {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text-muted);
}

.history-event-summary {
  padding: 0 1rem 0.5rem;
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 1.4;
}

.history-event-details {
  border-top: 1px solid var(--border);
  padding: 0.75rem;
  background: var(--overlay-dark-01);
  overflow-x: auto; /* Enable scrolling on small screens */
}

.history-changes-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-sm);
  table-layout: fixed; /* Force fixed layout to respect widths */
}

.history-changes-table th {
  text-align: left;
  padding: 0.5rem;
  color: var(--text-muted);
  font-weight: 400;
  border-bottom: 1px solid var(--border);
}

.history-changes-table td {
  padding: 0.6rem 0.5rem;
  vertical-align: top;
  word-wrap: break-word; /* Force wrapping of long words */
}

.change-field {
  color: var(--text);
  font-weight: 500;
  width: 30%; /* Set explicit width */
}

.change-value-old {
  color: var(--text-muted);
  opacity: 0.9;
}

.change-value-old, .change-value-new {
  width: 35%; /* Set explicit width */
}


.value-empty {
  font-style: italic;
  font-size: var(--fs-xs);
}

.drawer-loading, .drawer-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200px;
  color: var(--text-muted);
  text-align: center;
}

.history-btn {
  margin-right: 0.25rem;
  color: var(--text-muted);
}

@media (hover: hover) {
.history-btn:hover {
  color: var(--text);
  background: var(--surface-raised);
}
}

/* Infinite Scroll */
.infinite-scroll-sentinel {
  width: 100%;
  min-height: 1px;
}

.infinite-scroll-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1.5rem;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.infinite-scroll-loading .spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid var(--border);
  border-top-color: var(--primary);
  border-radius: var(--radius-pill);
  animation: spin 0.6s linear infinite;
}

