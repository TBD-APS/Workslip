  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 0.75rem;
}

.job-type-tabs {
  display: flex;
  gap: 0.5rem;
  background: var(--surface-hover);
  padding: 0.25rem;
