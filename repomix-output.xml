<file path=".github/workflows/playwright-prod-smoke.yml">
name: Playwright critical flows

on:
  workflow_dispatch:
    inputs:
      scenario:
        description: Vælg et isoleret flow eller hele den risikobaserede suite
        required: true
        default: public-smoke
        type: choice
        options:
          - public-smoke
          - auth-session
          - kls-lifecycle
          - rejection-loop
          - draft-recovery
          - role-tenant-isolation
          - invitation-onboarding
          - assignment-lifecycle
          - customer-lifecycle
          - worksheet-integrity
          - diverse-lifecycle
          - all-critical

permissions:
  contents: read

concurrency:
  group: playwright-critical-flows-${{ github.ref }}-${{ inputs.scenario }}
  cancel-in-progress: false

jobs:
  smoke:
    name: Mobile critical flow (${{ matrix.scenario }})
    runs-on: ubuntu-latest
    timeout-minutes: 35

    container:
      image: mcr.microsoft.com/playwright:v1.55.0-noble
      options: --ipc=host

    strategy:
      fail-fast: false
      max-parallel: 4
      matrix:
        scenario: ${{ fromJSON(inputs.scenario == 'all-critical' && '["auth-session","kls-lifecycle","rejection-loop","draft-recovery","role-tenant-isolation","invitation-onboarding","assignment-lifecycle","customer-lifecycle","worksheet-integrity","diverse-lifecycle"]' || format('["{0}"]', inputs.scenario)) }}

    defaults:
      run:
        working-directory: src/FE

    env:
      PLAYWRIGHT_BROWSERS_PATH: /ms-playwright
      PROD_URL: https://app.mrsoftware.dk
      SCENARIO: ${{ matrix.scenario }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install lightweight Playwright runtime
        run: >-
          npm install
          --prefix scripts
          --no-save
          --package-lock=false
          --ignore-scripts
