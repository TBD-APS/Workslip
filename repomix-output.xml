    "syncWebApiSqlFirewallRules": {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[format('sync-web-api-sql-firewall-{0}', toLower(parameters('environment')))]",
      "location": "[parameters('location')]",
      "kind": "AzureCLI",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('deploymentIdentityName')))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.61.0",
        "cleanupPreference": "OnSuccess",
        "retentionInterval": "P1D",
        "timeout": "PT10M",
        "forceUpdateTag": "[reference('webApi').outboundIpAddresses]",
        "environmentVariables": [
          {
            "name": "RESOURCE_GROUP",
            "value": "[resourceGroup().name]"
          },
          {
            "name": "SQL_SERVER_NAME",
            "value": "[format('db-{0}-{1}-server', parameters('companyName'), parameters('environment'))]"
          },
          {
            "name": "OUTBOUND_IPS",
            "value": "[reference('webApi').outboundIpAddresses]"
          }
        ],
        "scriptContent": "set -euo pipefail\r\n\r\naz_with_retry() {\r\n  local attempt=1\r\n  local max_attempts=12\r\n\r\n  while true; do\r\n    if az \"$@\"; then\r\n      return 0\r\n    fi\r\n\r\n    if [ \"$attempt\" -ge \"$max_attempts\" ]; then\r\n      return 1\r\n    fi\r\n\r\n    sleep $((attempt * 10))\r\n    attempt=$((attempt + 1))\r\n  done\r\n}\r\n\r\n# Keep only the firewall rules managed by this script in sync with App Service outbound IPs.\r\nexisting_rules=$(az_with_retry sql server firewall-rule list --resource-group \"$RESOURCE_GROUP\" --server \"$SQL_SERVER_NAME\" --query \"[?starts_with(name, 'AllowWebApiOutbound')].name\" --output tsv)\r\nfor rule in $existing_rules; do\r\n  az_with_retry sql server firewall-rule delete --resource-group \"$RESOURCE_GROUP\" --server \"$SQL_SERVER_NAME\" --name \"$rule\" --output none\r\ndone\r\n\r\nIFS=',' read -ra ips <<< \"$OUTBOUND_IPS\"\r\nindex=0\r\nfor ip in \"${ips[@]}\"; do\r\n  trimmed_ip=$(echo \"$ip\" | xargs)\r\n  if [ -z \"$trimmed_ip\" ]; then\r\n    continue\r\n  fi\r\n\r\n  az_with_retry sql server firewall-rule create \\\r\n    --resource-group \"$RESOURCE_GROUP\" \\\r\n    --server \"$SQL_SERVER_NAME\" \\\r\n    --name \"AllowWebApiOutbound${index}\" \\\r\n    --start-ip-address \"$trimmed_ip\" \\\r\n    --end-ip-address \"$trimmed_ip\" \\\r\n    --output none\r\n\r\n  index=$((index + 1))\r\ndone\r\n"
      },
      "dependsOn": [
        "deploymentIdentity",
        "sqlFirewallManagerForIdentity",
        "sqlServer",
        "webApi"
      ]
    },
    "grantWebApiSqlAccess": {
      "condition": "[parameters('provisionWebApiSqlAccess')]",
      "type": "Microsoft.Resources/deploymentScripts",
