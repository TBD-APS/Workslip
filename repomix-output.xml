}

/* Job List Components */
.page-container {
  max-width: 600px;
  margin: 0 auto;
  position: relative;
}

.job-detail-page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}


.page-header {
  margin-bottom: 2rem;
}

.page-header h2 {
  font-size: 1.35rem;
  font-weight: 600;
  margin: 0 0 0.2rem;
  letter-spacing: -0.01em;
}

.subtitle {
  color: var(--text-muted);
  font-size: var(--fs-body);
}

/* Top Customers Section */
.top-customers-section {
  margin-bottom: 1.5rem;
}

.top-customers-header {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-bottom: 0.65rem;
}

.top-customers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 0.5rem;
}

.top-customer-card {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.85rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
  text-align: left;
  min-width: 0;
}

@media (hover: hover) {
  .top-customer-card:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
  }
}

.top-customer-card:active {
  transform: scale(0.98);
}

.top-customer-icon {
  color: var(--text-muted);
  flex-shrink: 0;
}

.top-customer-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-customer-contact {
  font-size: var(--fs-xs);
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-left: auto;
}

.text-dim {
  color: var(--text-dim);
}

/* Job list gap */
.job-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.status-filter-scroll {
  position: relative;
  margin-bottom: 1rem;
}

.status-filter-scroll::before,
.status-filter-scroll::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2.5rem;
  z-index: 1;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.status-filter-scroll::before {
  left: 0;
  background: linear-gradient(to right, var(--bg) 10%, transparent);
}

.status-filter-scroll::after {
  right: 0;
  background: linear-gradient(to left, var(--bg) 10%, transparent);
}

.status-filter-scroll[data-scroll-left="true"]::before,
.status-filter-scroll[data-scroll-right="true"]::after {
  opacity: 1;
}

.status-filter {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  gap: 0.5rem;
  scrollbar-width: none;
}

.status-filter::-webkit-scrollbar {
  display: none;
}

@media (min-width: 768px) {
  .status-filter-scroll::before,
  .status-filter-scroll::after {
    display: none;
  }

  .status-filter {
    flex-wrap: wrap;
    overflow-x: visible;
    scrollbar-width: auto;
  }
  .status-filter::-webkit-scrollbar {
    display: block;
  }
}

.status-filter-btn {
  padding: 0.4rem 0.85rem;
  font: inherit;
  font-size: var(--fs-sm);
  color: var(--overlay-light-050);
  background: var(--border);
  border: 2px solid var(--border);
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s, color 0.16s;
  white-space: nowrap;
}


.status-filter-btn.selected {
  border-color: var(--focus-ring);
  background: var(--text);
  color: var(--bg);
}

/* ------------------------------------------------------------
   Card
   ------------------------------------------------------------ */
.job-card {
  background: var(--surface);
  border: none;
  border-radius: var(--radius-lg);
  padding: 1.1rem 1.25rem;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  cursor: pointer;
  color: inherit;
  font: inherit;
  text-align: left;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}

.job-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: transparent;
  transition: background 0.2s;
}


@media (hover: hover) {
.job-card:hover {
  background: var(--surface-raised);
}
}

.job-card:active {
  transform: scale(0.995);
}


.report-overview-page {
  padding-bottom: 1rem;
}

.report-overview-header {
  align-items: center;
}

.report-overview-header > div {
  min-width: 0;
}


.report-overview-actions--left {
  margin-left: 0;
}

.report-overview-actions--right {
  margin-left: auto;
}

.report-overview-toolbar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: var(--section-gap);
}


.report-overview-actions {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
  min-height: 2.5rem;
}

.report-overview-icon-action {
  width: 2.5rem;
  min-width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border-radius: var(--radius-sm);
}

.report-overview-icon-action:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}


.report-overview-hero {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.report-overview-hero .section-header-row {
  margin-bottom: 0;
}

.report-overview-data-list {
  margin-top: var(--section-content-margin);
}

.report-overview-block-gap {
  margin-top: var(--section-content-margin);
}

.report-overview-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.report-overview-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text);
  width: fit-content;
}

.report-overview-link-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.linked-job-row {
  display: flex;
  align-items: baseline;
