    font-size: 0.9375rem;
  }

  .admin-week-table thead th {
    padding: 0.6rem 0.75rem;
    font-size: 0.75rem;
  }

  .admin-week-table thead th,
  .admin-week-table tbody td {
    padding: 0.75rem 0.85rem;
  }

  .admin-col-name {
    width: 140px;
    min-width: 120px;
  }

  .admin-col-day {
    width: auto;
  }

  .admin-user-row td {
    padding: 0.75rem 0.85rem;
