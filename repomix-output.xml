  font-weight: 600;
  width: 120px;
  min-width: 100px;
}

.admin-row-label {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.admin-week-info {
  font-size: 0.8rem;
}

.admin-week-number {
  font-size: 0.7rem;
  color: var(--text-muted);
  font-weight: 400;
}

.admin-col-day {
  width: auto;
}

.admin-col-weekend {
  background: var(--surface-raised);
  opacity: 0.6;
  border-right: none !important;
}

.admin-total-footer {
