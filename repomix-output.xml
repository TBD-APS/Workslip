          </button>
          <button
            type="button"
            className="cache-diagnostics-button cache-diagnostics-button--danger"
            onClick={() => clearMutation.mutate()}
            disabled={clearMutation.isPending}
          >
            <RotateCcw size={16} aria-hidden="true" />
