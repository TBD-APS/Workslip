  }

  .time-week-header {
    flex-direction: column;
  }

  .time-week-totals {
    justify-content: flex-start;
  }
}

@media (min-width: 768px) {
  .time-overview-page {
    max-width: none;
    padding: 0 2rem;
  }

  .time-overview-header {
    align-items: center;
    margin-bottom: 2rem;
  }

  .time-overview-header > div:first-child {
    flex: 1;
  }

  .time-month-controls {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }

  .time-today-button {
    white-space: nowrap;
  }

  .time-summary-grid {
    gap: 1rem;
    justify-content: flex-end;
  }

  .time-summary-card {
    padding: 0.35rem 0.75rem;
    gap: 0.5rem;
  }

  .time-summary-card > div {
    gap: 0.4rem;
  }

  .time-week-card {
    padding: 1.25rem;
  }

  .time-week-header {
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .time-week-header > div:first-child {
    flex: 1;
  }

  .time-week-totals {
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .time-week-totals span {
    padding: 0.3rem 0.7rem;
    font-size: var(--fs-xs);
  }

  .time-day-grid {
    gap: 0.75rem;
  }

  .time-day-cell {
    min-height: 160px;
    padding: 0.8rem;
  }

  .time-day-head {
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .time-entry-card {
    padding: 0.65rem;
    gap: 0.3rem;
  }

  .time-entry-card strong {
    font-size: var(--fs-sm);
  }

  .time-entry-user {
    font-size: 0.7rem;
  }
}

/* Admin Weekly Overview */
.admin-weekly-overview {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.admin-week-card {
  border-radius: var(--radius-lg);
  background: var(--surface);
  border: 1px solid var(--border);
  overflow: auto;
}

.admin-week-card.is-current {
  border-color: var(--primary);
  background: var(--surface);
  box-shadow: 0 0 0 2px rgba(var(--primary-rgb, 44, 84, 172), 0.1);
}

.admin-week-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid var(--border);
  background: var(--surface-raised);
}

.admin-week-title h3 {
  margin: 0;
  font-size: var(--fs-body);
  font-weight: 500;
}

.admin-week-meta {
  display: flex;
  gap: 1rem;
  align-items: center;
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

.admin-week-table {
