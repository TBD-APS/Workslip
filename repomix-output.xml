@charset "UTF-8";

/* Sonner Toast â€” force safe-area-inset-top via CSS (env() in inline styles unreliable on iOS) */
[data-sonner-toaster][data-y-position="top"] {
  top: calc(env(safe-area-inset-top, 0px) + 1rem) !important;
}

/* App Shell & Forms CSS */

/* Forms */
.form-input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--surface-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-family: var(--font-main);
  font-size: var(--fs-body);
  transition: all 0.2s ease;
}

.form-input:focus {
  outline: none;
  background: rgba(0, 0, 0, 0.3);
  border-color: var(--focus-ring);
  box-shadow: 0 0 0 1px var(--focus-ring);
}

.form-input.is-readonly,
.form-input[readonly] {
  color: var(--text-muted);
  cursor: default;
  pointer-events: none;
  user-select: none;
  opacity: 0.6;
}

.form-input::placeholder {
  color: var(--text-muted);
  opacity: 0.5;
}

.form-input:focus::placeholder,
.form-textarea:focus::placeholder {
  opacity: 0;
}

/* App Shell Layout (Mobile First) */
.app-shell :is(h1, h2, h3, h4, h5, h6, strong, b) {
  font-weight: 400;
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100dvh;
  background-color: var(--bg);
  overflow-y: auto;
  overflow-anchor: none;
}

.app-shell::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: env(safe-area-inset-top, 0px);
  background: var(--safe-area-top-bg);
  z-index: 11;
}

.app-header {
  position: sticky;
  top: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.8rem 1.5rem;
  padding-top: calc(0.8rem + env(safe-area-inset-top, 0px));
  background: var(--overlay-blur);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  z-index: 10;
  gap: 1rem;
}

.app-header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.app-header-user {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 0.65rem;
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  color: var(--text-muted);
  font-size: var(--fs-sm);
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-header-logout {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.85rem;
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  color: var(--text);
  border: 1px solid var(--border);
  font-size: var(--fs-sm);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

@media (hover: hover) {
.app-header-logout:hover {
  background: var(--status-red-bg);
  border-color: var(--danger);
  color: var(--danger);
}
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-pill);
  background: var(--surface-raised);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

@media (hover: hover) {
.user-avatar:hover {
  background: var(--surface-selected-strong);
  border-color: var(--primary);
  color: var(--text);
  transform: translateY(-1px);
  box-shadow: 0 0 15px var(--surface-elevated), 0 5px 15px rgba(0,0,0,0.3);
}
}

.user-avatar:active {
  transform: translateY(0) scale(0.95);
  box-shadow: var(--shadow-sm-raw);
}

.user-avatar svg {
  transition: transform 0.25s ease;
}

@media (hover: hover) {
.user-avatar:hover svg {
  transform: scale(1.1);
}
}

.user-avatar--large {
  width: 48px;
  height: 48px;
  font-size: var(--fs-lg);
  font-weight: 500;
  cursor: default;
}

@media (hover: hover) {
.user-avatar--large:hover {
  transform: none;
  box-shadow: var(--shadow-sm);
  border-color: var(--border);
}
}

.user-avatar--accent {
  background: var(--primary);
  border-color: var(--surface-selected-strong);
  color: white;
}

.profile-edit-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.5rem;
}

.profile-edit-actions .btn-primary {
  flex: 1;
}

.profile-edit-actions .btn-secondary {
  flex: 1;
}

@media (max-width: 600px) {
  .profile-edit-actions .btn-primary {
    flex: 2;
  }
}

.app-content {
  flex: 1;
  padding: 1.5rem;
  padding-bottom: calc(var(--bottom-nav-height) + var(--bottom-nav-extra));
}

@media (max-width: 480px) {
  .app-content {
    padding: 1rem;
    padding-bottom: calc(var(--bottom-nav-height) + var(--bottom-nav-extra));
  }
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--nav-bg);
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: auto;
  padding-top: 10px;
  padding-bottom: calc(4px + env(safe-area-inset-bottom, 0px));
  z-index: 100;
  transform: none !important;
  transition: none !important;
}

/* Hide the nav without moving it: visibility keeps its box in place
   (layout/scroll are unaffected), only its painted output disappears. */
.app-shell.keyboard-visible .bottom-nav {
  visibility: hidden;
  pointer-events: none;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  color: var(--text);
  font-size: var(--fs-xs);
  font-weight: 400;
  flex: 1;
  transition: color 0.2s;
}

.nav-item.active {
  color: var(--primary);
}

/* Floating Action Button - Create */
.fab-create {
  position: fixed;
  bottom: calc(var(--bottom-nav-height) + 1.5rem);
  right: 1.5rem;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(44, 84, 172, 0.4);
  z-index: 90;
  transition: transform 0.15s, box-shadow 0.15s;
  cursor: pointer;
}

.fab-create:hover {
  box-shadow: 0 4px 20px rgba(44, 84, 172, 0.6);
}

.fab-create:active {
  transform: scale(0.92);
}

@media (max-width: 480px) {
  .fab-create {
    right: 1rem;
  }
}

/* Job List Components */
.page-container {
  max-width: 600px;
  margin: 0 auto;
  position: relative;
}

.pull-to-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 0;
  overflow: hidden;
  color: var(--text-muted);
  font-size: 0.8rem;
  opacity: 0.85;
  will-change: height;
}

.pull-to-refresh.ready,
.pull-to-refresh.refreshing {
  color: var(--primary);
  opacity: 1;
}

@media (min-width: 768px) {
  .pull-to-refresh {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pull-to-refresh .animate-spin {
    animation: none;
  }
}

.job-detail-page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}


.page-header {
  margin-bottom: 2rem;
}

.page-header h2 {
  font-size: 1.35rem;
  font-weight: 600;
  margin: 0 0 0.2rem;
  letter-spacing: -0.01em;
}

.subtitle {
  color: var(--text-muted);
  font-size: var(--fs-body);
}

/* Top Customers Section */
.favorite-customers-section {
  margin-bottom: 1.5rem;
}

.favorite-customers-header {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-bottom: 0.65rem;
}

.favorite-customers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 0.5rem;
}

.favorite-customer-card {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.85rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
  text-align: left;
  min-width: 0;
}

@media (hover: hover) {
  .favorite-customer-card:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
  }
}

.favorite-customer-card:active {
  transform: scale(0.98);
}

.favorite-customer-icon {
  color: #ef4444;
  flex-shrink: 0;
}

.favorite-customer-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-customer-contact {
  font-size: var(--fs-xs);
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-left: auto;
}

.text-dim {
  color: var(--text-dim);
}

/* Job list gap */
.job-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.status-filter-scroll {
  position: relative;
  margin-bottom: 1rem;
}

.status-filter-scroll::before,
.status-filter-scroll::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2.5rem;
  z-index: 1;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.status-filter-scroll::before {
  left: 0;
  background: linear-gradient(to right, var(--bg) 10%, transparent);
}

.status-filter-scroll::after {
  right: 0;
  background: linear-gradient(to left, var(--bg) 10%, transparent);
}

.status-filter-scroll[data-scroll-left="true"]::before,
.status-filter-scroll[data-scroll-right="true"]::after {
  opacity: 1;
}

.status-filter {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  gap: 0.5rem;
  scrollbar-width: none;
}

.status-filter::-webkit-scrollbar {
  display: none;
}

@media (min-width: 768px) {
  .status-filter-scroll::before,
  .status-filter-scroll::after {
    display: none;
  }

  .status-filter {
    flex-wrap: wrap;
    overflow-x: visible;
    scrollbar-width: auto;
  }
  .status-filter::-webkit-scrollbar {
    display: block;
  }
}

.status-filter-btn {
  padding: 0.4rem 0.85rem;
  font: inherit;
  font-size: var(--fs-sm);
  color: var(--overlay-light-050);
  background: var(--border);
  border: 2px solid var(--border);
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: border-color 0.16s, background 0.16s, color 0.16s;
  white-space: nowrap;
}


.status-filter-btn.selected {
  border-color: var(--focus-ring);
  background: var(--text);
  color: var(--bg);
}

/* ------------------------------------------------------------
   Card
   ------------------------------------------------------------ */
.job-card {
  background: var(--surface);
  border: none;
  border-radius: var(--radius-lg);
  padding: 1.1rem 1.25rem;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  cursor: pointer;
  color: inherit;
  font: inherit;
  text-align: left;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}

.job-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: transparent;
  transition: background 0.2s;
}


@media (hover: hover) {
.job-card:hover {
  background: var(--surface-raised);
}
}

.job-card:active {
  transform: scale(0.995);
}


.report-overview-page {
  padding-bottom: 1rem;
}

.report-overview-header {
  align-items: center;
}

.report-overview-header > div {
  min-width: 0;
}


.report-overview-actions--left {
  margin-left: 0;
}

.report-overview-actions--right {
  margin-left: auto;
}

.report-overview-toolbar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: var(--section-gap);
}


.report-overview-actions {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
  min-height: 2.5rem;
}

.report-overview-icon-action {
  width: 2.5rem;
  min-width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border-radius: var(--radius-sm);
}

.report-overview-icon-action:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}


.report-overview-hero {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.report-overview-hero .section-header-row {
  margin-bottom: 0;
}

.report-overview-data-list {
  margin-top: var(--section-content-margin);
}

.report-overview-block-gap {
  margin-top: var(--section-content-margin);
}

.report-overview-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.report-overview-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--fs-xs);
  color: var(--text);
  width: fit-content;
}

.report-overview-link-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.linked-job-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  min-width: 0;
  width: 100%;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  font: inherit;
  text-align: left;
