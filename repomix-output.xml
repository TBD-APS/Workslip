.job-type-tab {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.25rem;
  padding: 0.875rem 1rem;
  border: none;
  background: transparent;
  border-radius: 6px;
  cursor: pointer;
