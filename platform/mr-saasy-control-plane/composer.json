{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "mr-saasy/control-plane",
  "type": "project",
  "description": "Provider-neutral MR SAAS'y AI control plane with enforced trust boundaries.",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.7",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@php artisan test"
    ],
    "architecture": [
      "@php scripts/forbid-workslip-coupling.php",
      "@php scripts/forbid-ai-db-symbols.php",
      "@php scripts/assert-forbidden-symbol-fixture.php",
      "vendor/bin/deptrac analyse --config-file=deptrac.yaml --no-cache",
      "vendor/bin/deptrac analyse --config-file=tests/Architecture/deptrac.legal.yaml --no-cache",
      "@php scripts/assert-forbidden-deptrac-fixtures.php",
      "@php scripts/render-architecture.php"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
