{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "maxLength": 1200 },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": { "type": "string", "maxLength": 80 },
          "title": { "type": "string", "maxLength": 180 },
          "file": { "type": "string", "maxLength": 400 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": "string", "maxLength": 900 },
          "recommendation": { "type": "string", "maxLength": 900 }
        },
        "required": ["severity", "confidence", "category", "title", "file", "line", "evidence", "recommendation"]
      }
    }
  },
  "required": ["summary", "risk", "findings"]
}
